{%- comment -%}
  Homepage — large image + small product image + text promo.

  Desktop:
  - One large image on one side
  - Smaller product image on the opposite side
  - Heading + shop link below the smaller image

  The existing Text Side option controls which side contains
  the smaller image + text content.
{%- endcomment -%}

{%- assign text_side = section.settings.text_side | default: 'right' -%}
{%- assign fallback_asset = section.settings.fallback_asset | default: 'promo-trunk.jpg' -%}

<section
  class="itp itp--text-{{ text_side }}"
  style="
    --itp-inset: {{ section.settings.inset_vw | default: 16 }};
    --itp-small-width: {{ section.settings.small_image_width | default: 58 }}%;
    margin-block: {{ section.settings.gap_top }}px {{ section.settings.gap_bottom }}px;
    --itp-heading-size: {{ section.settings.heading_size }}px;
  "
>

  <!-- LARGE IMAGE -->
  <div class="itp__media">

    <a
      href="{{ section.settings.link | default: '/collections/all' }}"
      class="itp__media-link"
      aria-label="{{ section.settings.heading | escape }}"
    >

      <img
        class="itp__image"
        src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 }}{% else %}{{ fallback_asset | asset_url }}{% endif %}"
        alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
        loading="lazy"
        width="1000"
        height="1070"
      >

    </a>

  </div>


  <!-- SMALL IMAGE + TEXT -->
  <div class="itp__content">

    {%- if section.settings.small_image != blank -%}

      <a
        href="{{ section.settings.link | default: '/collections/all' }}"
        class="itp__small-image-link"
        aria-label="{{ section.settings.heading | escape }}"
      >

        <img
          class="itp__small-image"
          src="{{ section.settings.small_image | image_url: width: 1000 }}"
          alt="{{ section.settings.small_image_alt | default: section.settings.heading | escape }}"
          loading="lazy"
          width="1000"
          height="1000"
        >

      </a>

    {%- endif -%}


    {%- if section.settings.heading != blank -%}

      <h2 class="itp__heading">
        {{ section.settings.heading }}
      </h2>

    {%- endif -%}


    {%- if section.settings.shop_label != blank -%}

      <a
        class="itp__shop"
        href="{{ section.settings.link | default: '/collections/all' }}"
      >
        {{- section.settings.shop_label -}}
      </a>

    {%- endif -%}

  </div>

</section>


{% stylesheet %}

  /* =========================================
     MAIN SECTION
  ========================================= */

  .itp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background: #ffffff;
  }


  /* =========================================
     LARGE IMAGE SIDE
  ========================================= */

  .itp__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1.07;
  }

  .itp__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .itp__image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: 50% 20%;

    display: block;

    transition: transform 0.6s ease;
  }

  .itp:hover .itp__image {
    transform: scale(1.02);
  }


  /* =========================================
     CONTENT SIDE
  ========================================= */

  .itp__content {
    min-width: 0;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    text-align: center;

    padding-top: 5rem;
    padding-bottom: 5rem;

    padding-inline-start: clamp(
      2rem,
      calc(var(--itp-inset, 16) * 1vw),
      20rem
    );

    padding-inline-end: clamp(
      2rem,
      calc(var(--itp-inset, 16) * 1vw),
      20rem
    );
  }


  /* =========================================
     SMALL PRODUCT IMAGE
  ========================================= */

  .itp__small-image-link {
    display: block;

    width: min(
      var(--itp-small-width, 58%),
      420px
    );

    margin: 0 auto 0;

    text-decoration: none;
  }

  .itp__small-image {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 1 / 1;

    object-fit: contain;

    transition: transform 0.5s ease;
  }

  .itp__small-image-link:hover .itp__small-image {
    transform: scale(1.03);
  }


  /* =========================================
     HEADING
  ========================================= */

  .itp__heading {
    margin: 2.5rem 0 0;

    font-family: var(--font-heading--family);

    font-size: var(--itp-heading-size, 34px);
    font-weight: 300;

    letter-spacing: 0.02em;
    line-height: 1.1;

    text-transform: uppercase;

    color: #161616;
  }


  /* =========================================
     SHOP LINK
  ========================================= */

  .itp__shop {
    margin-top: 14px;

    color: #1c1c1c;

    font-family: var(--font-heading--family);

    font-size: 0.7rem;
    font-weight: 400;

    letter-spacing: 0.18em;

    text-transform: uppercase;
    text-decoration: none;
  }

  .itp__shop:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }


  /* =========================================
     TEXT LEFT
     Small image + text on LEFT
     Large image on RIGHT
  ========================================= */

  .itp--text-left .itp__media {
    order: 2;
  }

  .itp--text-left .itp__content {
    order: 1;
  }


  /* =========================================
     TEXT RIGHT
     Large image on LEFT
     Small image + text on RIGHT
  ========================================= */

  .itp--text-right .itp__media {
    order: 1;
  }

  .itp--text-right .itp__content {
    order: 2;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    .itp {
      grid-template-columns: 1fr;
    }


    /* Always large image first on mobile */
    .itp__media {
      order: 1 !important;

      aspect-ratio: 4 / 3;
    }


    .itp__content {
      order: 2 !important;

      padding-top: 3rem;
      padding-bottom: 3rem;

      padding-inline-start: clamp(
        1.25rem,
        5vw,
        2rem
      );

      padding-inline-end: clamp(
        1.25rem,
        5vw,
        2rem
      );

      align-items: center !important;
      text-align: center !important;
    }


    .itp__small-image-link {
      width: min(
        var(--itp-small-width, 58%),
        300px
      );
    }


    .itp__heading {
      margin-top: 1.75rem;

      font-size: min(
        var(--itp-heading-size, 34px),
        9vw
      );
    }


    .itp__shop {
      margin-top: 12px;
    }

  }

{% endstylesheet %}


