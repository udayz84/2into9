<section
  id="Sizing-{{ section.id }}"
  class="
    sizing
    color-{{ section.settings.color_scheme }}
    section
  "
>
  <div class="sizing__classic page-width">
    {% if section.settings.breadcrumb != blank %}
      <p class="sizing__breadcrumb">{{ section.settings.breadcrumb }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="sizing__title">{{ section.settings.heading }}</h1>
    {% endif %}

    <div class="sizing__body">
      {% render 'sizing-content' %}
    </div>
  </div>
</section>

{% style %}
  #Sizing-{{ section.id }} {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .sizing__classic {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .sizing__breadcrumb {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 50%, transparent);
    margin: 0;
  }

  .sizing__title {
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin: 0;
    font-weight: 400;
  }

  /* Content Styles */
  .sizing-content {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-top: 2rem;
  }

  .sizing-content__section h2 {
    font-size: 1rem;
    font-weight: 400;
    text-align: center;
    margin: 0 0 2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Table Styles - Clean Minimal Design */
  .sizing-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .sizing-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    font-size: 0.95rem;
  }

  .sizing-table thead tr {
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
  }

  .sizing-table thead th {
    padding: 1.25rem 3rem;
    font-weight: 600;
    text-transform: capitalize;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
    color: currentColor;
  }

  .sizing-table tbody tr {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .sizing-table tbody tr:last-child {
    border-bottom: none;
  }

  .sizing-table tbody td {
    padding: 1.25rem 3rem;
    font-weight: 400;
    color: color-mix(in srgb, currentColor 75%, transparent);
  }

  .sizing-table tbody td:first-child {
    font-weight: 500;
    color: currentColor;
  }

  /* Mobile Responsive */
  @media (max-width: 749px) {
    .sizing__title {
      font-size: 1.5rem;
      letter-spacing: 0.2em;
    }

    .sizing-content {
      gap: 2.5rem;
      margin-top: 1.5rem;
    }

    .sizing-content__section h2 {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .sizing-table {
      font-size: 0.85rem;
    }

    .sizing-table thead th {
      padding: 0.85rem 0.75rem;
      font-size: 0.8rem;
    }

    .sizing-table tbody td {
      padding: 0.85rem 0.75rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Sizing chart",
  "tag": "section",
  "class": "section-sizing",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb",
      "default": "Home / Sizing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SIZING"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    }
  ],
  "presets": [
    {
      "name": "Sizing chart"
    }
  ]
}
{% endschema %}
