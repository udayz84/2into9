    {
      "type": "richtext",
      "id": "subheading",
      "label": "Intro text",
      "default": "<p>If you've played any amount of cricket, you already know the drill.</p>"
    },
    {
      "type": "richtext",
      "id": "solution_text",
      "label": "Solution text",
      "default": "<p><strong>D-LOCK</strong> is built to keep your protective box secure through long innings, fast running and constant movement — without the old multi-layer routine.</p>"
