<section id="AboutMission-{{ section.id }}" class="about-mission section">
  <div class="page-width about-mission__container">
    {%- for block in section.blocks -%}
      <div class="about-mission__block" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}
          <h2 class="about-mission__title">{{ block.settings.title }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="about-mission__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% style %}
  #AboutMission-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .about-mission__container {
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .about-mission__title {
    text-transform: uppercase;
    font-size: 2rem;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .about-mission__text {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
  }
{% endstyle %}

{% schema %}
{
  "name": "About Mission & Promise",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "OUR MISSION"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "To motivate and inspire through style, comfort and confidence."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Mission & Promise",
      "blocks": [
        {
          "type": "text_block",
          "settings": {
            "title": "OUR MISSION"
          }
        },
        {
          "type": "text_block",
          "settings": {
            "title": "OUR PROMISE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
