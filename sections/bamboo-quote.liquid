{{ 'bamboo-page.css' | asset_url | stylesheet_tag }}
<section class="bb bb-hover-{{ section.settings.hover_style }} bb-quote" style="--bb-bg:{{ section.settings.bg }};--bb-ink:{{ section.settings.ink }};--bb-max:{{ section.settings.width }}px;--bb-pt:{{ section.settings.padding_top }}px;--bb-pb:{{ section.settings.padding_bottom }}px"><div class="bb-wrap bb-quote-wrap"><div class="bb-eyebrow">{{ section.settings.eyebrow | escape }}</div><blockquote>“{{ section.settings.quote | escape }}”</blockquote><p>{{ section.settings.attribution | escape }}</p></div></section>
{% schema %}
{
  "name": "Quote",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content max width",
      "default": 1200,
      "min": 900,
      "max": 1500,
      "step": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 75,
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 75,
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Statement",
      "default": "Everyday essentials should feel as good as they look."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "2INTO9"
    },
    {
      "type": "select",
      "id": "hover_style",
      "label": "Hover animation",
      "default": "subtle",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "expressive",
          "label": "Expressive"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quote"
    }
  ]
}
{% endschema %}
