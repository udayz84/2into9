{% stylesheet %}

/* =========================================
   MAIN SECTION
========================================= */

.itp {
  position: relative;

  display: grid;

  grid-template-columns: 1fr 1fr;

  width: min(
    calc(100% - 40px),
    var(--itp-max-width, 1200px)
  );

  margin-inline: auto;

  background: #ffffff;
}


/* =========================================
   LARGE IMAGE AREA
========================================= */

.itp__media {
  position: relative;

  min-width: 0;

  overflow: visible;

  aspect-ratio: 1 / 1.07;

  z-index: 1;
}


/* =========================================
   DECORATIVE BACKDROP
========================================= */

.itp__backdrop {
  position: absolute;

  z-index: 0;

  width: var(--itp-backdrop-width, 38%);
  height: var(--itp-backdrop-height, 55%);

  background: var(--itp-backdrop-color, #6d513d);

  overflow: hidden;

  pointer-events: none;
}


/* =========================================
   BACKDROP IMAGE
========================================= */

.itp__backdrop--has-image {
  background: transparent;
}


.itp__backdrop-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* =========================================
   BACKDROP POSITIONS
========================================= */

/* Top Left */

.itp__backdrop--top-left {
  top: var(--itp-backdrop-offset-y, 0px);
  left: var(--itp-backdrop-offset-x, 0px);
}


/* Top Right */

.itp__backdrop--top-right {
  top: var(--itp-backdrop-offset-y, 0px);
  right: var(--itp-backdrop-offset-x, 0px);
}


/* Bottom Left */

.itp__backdrop--bottom-left {
  bottom: var(--itp-backdrop-offset-y, 0px);
  left: var(--itp-backdrop-offset-x, 0px);
}


/* Bottom Right */

.itp__backdrop--bottom-right {
  bottom: var(--itp-backdrop-offset-y, 0px);
  right: var(--itp-backdrop-offset-x, 0px);
}


/* =========================================
   MAIN IMAGE LINK
========================================= */

.itp__media-link {
  position: absolute;

  z-index: 2;

  display: block;

  width: calc(100% - 32px);
  height: calc(100% - 32px);

  top: 32px;
  left: 32px;
}


/* =========================================
   MAIN IMAGE
========================================= */

.itp__image {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: 50% 20%;

  display: block;

  transition:
    transform 0.6s ease;
}


.itp__media-link:hover .itp__image {
  transform: scale(1.02);
}


/* =========================================
   CONTENT SIDE
========================================= */

.itp__content {
  min-width: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  padding-top: 4rem;
  padding-bottom: 4rem;

  padding-inline-start: clamp(
    1.5rem,
    calc(var(--itp-inset, 8) * 1vw),
    8rem
  );

  padding-inline-end: clamp(
    1.5rem,
    calc(var(--itp-inset, 8) * 1vw),
    8rem
  );
}


/* =========================================
   CONTENT LINK
========================================= */

.itp__content-link {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  width: 100%;
  height: 100%;

  color: inherit;

  text-decoration: none;

  cursor: pointer;
}


/* =========================================
   SMALL PRODUCT IMAGE
========================================= */

.itp__small-image-wrap {
  width: min(
    var(--itp-small-width, 58%),
    360px
  );

  margin: 0 auto;
}


.itp__small-image {
  display: block;

  width: 100%;
  height: auto;

  aspect-ratio: 1 / 1;

  object-fit: contain;

  transition:
    transform 0.5s ease;
}


.itp__content-link:hover .itp__small-image {
  transform: scale(1.03);
}


/* =========================================
   HEADING
========================================= */

.itp__heading {
  margin: 2.25rem 0 0;

  font-family: var(--font-heading--family);

  font-size: var(--itp-heading-size, 34px);

  font-weight: 300;

  letter-spacing: 0.02em;

  line-height: 1.1;

  text-transform: uppercase;

