      background: #f4f4f4 !important;
      border: 1px solid rgba(0, 0, 0, 0.06) !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06) !important;
    }

    .ph-gallery__rating {
      display: none !important;
    }

    /* Badges rail sits LEFT of the image (side-by-side, not overlaid) */
    .ph-gallery-layout {
      display: flex;
      gap: 8px;
      align-items: stretch;
    }

    .ph-gallery__badges-col {
      display: flex !important;
      flex-direction: column;
      justify-content: flex-start;
      gap: 6px;
      flex: 0 0 auto;
      width: 52px;
      position: static;
      pointer-events: auto;
    }

    .ph-gallery-badge {
      width: 52px;
      height: 56px;
      padding: 4px 2px;
      border-radius: 8px;
      background: var(--ph-tile-bg, #efefef) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
