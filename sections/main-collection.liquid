

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>

{% comment %} Breadcrumbs Section {% endcomment %}
{% if section.settings.show_breadcrumbs %}
  <div class="collection-breadcrumbs-wrapper page-width">
    <nav class="collection-breadcrumbs" aria-label="Breadcrumb">
      <ol class="collection-breadcrumbs__list">
        <li class="collection-breadcrumbs__item">
          <a href="{{ routes.root_url }}" class="collection-breadcrumbs__link">Home</a>
          <span class="collection-breadcrumbs__separator">/</span>
        </li>
      </ol>
    </nav>
    <h1 class="collection-breadcrumbs__heading">
      {% if section.settings.breadcrumb_prefix != blank %}
        <span class="collection-breadcrumbs__prefix">{{ section.settings.breadcrumb_prefix }}</span>
      {% endif %}
      <span class="collection-breadcrumbs__title">{{ collection.title }}</span>
    </h1>
  </div>
{% endif %}

<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  .main-collection-grid {
    grid-column: var(--grid-column--mobile);

    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  .collection-wrapper {
    @media screen and (min-width: 750px) {
      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (min-width: 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /* Make product media go edge-to-edge by using negative margins */
  :is(.collection-wrapper--full-width) .card-gallery,
  :is(.collection-wrapper--full-width-on-mobile) .card-gallery {
    @media screen and (max-width: 749px) {
      margin-inline-start: calc(-1 * max(var(--padding-xs), var(--padding-inline-start)));
      margin-inline-end: calc(-1 * max(var(--padding-xs), var(--padding-inline-end)));
    }
  }

  /* Breadcrumb Styles */
  .collection-breadcrumbs-wrapper {
    padding: 140px 0 0;
    max-width: 1440px;
    width: 100%;
    margin: auto;
  }

  .collection-breadcrumbs {
    margin-bottom: 4px;
  }

  .collection-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 6px;
  }

  .collection-breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .collection-breadcrumbs__link {
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .collection-breadcrumbs__link:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .collection-breadcrumbs__separator {
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .collection-breadcrumbs__heading {
    margin: 0;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .collection-breadcrumbs__prefix {
    color: var(--color-foreground);
    margin-right: 8px;
  }

  .collection-breadcrumbs__title {
    color: var(--color-foreground);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .collection-breadcrumbs-wrapper {
      padding: 12px 16px 0;
    }

    .collection-breadcrumbs__item {
      font-size: 0.75rem;
    }

    .collection-breadcrumbs__heading {
      font-size: 24px;
    }
  }

  /* ================= Collection product grid — Figma redesign ================= */

  /* Page gutters: 15px desktop / 12px mobile, near full-bleed like the design */
  .main-collection-grid {
    padding-inline: 15px;
  }

  @media screen and (max-width: 749px) {
    .main-collection-grid {
      padding-inline: 12px;
    }
  }

  /* Grid: fixed 290px cards (design size), auto-wrapping, centered.
     6 per row at 1920px like the design; fewer columns on smaller screens. */
  @media screen and (min-width: 750px) {
    .main-collection-grid .product-grid.product-grid--grid {
      --product-grid-columns-desktop: repeat(auto-fill, 290px);
      justify-content: center;
    }
  }

  /* Card is size-referenced by its children (cqw units) */
  .main-collection-grid .product-grid__item {
    container-type: inline-size;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .main-collection-grid .product-grid__item product-card,
  .main-collection-grid .product-grid__item product-card-link {
    width: 100%;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
  }

  .main-collection-grid .product-grid__card {
    gap: 0;
    background-color: #f0f0f0;
    border: 0.5px solid #dcdcdc;
    border-radius: 20px;
    padding-block: 0 16px;
    padding-inline: 0;
    overflow: hidden;
    min-width: 0;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box;
  }

  /* Product image: landscape crop with the card's rounded top */
  .main-collection-grid .card-gallery {
    border-radius: 20px 20px 0 0;
  }

  @media screen and (max-width: 749px) {
    .product-grid-container {
      padding: 12px;
    }
  }

  .main-collection-grid .card-gallery .product-media-container {
    aspect-ratio: 1/1;
  }

  /* Products without media fall back to a display-size text slab */
  .main-collection-grid .product-card-gallery__title-placeholder {
    aspect-ratio: 1/1;
    display: grid;
    place-items: center;
    padding: 12px;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
    background-color: transparent;
  }

  /* One CTA per card on mobile: hide the floating quick-add over the image */
  @media screen and (max-width: 1023px) {
    .main-collection-grid .card-gallery quick-add-component {
      display: none;
    }
  }

  .main-collection-grid .card-gallery .product-media-container :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hide vendor brand name and price completely on all category grids */
  .main-collection-grid .product-vendor-text,
  .main-collection-grid product-price,
  .main-collection-grid .price,
  body.template-collection .main-collection-grid .product-vendor-text,
  body.template-collection .main-collection-grid product-price,
  body.template-collection .main-collection-grid .price {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Product title container with fixed 2-line height for uniform alignment */
  .main-collection-grid .product-title {
    width: 100%;
    box-sizing: border-box;
    padding-inline: 16px;
    margin-block-start: 14px;
    margin-block-end: 4px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-collection-grid .product-title-text {
    font-size: clamp(12px, 5.2cqw, 15px);
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    color: #171717;
  }

  /* Buttons pinned to bottom across all cards */
  .main-collection-grid .buy-buttons-block {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    min-width: 0 !important;
    margin-block-start: auto !important;
    margin-top: auto !important;
    padding-block: 10px 0 !important;
    padding-inline: 20px !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }
{% endstylesheet %}

{% style %}
  /* ID-scoped overrides for buy buttons to ensure baseline alignment */
  #shopify-section-{{ section.id }} .buy-buttons-block {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    min-width: 0 !important;
    margin-block-start: auto !important;
    margin-top: auto !important;
    padding-block: 10px 0 !important;
    padding-inline: 20px !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }

  #shopify-section-{{ section.id }} .buy-buttons-block add-to-cart-component,
  #shopify-section-{{ section.id }} .buy-buttons-block product-form-component,
  #shopify-section-{{ section.id }} .buy-buttons-block .product-form-buttons,
  #shopify-section-{{ section.id }} .buy-buttons-block .product-form-buttons > * {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .buy-buttons-block .shopify-product-form {
    display: block;
  }

  .main-collection-grid .buy-buttons-block .product-card__quick-add,
  #shopify-section-{{ section.id }} .buy-buttons-block .product-card__quick-add {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    width: 100% !important;
    min-width: 0 !important;
    height: 40px !important;
    min-height: 40px !important;
    margin: 0 0 10px 0 !important;
    padding: 0 16px !important;
    border: 1px solid #171717 !important;
    border-radius: 999px !important;
    background: #ffffff !important;
    color: #171717 !important;
    font-family: var(--font-primary--family) !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    line-height: 1 !important;
    transition: all 0.2s ease !important;
  }

  .main-collection-grid .buy-buttons-block .product-card__quick-add:hover:not([disabled]),
  #shopify-section-{{ section.id }} .buy-buttons-block .product-card__quick-add:hover:not([disabled]) {
    background: #f0f0f0 !important;
  }

  .main-collection-grid .buy-buttons-block .add-to-cart-button,
  #shopify-section-{{ section.id }} .buy-buttons-block .add-to-cart-button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    width: 100% !important;
    min-width: 0 !important;
    height: 40px !important;
    min-height: 40px !important;
    margin: 0 !important;
    padding: 0 16px !important;
    border: 1px solid #171717 !important;
    border-radius: 999px !important;
    background: #171717 !important;
    color: #ffffff !important;
    font-family: var(--font-primary--family) !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    line-height: 1 !important;
    transition: all 0.2s ease !important;
  }

  .main-collection-grid .buy-buttons-block .add-to-cart-button:hover:not([disabled]),
  #shopify-section-{{ section.id }} .buy-buttons-block .add-to-cart-button:hover:not([disabled]) {
    background: #333333 !important;
    border-color: #333333 !important;
  }

  /* Responsive styling for small screens / mobile */
  @media screen and (max-width: 749px) {
    .product-grid-container {
      padding: 12px !important;
    }

    .main-collection-grid {
      padding-inline: 8px !important;
    }

    .main-collection-grid .product-grid.product-grid--grid {
      gap: 12px !important;
    }

    .main-collection-grid .product-grid__card {
      border-radius: 16px !important;
      padding-block: 0 12px !important;
    }

    .main-collection-grid .card-gallery {
      border-radius: 16px 16px 0 0 !important;
    }

    .main-collection-grid .product-title {
      padding-inline: 8px !important;
      margin-block-start: 10px !important;
      margin-block-end: 2px !important;
      min-height: 36px !important;
    }

    .main-collection-grid .product-title-text {
      font-size: 11px !important;
      line-height: 1.3 !important;
    }

    .main-collection-grid .buy-buttons-block,
    #shopify-section-{{ section.id }} .buy-buttons-block {
      padding-inline: 10px !important;
      padding-block: 8px 0 !important;
      gap: 6px !important;
    }

    .main-collection-grid .buy-buttons-block .product-card__quick-add,
    .main-collection-grid .buy-buttons-block .add-to-cart-button,
    #shopify-section-{{ section.id }} .buy-buttons-block .product-card__quick-add,
    #shopify-section-{{ section.id }} .buy-buttons-block .add-to-cart-button {
      height: 34px !important;
      min-height: 34px !important;
      font-size: 10.5px !important;
      padding: 0 8px !important;
    }

    .main-collection-grid .buy-buttons-block .product-card__quick-add,
    #shopify-section-{{ section.id }} .buy-buttons-block .product-card__quick-add {
      margin: 0 0 8px 0 !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_prefix",
      "label": "Breadcrumb prefix text",
      "default": "Shop For",
      "info": "Static text shown before the collection name. Leave empty to show only collection name."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
