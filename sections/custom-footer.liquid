{%- liquid
  assign has_menu_blocks = false
  for block in section.blocks
    if block.type == 'menu'
      assign has_menu_blocks = true
    endif
  endfor
-%}

{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

<footer class="custom-footer">
  {%- if section.settings.bg_pattern != blank -%}
    <div class="custom-footer__bg-pattern" aria-hidden="true">
      {{
        section.settings.bg_pattern
        | image_url: width: 1920
        | image_tag: alt: '', loading: 'lazy'
      }}
    </div>
  {%- endif -%}

  <div class="custom-footer__container">
    <div class="custom-footer__grid">
      <div class="custom-footer__brand">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="custom-footer__logo">
            {{
              section.settings.logo
              | image_url: width: 256
              | image_tag:
                alt: section.settings.logo_alt,
                class: 'custom-footer__logo-img',
                widths: '128, 256',
                sizes: '128px',
                loading: 'lazy'
            }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          <div class="custom-footer__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <p class="custom-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</p>
            {%- endif -%}

            {%- form 'customer', class: 'custom-footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="custom-footer__field">
                <input
                  id="NewsletterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="custom-footer__input"
                  value="{{ form.email }}"
                  aria-label="{{ section.settings.newsletter_placeholder }}"
                  placeholder="{{ section.settings.newsletter_placeholder }}"
                  autocomplete="email"
                  required
                >
                <button type="submit" class="custom-footer__submit" name="commit" aria-label="Subscribe">
                  <svg viewBox="0 0 20 15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 7.5h17M12 1.5l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              {%- if form.errors -%}
                <p class="custom-footer__form-error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="custom-footer__form-success">Thanks for subscribing!</p>
              {%- endif -%}
            {%- endform -%}

            {%- if section.settings.newsletter_subheading != blank -%}
              <p class="custom-footer__newsletter-sub">{{ section.settings.newsletter_subheading }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="custom-footer__social">
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" class="custom-footer__social-link" aria-label="Facebook" rel="noopener" target="_blank">
                {%- if section.settings.social_facebook_icon != blank -%}
                  {{ section.settings.social_facebook_icon | image_url: width: 92 | image_tag: class: 'custom-footer__social-icon', alt: 'Facebook', loading: 'lazy' }}
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" class="custom-footer__social-link" aria-label="Instagram" rel="noopener" target="_blank">
                {%- if section.settings.social_instagram_icon != blank -%}
                  {{ section.settings.social_instagram_icon | image_url: width: 92 | image_tag: class: 'custom-footer__social-icon', alt: 'Instagram', loading: 'lazy' }}
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a href="{{ section.settings.social_youtube }}" class="custom-footer__social-link" aria-label="YouTube" rel="noopener" target="_blank">
                {%- if section.settings.social_youtube_icon != blank -%}
                  {{ section.settings.social_youtube_icon | image_url: width: 92 | image_tag: class: 'custom-footer__social-icon', alt: 'YouTube', loading: 'lazy' }}
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <nav class="custom-footer__nav" {{ block.shopify_attributes }}>
            {%- if block.settings.menu_title != blank -%}
              <h4 class="custom-footer__nav-title">{{ block.settings.menu_title }}</h4>
            {%- endif -%}
            {%- assign footer_menu = linklists[block.settings.menu] -%}
            {%- if footer_menu.links.size > 0 -%}
              <ul class="custom-footer__nav-list">
                {%- for link in footer_menu.links -%}
                  <li class="custom-footer__nav-item">
                    <a href="{{ link.url }}" class="custom-footer__nav-link"{% if link.current %} aria-current="page"{% endif %}>
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif block.settings.fallback_links != blank -%}
              <ul class="custom-footer__nav-list">
                {%- assign fallback_items = block.settings.fallback_links | split: ',' -%}
                {%- for item in fallback_items -%}
                  {%- assign pair = item | split: '|' -%}
                  <li class="custom-footer__nav-item">
                    <a href="{{ pair[1] | strip | default: '#' }}" class="custom-footer__nav-link">{{ pair[0] | strip }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- elsif block.type == 'about' -%}
          <div class="custom-footer__about" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h4 class="custom-footer__nav-title">{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="custom-footer__about-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="custom-footer__bottom">
      {%- if section.settings.copyright_text != blank -%}
        <p class="custom-footer__copyright">{{ section.settings.copyright_text }}</p>
      {%- endif -%}
      {%- if section.settings.payment_image != blank -%}
        {{
          section.settings.payment_image
          | image_url: width: 280
          | image_tag:
            class: 'custom-footer__payment',
            widths: '140, 280',
            sizes: '140px',
            alt: 'Payment methods',
            loading: 'lazy'
        }}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "section-custom-footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#171717"
    },
    {
      "type": "image_picker",
      "id": "bg_pattern",
      "label": "Background pattern"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Company Logo"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to our newsletter to stay in the loop!"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_subheading",
      "label": "Newsletter subtext",
      "default": "Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook link"
    },
    {
      "type": "image_picker",
      "id": "social_facebook_icon",
      "label": "Facebook icon"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram link"
    },
    {
      "type": "image_picker",
      "id": "social_instagram_icon",
      "label": "Instagram icon"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube link"
    },
    {
      "type": "image_picker",
      "id": "social_youtube_icon",
      "label": "YouTube icon"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026, 2into9 UNDERWEAR."
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment methods image"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Column title",
          "default": "Help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "fallback_links",
          "label": "Fallback links",
          "info": "Used when no menu is selected. Format: Title|/url, Title|/url"
        }
      ]
    },
    {
      "type": "about",
      "name": "About column",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column title",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>9into2 is a leading direct-to-consumer online retailer for underwear in India. 9into2 offers an exclusive range of high-quality, sustainably and ethically manufactured underwear designed to suit a broad range of body types. With innovative designs focused on comfort, quality, and fit, 9into2 is redefining the underwear market for customers across India.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "menu_title": "Help",
            "fallback_links": "FAQs|/pages/faqs, SIZING|/pages/sizing, REWARDS|/pages/rewards, RETURN POLICY|/pages/return-policy, PRIVACY POLICY|/policies/privacy-policy, TERMS & CONDITIONS|/policies/terms-of-service"
          }
        },
        {
          "type": "menu",
          "settings": {
            "menu_title": "Quick Link",
            "fallback_links": "OUR STORY|/pages/our-story, FACTORIES|/pages/factories, DESIGNS|/pages/designs, MAGAZINE|/blogs/magazine"
          }
        },
        { "type": "about" }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .custom-footer {
    --cf-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    position: relative;
    background: #171717;
    color: #fff;
    font-family: var(--cf-font);
    overflow: clip;
    padding-block: 128px 72px;
  }

  .custom-footer__bg-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.25;
  }

  .custom-footer__bg-pattern img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-footer__container {
    position: relative;
    max-width: 1800px;
    margin-inline: auto;
    padding-inline: 60px;
  }

  .custom-footer__grid {
    display: grid;
    grid-template-columns: 686px 363px 323px 428px;
    column-gap: 0;
    align-items: start;
  }

  .custom-footer__logo {
    display: inline-block;
  }

  .custom-footer__logo-img {
    display: block;
    width: 128px;
    height: auto;
  }

  .custom-footer__newsletter {
    margin-block-start: 10px;
  }

  .custom-footer__newsletter-heading {
    margin: 0;
    max-width: 482px;
    font-size: 34px;
    font-weight: 700;
    line-height: 51px;
    color: #fff;
  }

  .custom-footer__field {
    position: relative;
    margin-block-start: 13px;
  }

  .custom-footer__input {
    width: 100%;
    height: 60px;
    border: 1px solid #d9d9d9;
    border-radius: 50px;
    background: transparent;
    color: #fff;
    font-family: var(--cf-font);
    font-size: 12px;
    padding-inline: 31px 80px;
    outline: none;
  }

  .custom-footer__input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .custom-footer__input:focus {
    border-color: #fff;
  }

  .custom-footer__submit {
    position: absolute;
    top: 50%;
    right: 47px;
    transform: translateY(-50%);
    width: 20px;
    height: 15px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .custom-footer__submit svg {
    width: 20px;
    height: 15px;
  }

  .custom-footer__submit:hover {
    opacity: 0.8;
  }

  .custom-footer__form-error,
  .custom-footer__form-success {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 20px;
  }

  .custom-footer__form-error {
    color: #ff8f8f;
  }

  .custom-footer__form-success {
    color: #c5ff00;
  }

  .custom-footer__newsletter-sub {
    margin: 20px 0 0;
    max-width: 366px;
    font-size: 16px;
    font-weight: 400;
    line-height: 21px;
    color: #fff;
  }

  .custom-footer__social {
    display: flex;
    gap: 11px;
    margin-block-start: 96px;
  }

  .custom-footer__social-link {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
  }

  .custom-footer__social-icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  .custom-footer__nav-title {
    margin: 0 0 15px;
    font-size: 24px;
    font-weight: 400;
    line-height: 36px;
    text-transform: uppercase;
    color: #fff;
  }

  .custom-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-footer__nav-item {
    font-size: 16px;
    line-height: 34px;
  }

  .custom-footer__nav-link {
    color: #fff;
    text-decoration: none;
  }

  .custom-footer__nav-link:hover {
    text-decoration: underline;
  }

  .custom-footer__about-text {
    font-size: 16px;
    font-weight: 400;
    line-height: 30px;
    color: #fff;
  }

  .custom-footer__about-text p {
    margin: 0;
  }

  .custom-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 50px;
  }

  .custom-footer__copyright {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
  }

  .custom-footer__payment {
    width: 140px;
    height: auto;
    object-fit: contain;
  }
{% endstylesheet %}
