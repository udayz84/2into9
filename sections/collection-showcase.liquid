{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign c_width = section.settings.container_width | default: 'standard'
  assign m_layout = section.settings.mobile_layout | default: 'carousel'
-%}

<section
  class="collection-showcase color-{{ section.settings.color_scheme }}"
  id="CollectionShowcase-{{ section.id }}"
  style="
    {% if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)' and section.settings.custom_bg_color != 'transparent' %}
      background-color: {{ section.settings.custom_bg_color }};
    {% endif %}
    --showcase-padding-top: {{ section.settings.padding-block-start | default: 60 }}px;
    --showcase-padding-bottom: {{ section.settings.padding-block-end | default: 100 }}px;
    --showcase-padding-top-mobile: {{ section.settings.mobile_padding_block_start | default: 24 }}px;
    --showcase-padding-bottom-mobile: {{ section.settings.mobile_padding_block_end | default: 48 }}px;
    --showcase-heading-size: {{ section.settings.heading_size | default: 32 }}px;
    --showcase-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 24 }}px;
    --showcase-heading-weight: {{ section.settings.heading_weight | default: '800' }};
    --showcase-heading-align: {{ section.settings.heading_alignment | default: 'center' }};
    --showcase-heading-color: {{ section.settings.heading_color | default: '#171717' }};
    --showcase-gap-desktop: {{ section.settings.card_gap_desktop | default: 32 }}px;
    --showcase-gap-mobile: {{ section.settings.card_gap_mobile | default: 16 }}px;
    --showcase-card-radius: {{ section.settings.card_radius | default: 20 }}px;
    --showcase-btn-radius: {{ section.settings.button_border_radius | default: 12 }}px;
    --showcase-btn-height: {{ section.settings.button_height | default: 48 }}px;
    --showcase-mobile-width: {{ section.settings.mobile_card_width | default: 82 }}%;
  "
>
  <div class="collection-showcase__inner collection-showcase__inner--{{ c_width }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="collection-showcase__header collection-showcase__header--{{ section.settings.heading_alignment | default: 'center' }}">
        {%- if section.settings.subheading != blank -%}
          <p class="collection-showcase__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-showcase__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-showcase__track collection-showcase__track--mobile-{{ m_layout }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign card_image = block.settings.image | default: card_collection.image
          assign mobile_image = block.settings.image_mobile | default: card_image
          assign card_title = block.settings.title | default: block.settings.label | default: card_collection.title | default: 'Collection'
          assign card_link = block.settings.link | default: card_collection.url | default: routes.all_products_collection_url
          assign btn_style = block.settings.button_style | default: section.settings.button_style_default | default: 'solid'
        -%}
        <a
          class="collection-showcase__card"
          href="{{ card_link }}"
          aria-label="{{ card_title | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="collection-showcase__media">
            {%- if card_image != blank or mobile_image != blank -%}
              <picture class="collection-showcase__picture">
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ mobile_image | image_url: width: 600 }}"
                  >
                {%- endif -%}
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 740
                    | image_tag:
                      class: 'collection-showcase__image',
                      alt: card_title,
                      widths: '370, 555, 740',
                      sizes: '370px',
                      loading: 'lazy'
                  }}
                {%- else -%}
                  {{
                    mobile_image
                    | image_url: width: 740
                    | image_tag:
                      class: 'collection-showcase__image',
                      alt: card_title,
                      widths: '370, 555, 740',
                      sizes: '370px',
                      loading: 'lazy'
                  }}
                {%- endif -%}
              </picture>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'collection-showcase__image collection-showcase__image--placeholder' }}
            {%- endif -%}

            {%- if block.settings.tag_badge != blank -%}
              <span class="collection-showcase__tag">{{ block.settings.tag_badge }}</span>
            {%- endif -%}
          </div>

          <div class="collection-showcase__content">
            {%- if card_title != blank -%}
              <span class="collection-showcase__label">{{ card_title }}</span>
            {%- endif -%}

            {% liquid
              assign f1 = block.settings.feature_1 | default: 'Moisture-wicking'
              assign f2 = block.settings.feature_2 | default: 'Organic + Sustainable'
              assign f3 = block.settings.feature_3 | default: 'Anti-chafe Panels'
              assign f4 = block.settings.feature_4 | default: '3D Pouch Comfort'
              assign f5 = block.settings.feature_5 | default: 'Soft Bamboo Viscose'
            %}

            <div class="collection-showcase__features">
              {%- if f1 != blank -%}
                <div class="collection-showcase__feature-item">
                  <span class="collection-showcase__feature-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                      <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ f1 }}</span>
                </div>
              {%- endif -%}
              {%- if f2 != blank -%}
                <div class="collection-showcase__feature-item">
                  <span class="collection-showcase__feature-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                      <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ f2 }}</span>
                </div>
              {%- endif -%}
              {%- if f3 != blank -%}
                <div class="collection-showcase__feature-item">
                  <span class="collection-showcase__feature-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                      <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ f3 }}</span>
                </div>
              {%- endif -%}
              {%- if f4 != blank -%}
                <div class="collection-showcase__feature-item">
                  <span class="collection-showcase__feature-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                      <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ f4 }}</span>
                </div>
              {%- endif -%}
              {%- if f5 != blank -%}
                <div class="collection-showcase__feature-item">
                  <span class="collection-showcase__feature-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                      <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ f5 }}</span>
                </div>
              {%- endif -%}
            </div>

            {% liquid
              if block.settings.button_label != blank and block.settings.button_label != 'Shop Now'
                assign btn_text = block.settings.button_label
              elsif card_title != blank
                assign btn_text = 'Shop ' | append: card_title
              else
                assign btn_text = 'Shop Now'
              endif
            %}
            <span
              class="collection-showcase__button collection-showcase__button--{{ btn_style }}"
              style="
                {% if block.settings.custom_button_bg != blank and block.settings.custom_button_bg != 'rgba(0,0,0,0)' and block.settings.custom_button_bg != 'transparent' %}
                  background: {{ block.settings.custom_button_bg }};
                  border-color: {{ block.settings.custom_button_bg }};
                {% endif %}
                {% if block.settings.custom_button_text != blank and block.settings.custom_button_text != 'rgba(0,0,0,0)' and block.settings.custom_button_text != 'transparent' %}
                  color: {{ block.settings.custom_button_text }};
                {% endif %}
              "
            >
              <span>{{ btn_text }}</span>
              <svg class="collection-showcase__btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-showcase,
  .collection-showcase h1,
  .collection-showcase h2,
  .collection-showcase h3,
  .collection-showcase p,
  .collection-showcase span,
  .collection-showcase a {
    font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
  }

  .collection-showcase {
    padding-block-start: var(--showcase-padding-top, 60px);
    padding-block-end: var(--showcase-padding-bottom, 100px);
    background: var(--color-background, #ffffff);
    overflow: hidden;
  }

  .collection-showcase__inner {
    margin-inline: auto;
    padding-inline: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .collection-showcase__inner--narrow { max-width: 1000px; }
  .collection-showcase__inner--standard { max-width: 1200px; }
  .collection-showcase__inner--wide { max-width: 1400px; }
  .collection-showcase__inner--full { max-width: 100%; padding-inline: 32px; }

  .collection-showcase__header {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .collection-showcase__header--left { align-items: flex-start; text-align: left; }
  .collection-showcase__header--center { align-items: center; text-align: center; }
  .collection-showcase__header--right { align-items: flex-end; text-align: right; }

  .collection-showcase__subheading {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #666666;
  }

  .collection-showcase__heading {
    margin: 0;
    font-size: var(--showcase-heading-size, 32px);
    font-weight: var(--showcase-heading-weight, 800);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--showcase-heading-color, #171717);
    text-align: inherit;
  }

  .collection-showcase__track {
    display: flex;
    justify-content: center;
    gap: var(--showcase-gap-desktop, 32px);
    width: 100%;
    align-items: stretch;
    box-sizing: border-box;
  }

  .collection-showcase__track::-webkit-scrollbar {
    display: none;
  }

  .collection-showcase__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 350px;
    background: #ffffff;
    border-radius: var(--showcase-card-radius, 20px);
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.06);
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .collection-showcase__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.12);
  }

  .collection-showcase__media {
    position: relative;
    width: 100%;
    height: 290px;
    background: #f5f5f5;
    overflow: hidden;
  }

  .collection-showcase__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(255, 255, 255, 0.2) 65%,
      rgba(255, 255, 255, 0.6) 80%,
      rgba(255, 255, 255, 0.92) 94%,
      #ffffff 100%
    );
    z-index: 2;
  }

  .collection-showcase__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .collection-showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.35s ease;
  }

  .collection-showcase__card:hover .collection-showcase__image {
    transform: scale(1.03);
  }

  .collection-showcase__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-showcase__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    background: #171717;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 999px;
    z-index: 3;
  }

  .collection-showcase__content {
    padding: 24px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
  }

  .collection-showcase__label {
    font-size: 1.2rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-align: center;
    color: #111827;
    margin: 0 0 18px;
    display: block;
  }

  .collection-showcase__features {
    margin-left:40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    flex: 1;
  }

  .collection-showcase__feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: #4b5563;
    line-height: 1.35;
  }

  .collection-showcase__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    min-width: 18px;
    flex-shrink: 0;
  }

  .collection-showcase__feature-icon svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .collection-showcase__button {
    width: 100%;
    height: var(--showcase-btn-height, 48px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #000000;
    color: #ffffff;
    border-radius: var(--showcase-btn-radius, 12px);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: none;
    box-sizing: border-box;
    margin-top: auto;
    border: 1.5px solid transparent;
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .collection-showcase__button--solid {
    background: #000000;
    color: #ffffff;
  }

  .collection-showcase__button--solid:hover {
    background: #1f2937;
  }

  .collection-showcase__button--outline {
    background: #ffffff;
    color: #171717;
    border-color: #171717;
  }

  .collection-showcase__button--outline:hover {
    background: #171717;
    color: #ffffff;
  }

  .collection-showcase__button--white_solid {
    background: #ffffff;
    color: #171717;
  }

  .collection-showcase__button--white_solid:hover {
    background: #f3f4f6;
  }

  .collection-showcase__card:hover .collection-showcase__button--solid {
    background: #1f2937;
  }

  .collection-showcase__btn-arrow {
    display: block;
    width: 16px;
    height: 16px;
    stroke: currentColor;
    transition: transform 0.2s ease;
  }

  .collection-showcase__card:hover .collection-showcase__btn-arrow {
    transform: translateX(4px);
  }

  /* ---- Mobile / Tablet: Swipe Carousel ≤1023px ---- */
  @media (max-width: 1023px) {
    .collection-showcase {
      padding-inline: 0;
      padding-top: var(--showcase-padding-top-mobile, 24px);
      padding-block-end: var(--showcase-padding-bottom-mobile, 48px);
    }

    .collection-showcase__inner {
      padding-inline: 16px;
    }

    .collection-showcase__heading {
      font-size: var(--showcase-heading-size-mobile, 26px);
      margin-bottom: 24px;
    }

    .collection-showcase__track--mobile-carousel {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin-inline: -16px;
      padding-inline: 16px;
      scroll-padding-inline: 16px;
      padding-block-end: 16px;
      gap: var(--showcase-gap-mobile, 16px);
      width: calc(100% + 32px);
    }

    .collection-showcase__track--mobile-carousel .collection-showcase__card {
      flex: 0 0 var(--showcase-mobile-width, 82%);
      max-width: 320px;
      min-width: 275px;
      scroll-snap-align: center;
      border-radius: 18px;
    }

    .collection-showcase__track--mobile-stacked {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .collection-showcase__track--mobile-stacked .collection-showcase__card {
      flex: 0 0 auto;
      max-width: 380px;
      width: 100%;
    }

    .collection-showcase__media {
      height: 250px;
    }

    .collection-showcase__content {
      padding: 20px 18px 22px;
    }

    .collection-showcase__label {
      font-size: 1.15rem;
      margin-bottom: 16px;
    }

    .collection-showcase__features {
      gap: 11px;
      margin-bottom: 20px;
    }

    .collection-showcase__feature-item {
      font-size: 13px;
      gap: 10px;
    }

    .collection-showcase__button {
      height: 46px;
      font-size: 13.5px;
      border-radius: 10px;
    }
  }

  @media (max-width: 749px) {
    .collection-showcase {
      padding-top: var(--showcase-padding-top-mobile, 18px);
      padding-block-end: var(--showcase-padding-bottom-mobile, 40px);
    }

    .collection-showcase__heading {
      font-size: var(--showcase-heading-size-mobile, 24px);
      margin-bottom: 20px;
    }

    .collection-showcase__track--mobile-carousel .collection-showcase__card {
      flex: 0 0 var(--showcase-mobile-width, 82%);
      max-width: 310px;
      min-width: 260px;
    }

    .collection-showcase__media {
      height: 230px;
    }

    .collection-showcase__content {
      padding: 18px 16px 20px;
    }

    .collection-showcase__label {
      font-size: 1.1rem;
      margin-bottom: 14px;
    }

    .collection-showcase__features {
         margin-left:20px;
      gap: 10px;
      margin-bottom: 18px;
    }

    .collection-showcase__feature-item {
      font-size: 12.5px;
      gap: 10px;
    }

    .collection-showcase__button {
      height: 44px;
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Showcase",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Heading & Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why 2into9 Underwear?"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (Desktop)",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "800"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow / Subheading text (optional)"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "narrow", "label": "Narrow (1000px)" },
        { "value": "standard", "label": "Standard (1200px)" },
        { "value": "wide", "label": "Wide (1400px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "label": "Gap between cards (Desktop)",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Gap between cards (Mobile)",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding (Desktop)",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding (Desktop)",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_block_start",
      "label": "Top padding (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
