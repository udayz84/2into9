<section id="AboutStory-{{ section.id }}" class="about-story section">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="about-story__main-heading">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    <div class="about-story__container">
      <div class="about-story__image-wrapper">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1500 | image_tag:
            loading: 'lazy',
            class: 'about-story__image'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="about-story__content">
        {%- if section.settings.text != blank -%}
          <div class="about-story__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #AboutStory-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .about-story__main-heading {
    margin-bottom: 2rem;
    font-size: 2rem;
    font-weight: 400;
  }

  .about-story__container {
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  .about-story__image-wrapper {
    flex: 1;
    border-radius: 0px;
    overflow: hidden;
  }

  .about-story__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-story__content {
    flex: 1;
    text-align: center;
  }

  .about-story__text {
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(var(--color-foreground), 0.8);
    max-width: 50rem;
    margin: 0 auto;
  }
  
  .about-story__text p {
    margin-bottom: 1.5rem;
  }

  .about-story__text strong {
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  @media screen and (max-width: 749px) {
    .about-story__container {
      flex-direction: column;
      gap: 2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "About Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Our Story"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content",
      "default": "<p>Share your brand story here...</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F4F4F4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
