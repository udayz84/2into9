{{ 'bamboo-page.css' | asset_url | stylesheet_tag }}
<section id="bb-video-{{ section.id }}" class="bb bb-video-section" aria-label="{{ section.settings.heading | escape }}" style="--bb-bg:{{ section.settings.background }};--bb-ink:{{ section.settings.text_color }};--bb-max:{{ section.settings.width }}px;--bb-pt:{{ section.settings.padding_top }}px;--bb-pb:{{ section.settings.padding_bottom }}px;--bb-video-height:{{ section.settings.desktop_height }}px;--bb-video-height-mobile:{{ section.settings.mobile_height }}px;--bb-video-overlay:{{ section.settings.overlay | divided_by: 100.0 }};">
  {% assign video_is_muted = section.settings.muted %}
  {% if section.settings.autoplay %}{% assign video_is_muted = true %}{% endif %}
  {% if section.settings.top_heading %}
    <div class="bb-wrap bb-video-heading">
      {% if section.settings.eyebrow != blank %}<p class="bb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="bb-rich">{{ section.settings.description }}</div>{% endif %}
    </div>
  {% endif %}
  <div class="bb-video-stage">
    <div class="bb-video-mediawrap">
      {% if section.settings.shopify_video != blank %}
        {{ section.settings.shopify_video | video_tag: image_size: '2000x', autoplay: section.settings.autoplay, loop: section.settings.loop, muted: video_is_muted, controls: section.settings.controls, playsinline: true, preload: 'metadata', class: 'bb-video-media' }}
      {% elsif section.settings.mp4_url != blank %}
        <video class="bb-video-media" playsinline preload="metadata" {% if section.settings.autoplay %}autoplay{% endif %} {% if section.settings.loop %}loop{% endif %} {% if section.settings.muted or section.settings.autoplay %}muted{% endif %} {% if section.settings.controls %}controls{% endif %} {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1800 }}"{% endif %}>
          <source src="{{ section.settings.mp4_url | escape }}" type="video/mp4">
        </video>
      {% elsif section.settings.poster != blank %}
        <picture class="bb-video-poster">
          {% if section.settings.mobile_poster != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_poster | image_url: width: 900 }}">{% endif %}
          {{ section.settings.poster | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750,1000,1400,1800,2000', sizes: '100vw', alt: section.settings.poster.alt }}
        </picture>
      {% else %}
        <img class="bb-video-fallback" src="{{ 'bb-bamboo-video-poster.jpg' | asset_url }}" loading="lazy" alt="Sunlight filtering through a bamboo forest" width="1600" height="900">
      {% endif %}
    </div>
    {% if section.settings.show_overlay_text %}
      <div class="bb-video-shade" aria-hidden="true"></div>
      <div class="bb-video-overlay-copy bb-wrap">
        {% if section.settings.overlay_eyebrow != blank %}<div class="bb-eyebrow">{{ section.settings.overlay_eyebrow | escape }}</div>{% endif %}
        {% if section.settings.overlay_heading != blank %}<h2>{{ section.settings.overlay_heading | escape }}</h2>{% endif %}
        {% if section.settings.overlay_caption != blank %}<div class="bb-rich">{{ section.settings.overlay_caption }}</div>{% endif %}
        {% if section.settings.button_label != blank and section.settings.button_url != blank %}<a href="{{ section.settings.button_url }}" class="bb-video-cta">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
    {% endif %}
  </div>
  {% if section.settings.autoplay %}
  <script>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var parent = document.getElementById('bb-video-{{ section.id }}');
        if (parent) {
          var video = parent.querySelector('video');
          if (video) { video.pause(); video.removeAttribute('autoplay'); }
        }
      }
    })();
  </script>
  {% endif %}
  {% if section.settings.caption != blank %}<div class="bb-wrap bb-video-caption bb-rich">{{ section.settings.caption }}</div>{% endif %}
</section>
{% schema %}
{
  "name": "Bamboo cinematic video",
  "settings": [
    {"type":"header","content":"Video source"},
    {"type":"video","id":"shopify_video","label":"Shopify hosted video"},
    {"type":"url","id":"mp4_url","label":"Alternative direct MP4 URL","info":"Use only original or licensed footage. Shopify-hosted video takes priority."},
    {"type":"image_picker","id":"poster","label":"Poster / fallback image"},
    {"type":"image_picker","id":"mobile_poster","label":"Mobile fallback image (optional)"},
    {"type":"checkbox","id":"autoplay","label":"Autoplay (mute recommended)","default":false},
    {"type":"checkbox","id":"muted","label":"Start muted","default":true},
    {"type":"checkbox","id":"loop","label":"Loop video","default":true},
    {"type":"checkbox","id":"controls","label":"Show video controls","default":true},
    {"type":"header","content":"Intro above video"},
    {"type":"checkbox","id":"top_heading","label":"Show introduction above video","default":true},
    {"type":"text","id":"eyebrow","label":"Intro eyebrow","default":"A CLOSER LOOK"},
    {"type":"text","id":"heading","label":"Intro heading","default":"The Story Behind Bamboo"},
    {"type":"richtext","id":"description","label":"Introduction","default":"<p>From fast-growing plant to the fibres used in everyday fabrics.</p>"},
    {"type":"header","content":"Optional text over the film"},
    {"type":"checkbox","id":"show_overlay_text","label":"Show overlaid text","default":true},
    {"type":"text","id":"overlay_eyebrow","label":"Overlay eyebrow","default":"FROM NATURE TO FABRIC"},
    {"type":"text","id":"overlay_heading","label":"Overlay heading","default":"Where the Journey Begins"},
    {"type":"richtext","id":"overlay_caption","label":"Overlay description","default":"<p>A closer look at bamboo, the plant behind the material.</p>"},
    {"type":"text","id":"button_label","label":"Optional button text"},
    {"type":"url","id":"button_url","label":"Button link"},
    {"type":"range","id":"overlay","label":"Dark overlay strength","min":0,"max":80,"step":5,"unit":"%","default":35},
    {"type":"header","content":"Layout and colours"},
    {"type":"color","id":"background","label":"Background colour","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Intro text colour","default":"#171717"},
    {"type":"range","id":"width","label":"Intro content width","min":900,"max":1500,"step":50,"unit":"px","default":1200},
    {"type":"range","id":"desktop_height","label":"Video height - desktop","min":360,"max":800,"step":20,"unit":"px","default":580},
    {"type":"range","id":"mobile_height","label":"Video height - mobile","min":300,"max":650,"step":10,"unit":"px","default":420},
    {"type":"range","id":"padding_top","label":"Spacing above intro","min":0,"max":150,"step":5,"unit":"px","default":75},
    {"type":"range","id":"padding_bottom","label":"Spacing after video","min":0,"max":150,"step":5,"unit":"px","default":75},
    {"type":"richtext","id":"caption","label":"Optional text below video"}
  ],
  "presets":[{"name":"Bamboo cinematic video"}]
}
{% endschema %}
