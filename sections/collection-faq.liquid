{%- comment -%}
  Collection FAQ — Step One styled accordion.
  Bold compact heading + light-grey rounded card container (#f6f6f6) with 20px radius.
  Bold 700 questions, clean 1px dividers, 28px circular chevron toggle badges with 180° rotation.
  Fully responsive across mobile, tablet, and desktop.
{%- endcomment -%}

<section
  class="collection-faq color-{{ section.settings.color_scheme }}"
  id="CollectionFaq-{{ section.id }}"
  data-single="{{ section.settings.close_others }}"
  style="
    --faq-max-width: {{ section.settings.max_width | default: 960 }}px;
    --faq-card-bg: {{ section.settings.card_bg | default: '#f6f6f6' }};
    --faq-card-radius: {{ section.settings.card_radius | default: 20 }}px;
    --faq-heading-size: {{ section.settings.heading_size | default: 36 }}px;
  "
>
  <div class="collection-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-faq__list">
      {%- for block in section.blocks -%}
        <details
          class="collection-faq__item"
          {% if forloop.first and section.settings.first_open %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="collection-faq__question">
            <span class="collection-faq__question-text">{{ block.settings.question }}</span>
            <span class="collection-faq__toggle" aria-hidden="true">
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                <path d="M1 1l4 4 4-4"/>
              </svg>
            </span>
          </summary>
          {%- if block.settings.answer != blank -%}
            <div class="collection-faq__answer">
              <div class="collection-faq__answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          {%- endif -%}
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #CollectionFaq-{{ section.id }} {
    padding-block: {{ section.settings.padding-block-start }}px {{ section.settings.padding-block-end }}px;
    background: var(--color-background);
  }

  .collection-faq__inner {
    max-width: var(--faq-max-width, 960px);
    margin-inline: auto;
    padding-inline: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 36px);
    box-sizing: border-box;
  }

  .collection-faq__heading {
    margin: 0;
    font-family: var(--font-heading--family, 'Poppins', sans-serif);
    font-size: clamp(28px, 3.2vw, var(--faq-heading-size, 36px));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: center;
    color: #111111;
  }

  .collection-faq__list {
    width: 100%;
    background-color: var(--faq-card-bg, #f6f6f6);
    border-radius: var(--faq-card-radius, 20px);
    padding: 8px 36px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .collection-faq__item {
    border-bottom: 1px solid #e5e5e5;
    transition: border-color 0.2s ease;
  }

  .collection-faq__item:last-child {
    border-bottom: none;
  }

  .collection-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    text-align: left;
  }

  .collection-faq__question::-webkit-details-marker,
  .collection-faq__question::marker {
    display: none;
  }

  .collection-faq__question-text {
    font-family: var(--font-heading--family, 'Poppins', sans-serif);
    font-size: clamp(14.5px, 1.15vw, 16px);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #111111;
    flex: 1;
  }

  .collection-faq__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: #e5e5e5;
    color: #111111;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s ease;
  }

  .collection-faq__toggle svg {
    width: 10px;
    height: 6px;
    transition: transform 0.3s ease;
  }

  .collection-faq__item[open] .collection-faq__toggle {
    transform: rotate(180deg);
    background-color: #dedede;
  }

  .collection-faq__answer {
    padding-block: 0 20px;
    font-family: var(--font-body--family, 'Poppins', sans-serif);
    font-size: clamp(14px, 1.05vw, 15px);
    font-weight: 400;
    line-height: 1.65;
    color: #3f3f46;
    overflow: hidden;
  }

  .collection-faq__answer-inner p {
    margin: 0;
  }

  .collection-faq__answer-inner p + p {
    margin-top: 10px;
  }

  .collection-faq__answer a {
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (max-width: 749px) {
    #CollectionFaq-{{ section.id }} {
      padding-block: 32px 48px;
    }

    .collection-faq__inner {
      padding-inline: 16px;
      gap: 20px;
    }

    .collection-faq__heading {
      font-size: 26px;
    }

    .collection-faq__list {
      border-radius: 16px;
      padding: 4px 18px;
    }

    .collection-faq__question {
      gap: 14px;
      padding-block: 16px;
    }

    .collection-faq__question-text {
      font-size: 14.5px;
    }

    .collection-faq__toggle {
      width: 26px;
      height: 26px;
    }

    .collection-faq__answer {
      padding-block: 0 16px;
      font-size: 13.5px;
      line-height: 1.55;
    }
  }
{% endstyle %}

<script>
  function initCollectionFaq(sectionId) {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const duration = () => (prefersReducedMotion.matches ? 0 : 300);
    const easing = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const items = section.querySelectorAll('.collection-faq__item');

    function closeItem(item) {
      const answer = item.querySelector('.collection-faq__answer');
      if (!item.open || !answer) return;
      answer.getAnimations().forEach((anim) => anim.cancel());
      const height = answer.offsetHeight;
      const animation = answer.animate(
        { height: [height + 'px', '0px'], opacity: [1, 0] },
        { duration: duration(), easing, fill: 'forwards' }
      );
      animation.onfinish = () => {
        item.open = false;
        animation.cancel();
      };
    }

    function openItem(item) {
      const answer = item.querySelector('.collection-faq__answer');
      if (!answer) return;
      answer.getAnimations().forEach((anim) => anim.cancel());
      item.open = true;
      const height = answer.scrollHeight;
      const animation = answer.animate(
        { height: ['0px', height + 'px'], opacity: [0, 1] },
        { duration: duration(), easing }
      );
      animation.onfinish = () => {
        animation.cancel();
      };
    }

    items.forEach((item) => {
      const summary = item.querySelector('.collection-faq__question');
      if (!summary) return;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const isOpen = item.open;

        if (isOpen) {
          closeItem(item);
        } else {
          if (section.dataset.single === 'true') {
            items.forEach((other) => {
              if (other !== item && other.open) {
                closeItem(other);
              }
            });
          }
          openItem(item);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initCollectionFaq('CollectionFaq-{{ section.id }}'));
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail.sectionId === '{{ section.id }}') {
      initCollectionFaq('CollectionFaq-{{ section.id }}');
    }
  });
</script>

{% schema %}
{
  "name": "Collection FAQ",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ's"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Open first question by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "close_others",
      "label": "Close other questions when opening one",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#F6F6F6"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum container width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's the difference between a Boxer Brief and Trunk?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>The only difference between the two is that Boxer Briefs have 3 cm more leg length than the trunks.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What's the difference between a Boxer Brief and Trunk?",
            "answer": "<p>The only difference between the two is that Boxer Briefs have 3 cm more leg length than the trunks.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What type of underwear is best for me?",
            "answer": "<p>The best style depends on your day. Boxer briefs give all-day support, trunks are a shorter, closer fit, and briefs stay light and invisible under clothes.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What underpants should I choose if I play sport?",
            "answer": "<p>Go for performance styles with moisture-wicking fabric, anti-chafe panels and a supportive 3D pouch — they keep you dry and comfortable through every workout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
