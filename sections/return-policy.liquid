<section
  id="ReturnPolicy-{{ section.id }}"
  class="
    return-policy
    color-{{ section.settings.color_scheme }}
    section
  "
>
  <div class="return-policy__classic page-width">
    {% if section.settings.breadcrumb != blank %}
      <p class="return-policy__breadcrumb">{{ section.settings.breadcrumb }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="return-policy__title">{{ section.settings.heading }}</h1>
    {% endif %}

    {% assign intro_blocks = section.blocks | where: 'type', 'intro_paragraph' %}
    {% if intro_blocks.size > 0 %}
      <div class="return-policy__intro">
        {% for block in intro_blocks %}
          {% if block.settings.text != blank %}
            <div class="return-policy__intro-text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.note_text != blank %}
      <div class="return-policy__note rte">{{ section.settings.note_text }}</div>
    {% endif %}

    {% assign policy_blocks = section.blocks | where: 'type', 'policy_section' %}
    {% if policy_blocks.size > 0 %}
      <div class="return-policy__sections">
        {% for block in policy_blocks %}
          <article class="return-policy__section" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="return-policy__section-heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="return-policy__section-body rte">{{ block.settings.body }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% assign closing_blocks = section.blocks | where: 'type', 'closing_paragraph' %}
    {% if closing_blocks.size > 0 %}
      <div class="return-policy__closing">
        {% for block in closing_blocks %}
          {% if block.settings.text != blank %}
            <div class="return-policy__closing-text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #ReturnPolicy-{{ section.id }} {
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .return-policy__classic {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .return-policy__classic .rte p {
    margin: 0 0 1rem;
  }

  .return-policy__classic .rte p:last-child {
    margin-bottom: 0;
  }

  .return-policy__breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .return-policy__title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .return-policy__intro-text,
  .return-policy__closing-text {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 1.5rem;
    color: currentColor;
    opacity: 0.9;
  }

  .return-policy__note {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: #c1121f;
    margin: 2rem 0;
  }

  .return-policy__sections {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .return-policy__section-heading {
    text-align: center;
    letter-spacing: 0.35em;
    font-size: 0.9rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .return-policy__section-body {
    line-height: 1.75;
    font-size: 1rem;
    color: currentColor;
    opacity: 0.9;
  }

  .return-policy__section-body p + p {
    margin-top: 1rem;
  }

  .return-policy__closing {
    margin-top: 2.5rem;
  }

  .return-policy__closing-text {
    font-style: italic;
  }
{% endstyle %}

{% schema %}
{
  "name": "Return policy",
  "tag": "section",
  "class": "section-return-policy",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb",
      "default": "Home / Returns"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "RETURNS"
    },
    {
      "type": "richtext",
      "id": "note_text",
