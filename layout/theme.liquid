{%- comment -%}
  2INTO9 structured data (JSON-LD) for every page type.
  Install: save as snippets/seo-schema.liquid, then add
  {% render 'seo-schema' %}
  in layout/theme.liquid just above </head>.

  What it outputs:
  - Every page: Organization + WebSite
  - Product pages: Product (with offers, return policy, shipping) + BreadcrumbList
  - Collection pages: CollectionPage with ItemList + BreadcrumbList
  - About / Contact / FAQs / other pages: AboutPage, ContactPage, FAQPage or WebPage + BreadcrumbList
  - Blog and blog posts: Blog / BlogPosting + BreadcrumbList
{%- endcomment -%}

{%- assign site_url = shop.url -%}
{%- assign brand_name = '2INTO9' -%}
{%- assign currency = cart.currency.iso_code | default: 'INR' -%}

{%- comment -%} ===== 1. Every page: Organization + WebSite ===== {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ site_url }}/#organization",
      "name": "2INTO9",
      "url": "{{ site_url }}/",
      "logo": "https://2into9.com/cdn/shop/files/2_into_9_logo.png",
      "description": "2INTO9 makes soft bamboo trunks for men, boys and cricketers, including D-LOCK cricket trunks with a built-in box pouch.",
      "email": "contact@2into9.com",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "contact@2into9.com",
        "areaServed": "IN",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://www.facebook.com/2into9",
        "https://www.instagram.com/2into9/",
        "https://www.youtube.com/@2into9"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site_url }}/#website",
      "name": "2INTO9",
      "url": "{{ site_url }}/",
      "inLanguage": "en-IN",
      "publisher": { "@id": "{{ site_url }}/#organization" }
    }
  ]
}
</script>

{%- comment -%} ===== 2. Product pages ===== {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- assign crumb_collection = collection | default: product.collections.first -%}
  {%- assign product_url = site_url | append: product.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "{{ product_url }}#product",
      "name": {{ product.title | json }},
      "url": "{{ product_url }}",
      "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
      {%- if product.featured_image %}
      "image": [
        {%- for image in product.images limit: 6 -%}
          "https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- endif %}
      "brand": { "@type": "Brand", "name": "2INTO9" },
      "material": "Bamboo viscose and spandex",
      {%- if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      "offers": [
        {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          {%- if variant.sku != blank %}
          "sku": {{ variant.sku | json }},
          {%- endif %}
          "url": "{{ product_url }}?variant={{ variant.id }}",
          "price": "{{ variant.price | divided_by: 100.0 }}",
          "priceCurrency": "{{ currency }}",
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": { "@id": "{{ site_url }}/#organization" },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "{{ currency }}" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "IN",
            "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
          }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
        {%- if crumb_collection %}
        { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": "{{ site_url }}{{ crumb_collection.url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": "{{ product_url }}" }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": "{{ product_url }}" }
        {%- endif %}
      ]
    }
  ]
}
</script>
{%- endif -%}

{%- comment -%} ===== 3. Collection pages ===== {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  {%- assign collection_url = site_url | append: collection.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "{{ collection_url }}#webpage",
      "name": {{ collection.title | json }},
      "url": "{{ collection_url }}",
      {%- if page_description != blank %}
      "description": {{ page_description | json }},
      {%- endif %}
      "isPartOf": { "@id": "{{ site_url }}/#website" },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for item in collection.products limit: 30 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": "{{ site_url }}{{ item.url }}", "name": {{ item.title | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ collection_url }}" }
      ]
    }
  ]
}
</script>
{%- endif -%}

{%- comment -%} ===== 4. Normal pages (About, Contact, Why Bamboo, Sizing, FAQs...) ===== {%- endcomment -%}
{%- if request.page_type == 'page' -%}
  {%- assign page_url = site_url | append: page.url -%}
  {%- case page.handle -%}
    {%- when 'about-us' -%}{%- assign page_type = 'AboutPage' -%}
    {%- when 'contact' -%}{%- assign page_type = 'ContactPage' -%}
    {%- else -%}{%- assign page_type = 'WebPage' -%}
  {%- endcase -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "{{ page_type }}",
      "@id": "{{ page_url }}#webpage",
      "name": {{ page.title | json }},
      "url": "{{ page_url }}",
      {%- if page_description != blank %}
      "description": {{ page_description | json }},
      {%- endif %}
      "isPartOf": { "@id": "{{ site_url }}/#website" },
      "about": { "@id": "{{ site_url }}/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ page_url }}" }
      ]
    }
  ]
}
</script>

  {%- comment -%}
    FAQPage: the answers below must match the FAQ page word for word.
    Before publishing, replace each "answer" text with the exact answer
    from Online Store > Pages > FAQs. Add or remove questions to match.
  {%- endcomment -%}
  {%- if page.handle == 'faqs' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How do I find the right size?",
      "acceptedAnswer": { "@type": "Answer", "text": "Compare your measurements with our size guide. If you are between sizes, choose the larger size." } },
    { "@type": "Question", "name": "What is 2INTO9 Underwear made from?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our core range is made mostly from bamboo viscose with a small amount of spandex, for softness, breathability and stretch." } },
    { "@type": "Question", "name": "How do I wash my Underwear?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wash in cold water on a gentle cycle with similar colours. Do not use bleach or fabric softener, and tumble dry low or air dry. Remove the protective box from D-LOCK before washing." } },
    { "@type": "Question", "name": "What is your return policy?",
      "acceptedAnswer": { "@type": "Answer", "text": "For hygiene reasons we do not accept returns, exchanges or refunds. Damaged, defective or incorrect items must be reported within 3-6 hours of delivery with photo or video proof." } },
    { "@type": "Question", "name": "Do you ship internationally?",
      "acceptedAnswer": { "@type": "Answer", "text": "Not yet. We currently deliver only within India, and global shipping is planned." } },
    { "@type": "Question", "name": "How can I get free shipping?",
      "acceptedAnswer": { "@type": "Answer", "text": "Free shipping is currently available with no minimum order and is applied automatically at checkout." } },
    { "@type": "Question", "name": "How do I track my order?",
      "acceptedAnswer": { "@type": "Answer", "text": "Once your order ships, tracking details are sent to your registered phone number or email." } },
    { "@type": "Question", "name": "Can I use multiple discount codes?",
      "acceptedAnswer": { "@type": "Answer", "text": "No, only one discount code can be used per order." } }
  ]
}
</script>
  {%- endif -%}
{%- endif -%}

{%- comment -%} ===== 5. Blog and blog posts ===== {%- endcomment -%}
{%- if request.page_type == 'blog' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ blog.title | json }},
  "url": "{{ site_url }}{{ blog.url }}",
  "publisher": { "@id": "{{ site_url }}/#organization" }
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  {%- assign article_url = site_url | append: article.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": {{ article.title | truncate: 110 | json }},
      "url": "{{ article_url }}",
      "mainEntityOfPage": "{{ article_url }}",
      {%- if article.image %}
      "image": "https:{{ article.image | image_url: width: 1200 }}",
      {%- endif %}
      "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
      "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
      "author": { "@type": "Person", "name": {{ article.author | json }} },
      "publisher": { "@id": "{{ site_url }}/#organization" },
      "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | json }}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ site_url }}{{ blog.url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": "{{ article_url }}" }
      ]
    }
  ]
}
</script>
{%- endif -%}




  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        const announcementBar = headerGroup.querySelector('.announcement-bar');
        const announcementBarHeight = (announcementBar && announcementBar.offsetHeight > 0) ? announcementBar.offsetHeight : 0;
        document.documentElement.style.setProperty('--announcement-bar-height', `${announcementBarHeight}px`);
        document.body.style.setProperty('--announcement-bar-height', `${announcementBarHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {%- if template.name == 'index' or template.name == 'product' or template == 'page.about' -%}
      <style>
        /*
         * Desktop section rhythm: neutralize each section's own
         * vertical spacing, then apply one uniform 48px gap between
         * every adjacent section. Mobile/tablet keep original values.
         */
        @media (min-width: 1024px) {
          main[data-template='index'] .scrolling-banner,
          main[data-template='index'] .cat-split,
          main[data-template='index'] .itp,
          main[data-template='index'] .vm {
            padding-block: 0 !important;
            margin-block: 0 !important;
          }

          /* Last section keeps its bottom padding before the footer */
          main[data-template='index'] .faq {
            padding-block-start: 0 !important;
          }

          main[data-template='index'] .shopify-section + .shopify-section {
            margin-top: 0px;
          }

          /*
           * Product page: hero→accordion junction is left to the
           * pinned-gallery alignment script; normalize the rest.
           */
          main[data-template='product'] .pa {
            padding-block-end: 0 !important;
          }

          main[data-template='product'] .pw,
          main[data-template='product'] .pf {
            padding-block: 0 ;
          }

          main[data-template='product'] .pf {
            padding-block-end: 100px !important;
          }

          main[data-template='product'] .shopify-section + .shopify-section {
            margin-top: 48px;
          }

          /*
           * About page: all sections use additive paddings — zero
           * them and use the same uniform gap.
           */
          main[data-template='page.about'] .spacing-style,
          main[data-template='page.about'] .inherit-spacing,
          main[data-template='page.about'] .about-story,
          main[data-template='page.about'] .into9-story-section {
            padding-block: 0 !important;
          }

          /* Last section keeps its bottom padding before the footer */
          main[data-template='page.about'] .about-features {
            padding-block-start: 0 !important;
          }

          main[data-template='page.about'] .shopify-section + .shopify-section {
            margin-top: 48px;
          }
        }
      </style>
    {%- endif -%}
{% if request.page_type == 'policy' %}
  <style>
    .shopify-policy__container {
      padding-top: calc(var(--header-height, 70px) + clamp(28px, 4vw, 44px)) !important;
    }

    .shopify-policy-breadcrumb {
      margin-top: 12px;
      margin-bottom: 30px;
      font-size: 14px;
      line-height: 1.5;
      text-align:center;
    }

    .shopify-policy-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .shopify-policy-breadcrumb a:hover {
      text-decoration: underline;
    }

    .shopify-policy-breadcrumb__separator {
      margin: 0 8px;
      {% comment %} opacity: 0.5; {% endcomment %}
    }

    .shopify-policy-breadcrumb__current {
      {% comment %} opacity: 0.65; {% endcomment %}
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var policyTitle = document.querySelector(
        '.shopify-policy__title h1, .shopify-policy__title, .shopify-policy-container h1, main h1'
      );

      if (!policyTitle) {
        return;
      }

      if (document.querySelector('.shopify-policy-breadcrumb')) {
        return;
      }

      var breadcrumb = document.createElement('nav');

      breadcrumb.className = 'shopify-policy-breadcrumb';
      breadcrumb.setAttribute('aria-label', 'Breadcrumb');

      breadcrumb.innerHTML =
        '<a href="{{ routes.root_url }}">Home</a>' +
        '<span class="shopify-policy-breadcrumb__separator">/</span>' +
        '<span class="shopify-policy-breadcrumb__current">{{ page_title | escape }}</span>';

      policyTitle.insertAdjacentElement('afterend', breadcrumb);
    });
  </script>
{% endif %}
    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script src="{{ 'quick-view-modal.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
