{%- comment -%}
  Customer Reviews Section
  Displays testimonial cards in a grid layout
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="CustomerReviews-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-customer-reviews
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="customer-reviews__container">

    <!-- Header -->
    <div class="customer-reviews__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="customer-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <p class="customer-reviews__rating">
          {%- if section.settings.show_stars -%}
            <span class="customer-reviews__stars">{{ section.settings.star_icon | default: '★' }}</span>
          {%- endif -%}
          <span>{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}
    </div>

    <!-- Reviews Grid -->
    <div class="customer-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="customer-reviews__card" {{ block.shopify_attributes }}>

          <!-- Stars Rating -->
          {%- if block.settings.rating != blank -%}
            <div class="customer-reviews__card-stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <span class="customer-reviews__star customer-reviews__star--filled">{{ section.settings.star_icon | default: '★' }}</span>
                {%- else -%}
                  <span class="customer-reviews__star customer-reviews__star--empty">{{ section.settings.star_empty_icon | default: '☆' }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Reviewer Name -->
          {%- if block.settings.reviewer_name != blank -%}
            <h3 class="customer-reviews__name">{{ block.settings.reviewer_name }}</h3>
          {%- endif -%}

          <!-- Reviewer Title -->
          {%- if block.settings.reviewer_title != blank -%}
            <p class="customer-reviews__title">{{ block.settings.reviewer_title }}</p>
          {%- endif -%}

          <!-- Review Text -->
          {%- if block.settings.review_text != blank -%}
            <p class="customer-reviews__text">{{ block.settings.review_text }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .section-customer-reviews {
    position: relative;
    background: #fff;
    overflow-x: hidden;
  }

  .section-customer-reviews .section-background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base, 0);
    pointer-events: none;
  }

  .customer-reviews__container {
    max-width: 75rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
    overflow-x: hidden;
  }

  @media screen and (min-width: 750px) {
    .customer-reviews__container {
      padding: 5rem 2rem;
    }
  }

  /* Header */
  .customer-reviews__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .customer-reviews__heading {
    font-size: clamp(2.25rem, 4vw, 3rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 0.75rem;
  }

  .customer-reviews__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #555;
    font-size: 1rem;
  }

  .customer-reviews__stars {
    color: #fbbf24;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
  }

  /* Reviews Grid */
  .customer-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
  }

  @media screen and (min-width: 640px) {
    .customer-reviews__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      overflow-x: visible;
    }
  }

  @media screen and (min-width: 1024px) {
    .customer-reviews__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* Review Card */
  .customer-reviews__card {
    background: #f5f5f5;
    border-radius: 1rem;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    max-width: 100%;
  }

  @media screen and (min-width: 640px) {
    .customer-reviews__card {
      padding: 2rem 1.5rem;
    }
  }

  .customer-reviews__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .customer-reviews__card-stars {
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }

  .customer-reviews__star {
    font-size: 1.125rem;
  }

  .customer-reviews__star--filled {
    color: #fbbf24;
  }

  .customer-reviews__star--empty {
    color: #d1d5db;
  }

  .customer-reviews__name {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 0.25rem;
  }

  .customer-reviews__title {
    font-size: 0.75rem;
    color: #666;
    margin-bottom: 0.75rem;
  }

  .customer-reviews__text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #888;
  }

  @media screen and (max-width: 640px) {
    .customer-reviews__heading {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
      letter-spacing: 0.08em;
    }

    .customer-reviews__rating {
      font-size: 0.95rem;
      flex-wrap: wrap;
    }

    .customer-reviews__title {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
  }

  @media screen and (min-width: 640px) {
    .customer-reviews__name {
      font-size: 1rem;
    }

    .customer-reviews__title {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .customer-reviews__text {
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media screen and (min-width: 750px) {
    .customer-reviews__card {
      padding: 2.5rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "section-customer-reviews",
  "settings": [
