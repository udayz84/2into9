<section id="AboutFeatures-{{ section.id }}" class="about-features section">
  <div class="page-width">
    {%- if section.settings.show_divider -%}
     <hr class="about-features__divider">
    {%- endif -%}
    
    <div class="about-features__list">
      {%- for block in section.blocks -%}
        <div class="about-features__item" {{ block.shopify_attributes }}>
          <div class="about-features__content">
            {%- if block.settings.title != blank -%}
              <h3 class="about-features__heading">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-features__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
          <div class="about-features__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                class: 'about-features__image'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #AboutFeatures-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .about-features__divider {
    border: 0;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    margin: 0 auto 4rem;
    width: 100%;
  }

  .about-features__list {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .about-features__item {
    display: flex;
    align-items: center;
    gap: 5rem;
  }

  /* Zig-Zag Layout Logic: Alternate order */
  .about-features__item:nth-child(even) {
    flex-direction: row-reverse;
  }

  .about-features__content {
    flex: 1;
    max-width: 500px;
  }

  .about-features__image-wrapper {
    flex: 1;
  }

  .about-features__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .about-features__heading {
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.9);
  }

  .about-features__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
    .about-features__item,
    .about-features__item:nth-child(even) {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
    }

    .about-features__content {
      max-width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "About Features ZigZag",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Top Divider",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "QUALITY MATERIALS & CRAFTSMANSHIP"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We have searched the globe, leaving no stone unturned...</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Features ZigZag",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
