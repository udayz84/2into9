{%- comment -%}
  Homepage hero — full-bleed dark slider with giant UNDERWEAR watermark,
  light editorial copy block and glass SHOP NOW button. Ref: Thanksweb hero.
{%- endcomment -%}

<section
  class="hero2"
  id="Hero2-{{ section.id }}"
  style="--hero2-min-h: {% if section.settings.height == 'full' %}100svh{% else %}auto{% endif %}; --hero2-eyebrow-size: {{ section.settings.eyebrow_size }}px; --hero2-heading-size: {{ section.settings.heading_size }}px;"
>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div class="hero2__slide{% if forloop.first %} is-active{% endif %}" data-slide {% if forloop.first %}data-hero2-root{% endif %}>
          <img
            class="hero2__image"
            src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1920 }}{% else %}{{ section.settings.fallback_image | default: 'hero-home-1.jpg' | asset_url }}{% endif %}"
            alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
            width="1920"
            height="1000"
          >
          <div class="hero2__content">
            {%- if block.settings.subheading != blank -%}
              <p class="hero2__eyebrow">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="hero2__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                class="hero2__button"
                href="{{ block.settings.button_link | default: '/collections/all' }}"
              >
                {{- block.settings.button_label -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} Fallback single slide so the section renders before blocks are added {%- endcomment -%}
    <div class="hero2__slide is-active" data-slide>
      <img
        class="hero2__image"
        src="{{ section.settings.fallback_image | default: 'hero-home-1.jpg' | asset_url }}"
        alt="Model wearing 2into9 boxer briefs"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1000"
      >
      <div class="hero2__content">
        <p class="hero2__eyebrow">{{ section.settings.subheading }}</p>
        <h2 class="hero2__heading">{{ section.settings.heading }}</h2>
        <a class="hero2__button" href="{{ section.settings.button_link | default: '/collections/all' }}">
          {{- section.settings.button_label -}}
        </a>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_watermark -%}
    <p class="hero2__watermark" aria-hidden="true">{{ section.settings.watermark_text }}</p>
  {%- endif -%}

  <div class="hero2__dots" data-hero2-dots></div>
</section>

{% stylesheet %}
  .hero2 {
    position: relative;
    isolation: isolate;
    min-height: var(--hero2-min-h, 100svh);
    background: #0c0f0c;
    overflow: clip;
    display: grid;
  }

  .hero2__slide {
    grid-area: 1 / 1;
    position: relative;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .hero2__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero2__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Giant watermark under the navbar */
  .hero2__watermark {
    position: absolute;
    z-index: 1;
    top: clamp(44px, 6vh, 60px);
    left: 0;
    width: 100%;
    margin: 0;
    text-align: center;
    font-family: var(--font-heading--family);
    font-size: clamp(140px, 15.5vw, 300px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.07);
    user-select: none;
    pointer-events: none;
  }

  /* Copy block */
  .hero2__content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: var(--hero2-min-h, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    transform: translateY(4vh);
    padding-inline: clamp(1.25rem, 14vw, 22rem);
    padding-block: clamp(140px, 22vh, 220px) clamp(90px, 14vh, 150px);
  }

  .hero2__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading--family);
    font-size: var(--hero2-eyebrow-size, 26px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
  }

  .hero2__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--hero2-heading-size, 54px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.005em;
    color: #ffffff;
  }

  .hero2__button {
    display: inline-block;
    margin-top: clamp(1.25rem, 3vh, 1.75rem);
    padding: 13px 42px;
    border-radius: 4px;
    background: rgba(110, 110, 104, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }

  .hero2__button:hover {
    background: rgba(140, 140, 134, 0.6);
    color: #ffffff;
  }

  /* Carousel dots */
  .hero2__dots {
    position: absolute;
    z-index: 3;
    bottom: clamp(20px, 4vh, 36px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
  }

  .hero2__dots:empty {
    display: none;
  }

  .hero2__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .hero2__dot.is-active {
    background: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .hero2__watermark {
      font-size: clamp(64px, 19vw, 120px);
      top: clamp(56px, 8.5vh, 78px);
    }

    .hero2__image {
      object-position: 45% 22%;
    }

    .hero2__eyebrow {
      font-size: min(var(--hero2-eyebrow-size, 26px), 6.2vw);
    }

    .hero2__heading {
      font-size: min(var(--hero2-heading-size, 54px), 10.5vw);
    }

    .hero2__content {
      padding-inline: 1.25rem;
      justify-content: flex-end;
      padding-block: 0 13vh;
      transform: translateY(2vh);
      min-height: (calc(var(--hero2-min-h) - 40svh),100svh);
    }

    .hero2__button {
      padding: 13px 38px;
    }

    .hero2__dots {
      bottom: 18px;
    }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('.hero2').forEach(function (root) {
    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero2__slide'));
    var dotsWrap = root.querySelector('.hero2__dots');
    if (slides.length < 2) return;

    var current = 0;
    slides.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'hero2__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', function () {
        go(i);
      });
      dotsWrap.appendChild(dot);
    });

    var dots = Array.prototype.slice.call(dotsWrap.children);

    function go(n) {
      current = (n + slides.length) % slides.length;
      slides.forEach(function (s, i) {
        s.classList.toggle('is-active', i === current);
      });
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Homepage Hero",
  "tag": "section",
  "class": "section-custom-hero",
  "settings": [
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark text",
      "default": "UNDERWEAR"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "Show watermark",
      "default": true
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Theme image filename",
      "info": "Used when no slide image is picked. e.g. hero-home-1.jpg"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Subheading size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 54
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "natural", "label": "Image height" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Fallback slide (no blocks added)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The newest"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday wear"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "The newest"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Everyday wear"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Hero"
    }
  ]
}
{% endschema %}
