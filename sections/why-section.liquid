{%- comment -%}
  Why Section - Feature Grid with Carousel
  Displays feature items with icons in a scrollable grid
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="WhySection-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-why
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <!-- Background Pattern -->
  {%- if section.settings.bg_pattern != blank -%}
    <div class="why__bg-pattern">
      {{
        section.settings.bg_pattern
        | image_url: width: 1920
        | image_tag: alt: '', loading: 'lazy'
      }}
    </div>
  {%- endif -%}

  <div class="why__container">

    <!-- Header -->
    <div class="why__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="why__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="why__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Features Grid -->
    <div class="why__features-list">
        {%- for block in section.blocks -%}
          <div class="why__feature" {{ block.shopify_attributes }}>
            <div class="why__feature-icon-wrapper">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 100
                  | image_tag: class: 'why__feature-icon-img', alt: block.settings.label, loading: 'lazy'
                }}
              {%- else -%}
                <svg viewBox="0 0 24 24" class="why__feature-icon-svg" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}
              <span class="why__feature-label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

  </div>
</section>

{% stylesheet %}
  .section-why {
    position: relative;
    background: #f9f9f9;
    /* min-height: 100vh;
    display: flex;
    align-items: center; */
  }

  .section-why .section-background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base, 0);
    pointer-events: none;
  }

  /* Background Pattern */
  .why__bg-pattern {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 4.2;
    pointer-events: none;
  }

  .why__bg-pattern img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why__container {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 6.25rem 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .why__container {
      padding: 6.25rem 2.5rem;
    }
  }

  /* Header */
  .why__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .why__heading {
    font-family: serif, Georgia, 'Times New Roman', Times, serif;
    
    font-weight: 400;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 1.25rem;
  }

  .why__description {
    color: #555;
    font-size: 0.9375rem;
    font-weight: 300;
  }

  /* Features Grid */
  .why__features-list {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding-inline: 4px;
  }

  .why__features-list::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .why__features-list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6.25rem 2rem;
      overflow-x: visible;
    }
  }

  /* Feature Item */
  .why__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9375rem;
    flex: 0 0 calc((100% - 1rem) / 2);
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .why__feature {
      flex: auto;
      width: 100%;
    }
  }

  .why__feature-icon-wrapper {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    border: 1px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    margin-bottom: 0.3125rem;
  }

  .why__feature:hover .why__feature-icon-wrapper {
    transform: scale(1.05);
    background: #fff;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  }

  .why__feature-icon-img,
  .why__feature-icon-svg {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .why__feature-icon svg {
    width: 100%;
    height: 100%;
  }

  .why__feature-label {
    font-weight: 600;
    font-size: 0.875rem;
    color: #000;
    white-space: nowrap;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .why__feature-label {
      font-size: 0.875rem;
    }
  }

  @media screen and (max-width: 640px) {
    .why__container {
      padding: 4rem 1.25rem;
    }

    .why__header {
      margin-bottom: 2.5rem;
    }

    .why__heading {
      font-size: clamp(1.35rem, 7vw, 2rem);
      letter-spacing: 0.08em;
    }

    .why__description {
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .why__feature-label {
      font-size: 0.8125rem;
      white-space: normal;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

