{% comment %}
  Reels Video Section with Product Tagging
  Allows displaying multiple Reels-style videos with associated products
{% endcomment %}

{% liquid
  assign section_title = section.settings.title
  assign section_description = section.settings.description
  assign video_aspect_ratio = section.settings.video_aspect_ratio
  assign video_max_width = section.settings.video_max_width | default: 600
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="ReelsVideo-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-reels-video
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
  data-reels-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="reels-video__container">

    <!-- Section Header -->
    {% if section_title != blank or section_description != blank %}
      <div class="reels-video__header">
        {% if section_title != blank %}
          <h2 class="reels-video__title">{{ section_title }}</h2>
        {% endif %}
        {% if section_description != blank %}
          <p class="reels-video__description">{{ section_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Reels Videos Stack -->
    {% if section.blocks.size > 0 %}
      <div class="reel-video-wrapper">
        <button class="reel-nav reel-nav--prev" type="button" aria-label="Previous reels">
          &#8249;
        </button>
        <div class="reel-video-list">
          {% for block in section.blocks %}
            {% if block.type == 'video_reel' %}
              {% assign product = block.settings.product %}
              <div class="reel-video-card" data-max-width="{{ video_max_width }}" {{ block.shopify_attributes }}>

                <!-- Video Container -->
                <div class="reel-video-frame" style="aspect-ratio: {{ video_aspect_ratio }};">
                  {% if block.settings.video_source == 'uploaded' and block.settings.video != blank %}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '2500x',
                        autoplay: block.settings.video_autoplay,
                        loop: block.settings.video_loop,
                        muted: block.settings.video_autoplay,
                        controls: true,
                        class: 'reel-video-element'
                    }}
                  {% elsif block.settings.video_source == 'url' and block.settings.video_url != blank %}
                    {% liquid
                      assign video_id = block.settings.video_url.id
                      assign video_type = block.settings.video_url.type

                      if video_type == 'youtube'
                        assign video_src = 'https://www.youtube.com/embed/' | append: video_id
                        if block.settings.video_autoplay
                          assign video_src = video_src | append: '?autoplay=1&mute=1'
                        endif
                        if block.settings.video_loop
                          assign video_src = video_src | append: '&loop=1&playlist=' | append: video_id
                        endif
                      elsif video_type == 'vimeo'
                        assign video_src = 'https://player.vimeo.com/video/' | append: video_id
                        if block.settings.video_autoplay
                          assign video_src = video_src | append: '?autoplay=1&muted=1'
                        endif
                        if block.settings.video_loop
                          assign video_src = video_src | append: '&loop=1'
                        endif
                      endif
                    %}
                    <iframe
                      src="{{ video_src }}"
                      class="reel-video-iframe"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      title="{{ block.settings.video_alt | default: 'Reel Video' | escape }}"
                    ></iframe>
                  {% else %}
                    <div class="reel-video-placeholder">
                      <p>Add a video</p>
                    </div>
                  {% endif %}

                  <!-- Product Tag Overlay -->
                  {% if product != blank %}
                    <div class="reel-product-overlay">
                      <a href="{{ product.url }}" class="reel-product-tag">
                        <div class="reel-product-image">
                          {% if product.featured_image %}
                            {{
                              product.featured_image
                              | image_url: width: 160
                              | image_tag:
                                loading: 'lazy',
                                alt: product.featured_image.alt,
                                class: 'reel-product-img'
                            }}
                          {% endif %}
                        </div>
                        <div class="reel-product-info">
                          <p class="reel-product-title">{{ product.title }}</p>
                          <div class="reel-product-pricing">
                            {% if product.compare_at_price > product.price %}
                              <span class="reel-product-compare">{{ product.compare_at_price | money }}</span>
                            {% endif %}
                            <span class="reel-product-price">{{ product.price | money }}</span>
                          </div>
                        </div>
                        <span aria-hidden="true" class="reel-product-arrow">&#8250;</span>
                      </a>
                    </div>
                  {% endif %}
                </div>

              </div>
            {% endif %}
          {% endfor %}
        </div>
        <button class="reel-nav reel-nav--next" type="button" aria-label="Next reels">
          &#8250;
        </button>
      </div>
    {% else %}
      <div class="reel-video-empty">
        <p>Add video reels to get started</p>
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
  function initAllReelsSections() {
    var sections = document.querySelectorAll('[data-reels-section-id]');

    sections.forEach(function (section) {
      if (section.dataset.reelsInit === 'true') return;

      var scroller = section.querySelector('.reel-video-list');
      var prevButton = section.querySelector('.reel-nav--prev');
      var nextButton = section.querySelector('.reel-nav--next');

      if (!scroller || !prevButton || !nextButton) return;

      var firstCard = scroller.querySelector('.reel-video-card');

      function getScrollAmount() {
        if (firstCard) {
          var rect = firstCard.getBoundingClientRect();
          var cardWidth = rect.width;
          var gap = 24;
          return cardWidth + gap;
        }
        return scroller.clientWidth || 0;
      }

      function scrollByAmount(direction) {
        var amount = getScrollAmount() * direction;
        var newLeft = scroller.scrollLeft + amount;
        if (typeof scroller.scrollTo === 'function') {
          scroller.scrollTo({ left: newLeft, behavior: 'smooth' });
        } else {
          scroller.scrollLeft = newLeft;
        }
      }

      prevButton.addEventListener('click', function () {
        scrollByAmount(-1);
      });

      nextButton.addEventListener('click', function () {
        scrollByAmount(1);
      });

      section.dataset.reelsInit = 'true';
    });
  }

  initAllReelsSections();

  document.addEventListener('DOMContentLoaded', initAllReelsSections);
  document.addEventListener('shopify:section:load', initAllReelsSections);
{% endjavascript %}

{% stylesheet %}
  .section-reels-video {
    position: relative;
  }

  .section-reels-video .section-background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base, 0);
    pointer-events: none;
  }

  .reels-video__container {
    /* max-width: 80rem; */
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  @media screen and (min-width: 750px) {
    .reels-video__container {
      padding: 4rem 2rem;
    }
  }

  /* Header */
  .reels-video__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .reels-video__title {
    /* font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700; */
    color: rgb(var(--color-foreground));
    margin-bottom: 1rem;
  }

  .reels-video__description {
    max-width: 42rem;
    margin: 0 auto;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Video List */
  .reel-video-list {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: flex-start;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    padding-inline: 6px;
    padding-bottom: 8px;
  }

  .reel-video-list::-webkit-scrollbar {
    display: none;
  }

  .reel-video-card {
    flex: 0 0 calc((100% - 72px) / 4);
    max-width: min(calc((100% - 72px) / 4), var(--reel-max-width, 600px));
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 1025px) {
    .reel-video-card {
      --reel-max-width: 600px;
    }
  }

  @media screen and (max-width: 1024px) {
    .reel-video-card {
      flex: 0 0 calc((100% - 48px) / 3);
      max-width: calc((100% - 48px) / 3);
    }
  }

  @media screen and (max-width: 767px) {
    .reel-video-card {
      flex: 0 0 calc((100% - 12px) / 2);
      max-width: calc((100% - 12px) / 2);
    }
  }

  @media screen and (max-width: 400px) {
    .reel-video-card {
      flex: 0 0 calc(100% - 12px);
      max-width: calc(100% - 12px);
    }
  }

  /* Navigation */
  .reel-video-wrapper {
    position: relative;
  }

  .reel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    border: none;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111827;
    z-index: 5;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .reel-nav:hover {
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
  }

  .reel-nav--prev {
    left: 8px;
  }

  .reel-nav--next {
    right: 8px;
  }

  @media screen and (max-width: 767px) {
    .reel-nav {
      display: none;
    }
  }

  /* Video Frame */
  .reel-video-frame {
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #e5e7eb;
  }

  .reel-video-element,
  .reel-video-iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel-video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .reel-video-empty {
    text-align: center;
    padding: 3rem;
    color: rgba(var(--color-foreground), 0.5);
  }

  /* Product Overlay */
  .reel-product-overlay {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 12px 10px 18px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }

  .reel-product-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 8px 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.7);
    min-width: 0;
    width: 100%;
  }

  @media screen and (max-width: 640px) {
    .reels-video__header {
      margin-bottom: 2rem;
      gap: 0.5rem;
    }

    .reels-video__title {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .reels-video__description {
      font-size: 0.95rem;
      line-height: 1.5;
    }
  }

  .reel-product-tag:hover {
    transform: scale(1.02);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.25);
  }

  .reel-product-image {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reel-product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .reel-product-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .reel-product-title {
    font-weight: 600;
    font-size: 13px;
    color: #111827;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reel-product-pricing {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px;
  }

  .reel-product-price {
    font-weight: 700;
    color: #111827;
    font-size: 13px;
  }

  .reel-product-compare {
    font-size: 11px;
    color: #6b7280;
    text-decoration: line-through;
  }

  .reel-product-arrow {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-left: 4px;
    flex-shrink: 0;
    line-height: 1;
  }

  @media screen and (max-width: 767px) {
    .reel-video-list {
      gap: 12px;
    }

    .reel-product-overlay {
      padding: 8px 10px 12px;
    }

    .reel-product-tag {
      gap: 8px;
      padding: 7px 9px;
      border-radius: 10px;
    }

    .reel-product-image {
      width: 38px;
      height: 38px;
      border-radius: 8px;
    }

    .reel-product-title {
      font-size: 12px;
    }

    .reel-product-price {
      font-size: 12px;
    }

    .reel-product-compare {
      font-size: 10px;
    }

    .reel-product-arrow {
      font-size: 14px;
    }

    .reels-video__container {
      padding: 2rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reels Video Section",
  "tag": "section",
  "class": "section-reels-video",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop Our Reels"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "video_aspect_ratio",
      "label": "Video Aspect Ratio",
      "options": [
        {
          "value": "9/16",
          "label": "Portrait (9:16) - Reels Style"
        },
        {
          "value": "16/9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Standard (4:3)"
        }
      ],
      "default": "9/16"
    },
    {
      "type": "range",
      "id": "video_max_width",
      "label": "Video Max Width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 600,
      "info": "Maximum width for each video"
    }
  ],
  "blocks": [
    {
      "type": "video_reel",
      "name": "Video Reel",
      "settings": [
        {
          "type": "header",
          "content": "Video Settings"
        },
        {
          "type": "select",
          "id": "video_source",
          "label": "Video Source",
          "options": [
            {
              "value": "uploaded",
              "label": "Uploaded Video"
            },
            {
              "value": "url",
              "label": "External URL (YouTube/Vimeo)"
            }
          ],
          "default": "uploaded"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a video file"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Enter a YouTube or Vimeo URL",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "video_alt",
          "label": "Video Alt Text",
          "info": "Description for accessibility"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay Video",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop Video",
          "default": true
        },
        {
          "type": "header",
          "content": "Video Information"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title"
        },
        {
          "type": "textarea",
          "id": "video_description",
          "label": "Video Description"
        },
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reels Video Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "video_reel"
        },
        {
          "type": "video_reel"
        },
        {
          "type": "video_reel"
        }
      ]
    }
  ]
}
{% endschema %}
