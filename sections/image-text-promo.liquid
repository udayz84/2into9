      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MEN'S TRUNK"
    },

    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop label",
      "default": "SHOP"
    },

    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },

    {
      "type": "select",
      "id": "text_side",
      "label": "Text side",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "gap_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "gap_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 34
    },

    {
      "type": "range",
      "id": "inset_vw",
      "label": "Text inset",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "vw",
      "default": 16
    },

    {
      "type": "range",
      "id": "small_image_width",
      "label": "Small image width",
      "min": 30,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 58
    }

  ],

  "presets": [
    {
      "name": "Image Text Promo"
    }
  ]
}

{% endschema %} {% endcomment %}

