      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
      width: 100% !important;
    }

    .ph-bundle {
      height: auto !important;
      min-height: 78px !important;
      padding-block-end: 12px !important;
    }
