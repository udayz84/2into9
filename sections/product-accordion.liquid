<product-accordion class="pa" style="--pa-padding-inline: {{ section.settings.page_padding }}px;">
  <div class="pa__grid">
    <div class="pa__spacer" aria-hidden="true"></div>
    <div>
      <span class="pa__label">{{ section.settings.step_label | default: '4. Product details' }}</span>
      <div class="pa__list">
      {%- for block in section.blocks -%}
        <div
          class="pa-item{% if forloop.first and section.settings.open_first %} is-open{% endif %}"
          data-accordion-item
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="pa-item__header"
            data-accordion-trigger
            aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}"
          >
            <span class="pa-item__title">{{ block.settings.title }}</span>
            <span class="pa-item__icon" aria-hidden="true">
              <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 5.5l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
          <div class="pa-item__content" data-accordion-content{% unless forloop.first and section.settings.open_first %} hidden{% endunless %}>
            <div class="pa-item__body">
              {%- if block.settings.use_product_description -%}
                {{ product.description }}
              {%- else -%}
                {{ block.settings.content }}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
      </div>
    </div>
  </div>
</product-accordion>

<script>
  (function() {
    function preAlign() {
      if (window.innerWidth < 1024) {
        var pa = document.querySelector('product-accordion');
        if (pa) {
          pa.style.marginTop = '';
          pa.style.minHeight = '';
        }
        return;
      }
      var pa = document.querySelector('product-accordion');
      var hero = document.querySelector('product-hero');
      if (!pa || !hero) return;
      var buyCol = hero.querySelector('.ph__buy-col');
      if (!buyCol) return;
      var bottomRef = buyCol.querySelector('.pcb__divider') || buyCol.querySelector('.pcb-atc') || buyCol;
      var buyBottom = bottomRef.getBoundingClientRect().bottom + window.scrollY;
      var paContent = pa.querySelector('.pa__grid > div:last-child');
      if (!paContent) return;
      var currentMargin = parseFloat(pa.style.marginTop) || 0;
      var paContentDocTop = (paContent.getBoundingClientRect().top + window.scrollY) - currentMargin;
      var naturalGap = paContentDocTop - buyBottom;
      var pullUp = naturalGap - 20;
      if (pullUp > 0) {
        pa.style.marginTop = '-' + Math.round(pullUp) + 'px';
      }
      var galleryCol = hero.querySelector('.ph__gallery-col');
      if (galleryCol) {
        var galleryBottom = galleryCol.getBoundingClientRect().bottom + window.scrollY;
        var paCurrentTop = pa.getBoundingClientRect().top + window.scrollY;
        var minH = galleryBottom - paCurrentTop;
        if (minH > 0) {
          pa.style.minHeight = Math.round(minH) + 'px';
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', preAlign);
    } else {
      preAlign();
    }
    window.addEventListener('load', preAlign, { passive: true });
    window.addEventListener('resize', preAlign, { passive: true });
  })();
</script>

<script src="{{ 'product-accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Accordion",
  "tag": "section",
  "class": "section-pa",
  "settings": [
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "Step label",
      "default": "4. Product details"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description as content",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Accordion",
      "blocks": [
        { "type": "item", "settings": { "title": "Product Description", "use_product_description": true } },
        { "type": "item", "settings": { "title": "Fit & Fabric", "content": "<p>Ultra-soft bamboo viscose with anti-chafe panels, a 3D comfort pouch and moisture-wicking finish for all-day freshness.</p>" } },
        { "type": "item", "settings": { "title": "Shipping", "content": "<p>Complimentary shipping within India. No tariffs apply. Orders dispatch within 24–48 hours and arrive in 3–7 business days.</p>" } },
        { "type": "item", "settings": { "title": "30 Day First Pair Guarantee", "content": "<p>Don't love your first pair? Wear it, wash it — if you're not satisfied within 30 days, we'll refund you. No questions asked.</p>" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pa,
  .pa h1,
  .pa h2,
  .pa h3,
  .pa h4,
  .pa p,
  .pa span,
  .pa button,
  .pa input,
  .pa a {
    font-family: var(--pa-font);
  }

  .pa {
    --pa-ink: #171717;
    --pa-border: #dcdcdc;
    --pa-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    display: block;
    position: relative;
    z-index: 1;
    font-family: var(--pa-font);
    color: var(--pa-ink);
    padding-inline: clamp(20px, 4vw, var(--pa-padding-inline, 60px));
    padding-block-start: 24px;
    padding-block-end: 64px;
    pointer-events: none;
  }

  .pa__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    justify-content: flex-start;
    align-items: start;
    max-width: 1240px;
    margin-inline: auto;
    pointer-events: none;
  }

  .pa__spacer {
    display: block;
    width: 100%;
    pointer-events: none !important;
  }

  .pa__grid > div:last-child {
    pointer-events: auto;
  }

  .pa__label {
    display: block;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--pa-ink);
    margin-block-end: 14px;
  }

  .pa__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pa-item {
    border: 1px solid var(--pa-border);
    border-radius: 12px;
    background: #fff;
    overflow: clip;
  }

  .pa-item__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    height: 54px;
    padding-inline: 20px;
    padding-block: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--pa-font);
  }

  .pa-item__title {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;
    color: #000;
    text-align: left;
  }

  .pa-item__icon {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f3f3f3;
    color: var(--pa-ink);
    display: grid;
    place-items: center;
    transition: transform 0.25s ease;
  }

  .pa-item__icon svg {
    width: 14px;
    height: 14px;
  }

  .pa-item.is-open .pa-item__icon {
    transform: rotate(180deg);
  }

  .pa-item__content {
    border-block-start: 1px solid var(--pa-border);
  }

  .pa-item__body {
    padding: 16px 20px 20px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--pa-ink);
  }

  .pa-item__body p {
    margin: 0 0 10px;
  }

  .pa-item__body p:last-child {
    margin-block-end: 0;
  }

  /* ---- Mobile: structure ≤1023px, sizing ≤749px. Desktop untouched. ---- */
  @media (max-width: 1023px) {
    .pa {
      padding-inline: 20px;
      padding-block-start: 20px;
      padding-block-end: 20px;
      min-height: auto !important;
      margin-top: 0 !important;
    }

    .pa__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }

    .pa__spacer {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .pa__label {
      font-size: 14px;
    }

    .pa-item__header {
      height: 48px;
      padding-inline: 16px;
    }

    .pa-item__title {
      font-size: 14.5px;
      line-height: 20px;
    }

    .pa-item__body {
      padding: 12px 16px 16px;
      font-size: 13.5px;
    }
  }
{% endstylesheet %}
