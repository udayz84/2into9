{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

<div class="pw" style="--pw-padding-inline: {{ section.settings.page_padding }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="pw__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pw__cards">
    {%- for block in section.blocks -%}
      <a
        class="pw-card"
        {% if block.settings.link != blank %}
          href="{{ block.settings.link }}"
        {% else %}
          href="{{ routes.all_products_collection_url }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="pw-card__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 740
              | image_tag:
                class: 'pw-card__image',
                widths: '370, 555, 740',
                sizes: '370px',
                loading: 'lazy',
                alt: block.settings.label
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pw-card__image pw-card__image--placeholder' }}
          {%- endif -%}
          <div class="pw-card__overlay" aria-hidden="true"></div>
          {%- if block.settings.label != blank -%}
            <span class="pw-card__label">{{ block.settings.label }}</span>
          {%- endif -%}
          <div class="pw-card__chips">
            <div class="pw-card__chip">
              <span class="pw-card__chip-icon">{%- render 'icon-check' -%}</span>
              <span>{{ section.settings.chip_1 }}</span>
            </div>
            <div class="pw-card__chip">
              <span class="pw-card__chip-icon">{%- render 'icon-check' -%}</span>
              <span>{{ section.settings.chip_2 }}</span>
            </div>
            <div class="pw-card__chip">
              <span class="pw-card__chip-icon">{%- render 'icon-check' -%}</span>
              <span>{{ section.settings.chip_3 }}</span>
            </div>
            <div class="pw-card__chip">
              <span class="pw-card__chip-icon">{%- render 'icon-check' -%}</span>
              <span>{{ section.settings.chip_4 }}</span>
            </div>
          </div>
        </div>
        <span class="pw-card__button">{{ block.settings.button_label }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Why",
  "tag": "section",
  "class": "section-pw",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why 2into9 Underwear?"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Feature chips"
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Chip 1",
      "default": "Moisture-wicking"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Chip 2",
      "default": "Organic + Sustainable"
    },
    {
      "type": "text",
      "id": "chip_3",
      "label": "Chip 3",
      "default": "Anti-chafe Panels"
    },
    {
      "type": "text",
      "id": "chip_4",
      "label": "Chip 4",
      "default": "3D Pouch Comfort"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Card label",
          "default": "Mens"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Why",
      "blocks": [
        { "type": "card", "settings": { "label": "Mens" } },
        { "type": "card", "settings": { "label": "Kids" } },
        { "type": "card", "settings": { "label": "D-Lock" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pw,
  .pw h1,
  .pw h2,
  .pw h3,
  .pw h4,
  .pw p,
  .pw span,
  .pw button,
  .pw input,
  .pw a {
    font-family: var(--pw-font);
  }

  .pw {
    --pw-ink: #171717;
    --pw-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    font-family: var(--pw-font);
    color: var(--pw-ink);
    padding-inline: var(--pw-padding-inline, 110px);
    padding-block: 0 120px;
    overflow:hidden;
    padding-top: 120px;
  }

  .pw__heading {
    margin: 0 0 clamp(24px, 3.2vw, 42px);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--pw-ink);
  }

  .pw__cards {
    display: flex;
    justify-content: center;
    gap: 40px;
  }

  .pw-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 370px;
    text-decoration: none;
    color: inherit;
  }

  .pw-card__media {
    position: relative;
    width: 370px;
    height: 470px;
    border-radius: 20px;
    background: #d9d9d9;
    overflow: hidden;
  }

  .pw-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pw-card__image--placeholder {
    width: 100%;
    height: 100%;
  }

  .pw-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0) 22%,
      rgba(0, 0, 0, 0.1) 45%,
      rgba(0, 0, 0, 0.6) 72%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .pw-card__label {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .pw-card__chips {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 20px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 14px;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    box-sizing: border-box;
    z-index: 2;
  }

  .pw-card__chip {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
    letter-spacing: 0.1px;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .pw-card__chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    min-width: 17px;
    border-radius: 50%;
    background: #ffffff;
    color: #171717;
    flex-shrink: 0;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .pw-card__chip-icon svg {
    width: 9px;
    height: 9px;
    stroke: #171717;
    stroke-width: 2.4;
  }

  .pw-card__button {
    margin-block-start: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding-inline: 48px;
    border-radius: 50px;
    background: #ffffff;
    color: var(--pw-ink);
    border: 1.5px solid var(--pw-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }

  .pw-card__button:hover,
  .pw-card__button:active {
    background: var(--pw-ink);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  /* ---- Mobile: cards become a swipe carousel ≤1023px, type ≤749px. Desktop untouched. ---- */
  @media (max-width: 1023px) {
    .pw {
      padding-inline: 24px;
      padding-block-end: 64px;
    }

    .pw__cards {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: -24px;
      padding-inline: 24px;
      scroll-padding-inline: 24px;
      padding-block-end: 8px;
      gap: 16px;
    }

    .pw__cards::-webkit-scrollbar {
      display: none;
    }

    .pw-card {
      flex: 0 0 310px;
      max-width: 310px;
      scroll-snap-align: start;
    }

    .pw-card__media {
      width: 100%;
      height: auto;
      aspect-ratio: 370 / 470;
    }

    .pw-card__image--placeholder {
      object-fit: cover;
    }
  }

  @media (max-width: 749px) {
    .pw__heading {
      font-size: 24px;
      font-weight: 800;
    }

    .pw-card {
      flex: 0 0 85%;
      max-width: 320px;
      scroll-snap-align: center;
    }

    .pw-card__chips {
      left: 12px;
      right: 12px;
      bottom: 14px;
      padding: 10px 12px;
      gap: 8px 10px;
      border-radius: 12px;
    }

    .pw-card__chip {
      font-size: 11px;
    }

    .pw-card__chip-icon {
      width: 15px;
      height: 15px;
      min-width: 15px;
    }

    .pw-card__chip-icon svg {
      width: 8px;
      height: 8px;
    }

    .pw-card__button {
      margin-block-start: 16px;
      height: 44px;
      max-width: 220px;
      font-size: 12px;
    }
  }
{% endstylesheet %}
