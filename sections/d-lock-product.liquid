    font-size: clamp(13px, 0.9375cqw, 18px);
    font-weight: 600;
    line-height: 1.5;
    color: #ffffff;
    white-space: nowrap;
  }

  .d-lock-product__offer-per-pair {
    font-size: clamp(11px, 0.625cqw, 12px);
    font-weight: 400;
    line-height: 1.5;
    color: #ffffff;
    white-space: nowrap;
  }

  .d-lock-product__actions {
    display: flex;
    gap: 0.5208cqw;
    margin-top: 2.9167cqw;
  }

  .d-lock-product__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 9.1146cqw;
    height: 3.4896cqw;
    padding: 0 1.0417cqw;
    background: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 1.0417cqw;
  }

  .d-lock-product__qty-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: clamp(16px, 1.25cqw, 24px);
    font-weight: 600;
    color: #171717;
