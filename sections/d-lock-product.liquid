    }

    .d-lock-product__size-label {
      margin-top: 24px;
      font-size: 15px;
    }

    .d-lock-product__sizes {
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
    }

    .d-lock-product__size {
      width: 64px;
      height: 48px;
      font-size: 16px;
    }

    .d-lock-product__offers {
      gap: 10px;
      margin-top: 28px;
    }

    .d-lock-product__offer {
      height: 68px;
      padding: 0 16px 0 14px;
    }

    .d-lock-product__offer-title,
    .d-lock-product__offer-price {
      font-size: 15px;
    }

    .d-lock-product__offer-sub,
    .d-lock-product__offer-per-pair {
      font-size: 11px;
    }

    .d-lock-product__offer-radio {
      width: 18px;
      height: 18px;
    }

    .d-lock-product__actions {
      flex-direction: column;
      gap: 10px;
      margin-top: 32px;
    }

    .d-lock-product__qty {
      width: 100%;
      height: 54px;
    }

    .d-lock-product__qty-btn,
    .d-lock-product__qty-value {
      font-size: 20px;
    }

    .d-lock-product__atc {
      width: 100%;
      height: 54px;
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    var root = event.target.closest('[data-dlp-root]');
    if (!root) return;

    var sizeButton = event.target.closest('[data-dlp-size]');
    if (sizeButton) {
      root.querySelectorAll('[data-dlp-size]').forEach(function (button) {
        button.classList.toggle('is-active', button === sizeButton);
      });
      return;
    }

    var offerButton = event.target.closest('[data-dlp-offer]');
    if (offerButton) {
      root.querySelectorAll('[data-dlp-offer]').forEach(function (button) {
        button.classList.toggle('is-selected', button === offerButton);
      });
      return;
    }

    var stepButton = event.target.closest('[data-dlp-step]');
    if (stepButton) {
      var qty = stepButton.closest('[data-dlp-qty]');
      var value = parseInt(qty.getAttribute('data-dlp-value'), 10) + parseInt(stepButton.getAttribute('data-dlp-step'), 10);
      value = Math.max(1, value);
      qty.setAttribute('data-dlp-value', value);
      qty.querySelector('[data-dlp-qty-value]').textContent = value;
      return;
    }

    var thumbButton = event.target.closest('[data-dlp-thumb]');
    if (thumbButton) {
      root.querySelectorAll('[data-dlp-thumb]').forEach(function (button) {
        button.classList.toggle('is-active', button === thumbButton);
      });
      var mainImage = root.querySelector('[data-dlp-main-frame] .d-lock-product__main-img');
      if (mainImage && thumbButton.getAttribute('data-dlp-src')) {
        mainImage.src = thumbButton.getAttribute('data-dlp-src');
        mainImage.classList.add('is-swap');
      }
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "D-Lock Product",
  "tag": "section",
  "class": "section-d-lock-product",
  "settings": [
