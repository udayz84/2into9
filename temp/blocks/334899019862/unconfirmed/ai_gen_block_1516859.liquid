{% doc %}
  @prompt
    want small popup on website load after 5 second with "Our deliveries begin after Diwali. Thank you for your patience and excitement!" and animated emoji and want option to change content, image or icon
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-delivery-notice-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; }
  .ai-delivery-notice-{{ ai_gen_id }}__popup { position: fixed; right: 20px; bottom: 20px; z-index: 9999; display: flex; align-items: center; gap: 14px; width: min(390px, calc(100vw - 32px)); padding: 18px 48px 18px 18px; color: {{ block.settings.text_color }}; background: {{ block.settings.background_color }}; border: 1px solid {{ block.settings.border_color }}; border-radius: 14px; box-shadow: 0 8px 28px rgba(0,0,0,.18); font-family: inherit; }
  .ai-delivery-notice-{{ ai_gen_id }}__popup[hidden] { display: none; }
  .ai-delivery-notice-{{ ai_gen_id }}__visual { display: flex; flex: 0 0 48px; width: 48px; height: 48px; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: {{ block.settings.icon_background }}; }
  .ai-delivery-notice-{{ ai_gen_id }}__emoji { font-size: 30px; line-height: 1; animation: ai-delivery-notice-wiggle-{{ ai_gen_id }} 1.8s ease-in-out infinite; }
  .ai-delivery-notice-{{ ai_gen_id }}__visual img { width: 100%; height: 100%; object-fit: cover; }
  .ai-delivery-notice-{{ ai_gen_id }}__message { margin: 0; font-size: 14px; line-height: 1.5; }
  .ai-delivery-notice-{{ ai_gen_id }}__message p { margin: 0; }
  .ai-delivery-notice-{{ ai_gen_id }}__close { position: absolute; top: 8px; right: 8px; display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; padding: 0; color: {{ block.settings.text_color }}; background: transparent; border: 0; border-radius: 50%; cursor: pointer; }
  .ai-delivery-notice-{{ ai_gen_id }}__close:hover { background: rgba(0,0,0,.08); }
  .ai-delivery-notice-{{ ai_gen_id }}__close:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @keyframes ai-delivery-notice-wiggle-{{ ai_gen_id }} { 0%,100% { transform: rotate(0deg) scale(1); } 25% { transform: rotate(-12deg) scale(1.08); } 50% { transform: rotate(10deg) scale(1.08); } 75% { transform: rotate(-6deg) scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .ai-delivery-notice-{{ ai_gen_id }}__emoji { animation: none; } }
  @media screen and (max-width: 480px) { .ai-delivery-notice-{{ ai_gen_id }}__popup { right: 12px; bottom: 12px; width: calc(100vw - 24px); padding: 16px 44px 16px 14px; } }
{% endstyle %}
<delivery-notice-{{ ai_gen_id }} class="ai-delivery-notice-{{ ai_gen_id }}" data-delay="{{ block.settings.delay_seconds | times: 1000 }}" {{ block.shopify_attributes }}>
  <aside class="ai-delivery-notice-{{ ai_gen_id }}__popup" role="status" aria-live="polite" hidden>
    <div class="ai-delivery-notice-{{ ai_gen_id }}__visual" aria-hidden="true">
      {% if block.settings.visual_type == 'image' and block.settings.notice_image != blank %}<img src="{{ block.settings.notice_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
      {% elsif block.settings.visual_type == 'image' %}<span class="ai-delivery-notice-{{ ai_gen_id }}__emoji">✨</span>
      {% else %}<span class="ai-delivery-notice-{{ ai_gen_id }}__emoji">{{ block.settings.emoji | escape }}</span>{% endif %}
    </div>
    <div class="ai-delivery-notice-{{ ai_gen_id }}__message">{{ block.settings.message }}</div>
    <button class="ai-delivery-notice-{{ ai_gen_id }}__close" type="button" aria-label="Close notice"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  </aside>
</delivery-notice-{{ ai_gen_id }}>
<script>
  (function() {
    const tagName = 'delivery-notice-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class DeliveryNotice extends HTMLElement {
      connectedCallback() {
        this.popup = this.querySelector('.ai-delivery-notice-{{ ai_gen_id }}__popup');
        this.closeButton = this.querySelector('.ai-delivery-notice-{{ ai_gen_id }}__close');
        this.timer = window.setTimeout(() => { if (this.isConnected && this.popup) this.popup.hidden = false; }, Number(this.dataset.delay) || 5000);
        this.closeButton.addEventListener('click', () => { this.popup.hidden = true; });
      }
      disconnectedCallback() { window.clearTimeout(this.timer); }
    }
    customElements.define(tagName, DeliveryNotice);
  })();
</script>
{% schema %}
{
  "name": "Delivery notice popup",
  "settings": [
    { "type": "header", "content": "Notice content" },
    { "type": "richtext", "id": "message", "label": "Message", "default": "<p>Our deliveries begin after Diwali. Thank you for your patience and excitement!</p>" },
    { "type": "range", "id": "delay_seconds", "label": "Show after", "min": 1, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Visual" },
    { "type": "select", "id": "visual_type", "label": "Visual type", "options": [{ "value": "emoji", "label": "Emoji" }, { "value": "image", "label": "Image" }], "default": "emoji" },
    { "type": "text", "id": "emoji", "label": "Emoji", "default": "✨" },
    { "type": "image_picker", "id": "notice_image", "label": "Image" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E6E6E6" },
    { "type": "color", "id": "icon_background", "label": "Visual background", "default": "#F5F5F5" }
  ],
  "presets": [{ "name": "Delivery notice popup" }],
  "tag": null,
  "class": "delivery-notice-block"
}
{% endschema %}