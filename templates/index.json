    "home_faq_Tf3gHw": {
      "type": "home-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I find the right size?",
            "answer": "Refer to the size guide and compare it to your measurements. If you fall between two sizes, we recommend choosing the larger size."
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How do I wash my Underwear?",
            "answer": "Wash in cold water with similar colours on a gentle cycle. Avoid bleach and fabric softener. Tumble dry on low or air dry. For D-LOCK, remove the protective box before washing."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Why switch to bamboo underwear? My cotton pairs are fine?",
            "answer": "Cotton is a solid fabric, and if it works for you, that’s fair. Here’s what’s different about 2into9: our Mens' and Kid's underwear are made from bamboo viscose (a soft fabric made from bamboo pulp) blended with 7% spandex for stretch. It feels noticeably smoother against the skin than standard cotton, absorbs sweat well, and stays comfortable through a long day. Most people notice the difference by the second wear. To keep them soft and in shape, wash cold and skip the tumble dryer."
          }
        }
      },
