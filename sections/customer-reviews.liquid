{%- comment -%}
  Customer Reviews Section
  Displays testimonial cards in a grid layout
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="CustomerReviews-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-customer-reviews
    {% unless section.settings.autoplay %}customer-reviews--manual{% endunless %}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %} --reviews-duration: {{ section.settings.autoplay_speed | default: 30 }}s;"
>
  <div class="customer-reviews__container">

    <!-- Header -->
    <div class="customer-reviews__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="customer-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <p class="customer-reviews__rating">
          {%- if section.settings.show_stars -%}
            <span class="customer-reviews__stars">{{ section.settings.star_icon | default: '★' }}</span>
          {%- endif -%}
          <span>{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}
    </div>

    {%- capture review_cards -%}
      {%- for block in section.blocks -%}
        <div class="customer-reviews__card" {{ block.shopify_attributes }}>

          <!-- Stars Rating -->
          {%- if block.settings.rating != blank -%}
            <div class="customer-reviews__card-stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <span class="customer-reviews__star customer-reviews__star--filled">{{ section.settings.star_icon | default: '★' }}</span>
                {%- else -%}
                  <span class="customer-reviews__star customer-reviews__star--empty">{{ section.settings.star_empty_icon | default: '☆' }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Reviewer Name -->
          {%- if block.settings.reviewer_name != blank -%}
            <h3 class="customer-reviews__name">{{ block.settings.reviewer_name }}</h3>
          {%- endif -%}

          <!-- Reviewer Title -->
          {%- if block.settings.reviewer_title != blank -%}
            <p class="customer-reviews__title">{{ block.settings.reviewer_title }}</p>
          {%- endif -%}

          <!-- Review Text -->
          {%- if block.settings.review_text != blank -%}
            <p class="customer-reviews__text">{{ block.settings.review_text }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- liquid
      # Repeat the set so one group always covers the widest viewport (~7 cards x 410px)
      assign repeat_factor = 1
      if section.blocks.size > 0
        assign repeat_factor = 7.0 | divided_by: section.blocks.size | ceil
      endif
      if repeat_factor < 1
        assign repeat_factor = 1
      endif
    -%}

    <!-- Reviews Carousel (duplicated groups = seamless infinite loop) -->
    <div class="customer-reviews__viewport" data-reviews-viewport>
      <div class="customer-reviews__track" data-reviews-track>
        <div class="customer-reviews__group">
          {%- for i in (1..repeat_factor) -%}{{ review_cards }}{%- endfor -%}
        </div>
        <div class="customer-reviews__group" aria-hidden="true">
          {%- for i in (1..repeat_factor) -%}{{ review_cards }}{%- endfor -%}
        </div>
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .section-customer-reviews {
    position: relative;
    background: #fff;
    overflow-x: hidden;
  }

  .section-customer-reviews .section-background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base, 0);
    pointer-events: none;
  }

  .customer-reviews__container {
    max-width: 75rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .customer-reviews__container {
      padding: 5rem 2rem;
    }
  }

  /* Header */
  .customer-reviews__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .customer-reviews__heading {
    font-size: clamp(2.25rem, 4vw, 3rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 0.75rem;
  }

  .customer-reviews__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #555;
    font-size: 1rem;
  }

  .customer-reviews__stars {
    color: #fbbf24;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
  }

  /* Reviews Carousel — duplicated groups make the loop seamless.
     Full-bleed: the strip spans the entire page width. */
  .customer-reviews__viewport {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
  }

  .customer-reviews__track {
    --reviews-gap: 20px;
    display: flex;
    gap: var(--reviews-gap);
    width: max-content;
    animation: customer-reviews-marquee var(--reviews-duration, 30s) linear infinite;
  }

  /* Pause only when hovering the strip itself, not empty section space */
  .customer-reviews__viewport:hover .customer-reviews__track {
    animation-play-state: paused;
  }

  .customer-reviews__group {
    display: flex;
    gap: var(--reviews-gap);
  }

  @keyframes customer-reviews-marquee {
    to {
      transform: translateX(calc(-50% - (var(--reviews-gap) / 2)));
    }
  }

  /* Manual mode (setting off): swipe instead of auto-slide */
  .customer-reviews--manual .customer-reviews__viewport {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .customer-reviews--manual .customer-reviews__track {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-customer-reviews .customer-reviews__viewport {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .section-customer-reviews .customer-reviews__track {
      animation: none;
    }
  }

  .customer-reviews__viewport::-webkit-scrollbar {
    display: none;
  }

  /* Review Card */
  .customer-reviews__card {
    background: #f5f5f5;
    border-radius: 1rem;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    max-width: 100%;
  }

  @media screen and (min-width: 640px) {
    .customer-reviews__card {
      padding: 2rem 1.5rem;
    }
  }

  .customer-reviews__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .customer-reviews__card-stars {
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }

  .customer-reviews__star {
    font-size: 1.125rem;
  }

  .customer-reviews__star--filled {
    color: #fbbf24;
  }

  .customer-reviews__star--empty {
    color: #d1d5db;
  }

  .customer-reviews__name {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111;
    margin-bottom: 0.25rem;
  }

  .customer-reviews__title {
    font-size: 0.75rem;
    color: #666;
    margin-bottom: 0.75rem;
  }

  .customer-reviews__text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #888;
  }

  @media screen and (max-width: 640px) {
    .customer-reviews__heading {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
      letter-spacing: 0.08em;
    }

    .customer-reviews__rating {
      font-size: 0.95rem;
      flex-wrap: wrap;
    }

    .customer-reviews__title {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
  }

  @media screen and (min-width: 640px) {
    .customer-reviews__name {
      font-size: 1rem;
    }

    .customer-reviews__title {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .customer-reviews__text {
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media screen and (min-width: 750px) {
    .customer-reviews__card {
      padding: 2.5rem 2rem;
    }
  }

  /* Carousel card sizing */
  .customer-reviews__card {
    flex: 0 0 390px;
    width: 390px;
    box-sizing: border-box;
  }

  @media screen and (max-width: 749px) {
    .customer-reviews__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
    }

    .customer-reviews__track {
      --reviews-gap: 16px;
      animation: none;
    }

    .customer-reviews__card {
      flex-basis: min(78vw, 340px);
      width: min(78vw, 340px);
      scroll-snap-align: center;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function initReviewsLoop(sectionId) {
      const section = document.getElementById(sectionId);
      if (!section) return;
      const viewport = section.querySelector('[data-reviews-viewport]');
      const track = section.querySelector('[data-reviews-track]');
      if (!viewport || !track || track.children.length < 2) return;

      const isMobile = window.matchMedia('(max-width: 749px)');
      let ticking = false;

      viewport.addEventListener(
        'scroll',
        () => {
          if (!isMobile.matches || ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const group = track.children[0];
            const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
            const shift = group.offsetWidth + gap;
            if (viewport.scrollLeft >= shift) {
              viewport.scrollLeft -= shift;
            }
            ticking = false;
          });
        },
        { passive: true }
      );
    }

    document.addEventListener('DOMContentLoaded', () => initReviewsLoop('CustomerReviews-{{ section.id }}'));
    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        initReviewsLoop('CustomerReviews-{{ section.id }}');
      }
    });
  })();
</script>

