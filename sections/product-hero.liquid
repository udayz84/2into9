{%- liquid
  assign size_option = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size' or option_name contains 'fit'
      assign size_option = option
      break
    endif
  endfor
  unless size_option
    if product.options_with_values.size > 0
      assign size_option = product.options_with_values.first
    endif
  endunless
  assign size_index = size_option.position | minus: 1
-%}

{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

<product-hero
  class="ph"
  style="--ph-padding-inline: {{ section.settings.page_padding }}px;"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
>
  {%- if section.settings.bg_text != blank -%}
    <span class="ph__bg-text" aria-hidden="true">{{ section.settings.bg_text }}</span>
  {%- endif -%}

  <div class="ph__grid">
    <div class="ph__gallery-col sticky-content sticky-content--desktop">
      <div class="ph-gallery" data-gallery>
        {%- if section.settings.show_rating -%}
          <a
            class="ph-gallery__rating"
            {% if section.settings.reviews_url != blank %}
              href="{{ section.settings.reviews_url }}"
            {% endif %}
            aria-label="Rated {{ section.settings.rating }} out of 5"
          >
            {%- for i in (1..5) -%}
              {%- assign fill_pct = section.settings.rating | minus: i | plus: 1 | times: 100 | at_least: 0 | at_most: 100 -%}
              <span class="ph-star" aria-hidden="true">
                {%- render 'icon-star' -%}
                {%- if fill_pct > 0 -%}
                  <span class="ph-star__fill" style="width: {{ fill_pct }}%;">{%- render 'icon-star-gold' -%}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </a>
        {%- endif -%}

        <div class="ph-gallery__stage">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div
                class="ph-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-slide
                {% if media.variant_ids.size > 0 %}
                  data-variant-image="{{ media.variant_ids | join: ',' }}"
                {% endif %}
              >
                {%- assign media_loading = 'lazy' -%}
                {%- if forloop.first -%}
                  {%- assign media_loading = 'eager' -%}
                {%- endif -%}
                {{
                  media
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ph-gallery__image',
                    widths: '490, 740, 980, 1200',
                    sizes: '490px',
                    loading: media_loading,
                    alt: media.alt | escape
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ph-gallery__slide is-active" data-slide>
              {{ 'product-1' | placeholder_svg_tag: 'ph-gallery__image ph-gallery__image--placeholder' }}
            </div>
          {%- endif -%}
        </div>

        <span class="ph-gallery__shadow" aria-hidden="true"></span>

        {%- if product.media.size > 1 -%}
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--prev"
            data-gallery-prev
            aria-label="Previous image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11.5 4 6.5 9l5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--next"
            data-gallery-next
            aria-label="Next image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.5 4l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    <div class="ph__buy-col">
      {%- assign has_bundles = false -%}
      {%- assign low_as = blank -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
          {%- assign has_bundles = true -%}
          {%- if low_as == blank -%}
            {%- assign low_as = block.settings.price_each -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="ph-title">
        {%- if product.type != blank -%}
          <span class="ph-title__eyebrow">{{ product.type }}</span>
        {%- endif -%}
        <h1 class="ph-title__heading">{{ product.title }}</h1>
        <p class="ph-title__price" data-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>
        {%- if has_bundles and low_as != blank -%}
          <p class="ph-title__low-as">Low as {{ low_as }} with packs</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="ph-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div
                class="ph-tile{% if block.settings.highlight %} ph-tile--highlight{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="ph-tile__icon">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 80
                      | image_tag:
                        class: 'ph-tile__icon-img',
                        alt: block.settings.label,
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'ruler' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2.6" y="8.6" width="18.8" height="6.8" rx="1.2" transform="rotate(-20 12 12)"/><path d="M7.2 12.4l.8-1.9M10.8 11.1l.8-1.9M14.4 9.8l.8-1.9" stroke-linecap="round"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3l7 2.8v5.4c0 4.5-3 8.2-7 9.8-4-1.6-7-5.3-7-9.8V5.8L12 3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.4 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'leaf' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20c0-8 4-14 16-16 0 12-6 16-12 16" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20C7 14 11 10.5 16 8.5" stroke-linecap="round"/></svg>
                      {%- when 'sweat' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3.5s5.5 6.3 5.5 10a5.5 5.5 0 1 1-11 0c0-3.7 5.5-10 5.5-10z" stroke-linejoin="round"/><path d="M4 6.5h2M3 10h1.5M20 6.5h-2M21 10h-1.5" stroke-linecap="round"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <span class="ph-tile__label">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_bundles -%}
        <div class="ph-step">
          <span class="ph-step__label">Select your quantity</span>
          <div class="ph-bundles" role="radiogroup" aria-label="Quantity bundle">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bundle' -%}
                {%- liquid
                  assign qty_digits = block.settings.pairs | replace: ' Pairs', '' | replace: ' Pair', '' | replace: ' pairs', '' | replace: ' pair', ''
                  assign qty = qty_digits | plus: 0
                -%}
                <label
                  class="ph-bundle{% if block.settings.selected %} is-selected{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <input
                    type="radio"
                    name="ph-bundle-{{ section.id }}"
                    class="ph-bundle__input"
                    data-qty="{{ qty }}"
                    data-price-each="{{ block.settings.price_each | escape }}"
                    {% if block.settings.selected %}checked{% endif %}
                  >
                  {%- if block.settings.top_badge != blank -%}
                    <span class="ph-bundle__badge ph-bundle__badge--top">{{ block.settings.top_badge }}</span>
                  {%- endif -%}
                  <span class="ph-bundle__pairs">{{ block.settings.pairs }}</span>
                  <span class="ph-bundle__price">{{ block.settings.price_each }}</span>
                  {%- if block.settings.discount_badge != blank -%}
                    <span class="ph-bundle__badge ph-bundle__badge--discount">{{ block.settings.discount_badge }}</span>
                  {%- endif -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="ph-actions">
        <a class="ph-actions__btn ph-actions__btn--outline" href="#" data-scroll-to-builder>Build a custom bundle 📦</a>
        {%- if section.settings.find_fit_url != blank -%}
          <a class="ph-actions__btn ph-actions__btn--solid" href="{{ section.settings.find_fit_url }}">Find my fit 📏</a>
        {%- endif -%}
      </div>

      {%- if size_option -%}
        <div class="ph-step">
          <div class="ph-step__header">
            <span class="ph-step__label">Select your fit</span>
          </div>
          <div class="ph-sizes" role="radiogroup" aria-label="{{ size_option.name }}">
            {%- for value in size_option.values -%}
              {%- liquid
                assign display_value = value | split: ' ' | first
                assign matching_variant = null
                for variant in product.variants
                  if variant.options[size_index] == value
                    assign matching_variant = variant
                    break
                  endif
                endfor
              -%}
              <label
                class="ph-size{% if matching_variant == product.selected_or_first_available_variant %} is-selected{% endif %}{% if matching_variant.available == false %} is-unavailable{% endif %}"
                title="{{ value | escape }}"
              >
                <input
                  type="radio"
                  name="ph-size-{{ section.id }}"
                  value="{{ value | escape }}"
                  {% if matching_variant %}data-variant-id="{{ matching_variant.id }}"{% endif %}
                  {% if matching_variant %}
                    data-price="{{ matching_variant.price | money }}"
                  {% else %}
                    data-price="{{ product.selected_or_first_available_variant.price | money }}"
                  {% endif %}
                  {% if matching_variant and matching_variant.featured_image %}
                    data-variant-image-id="{{ matching_variant.featured_image.id }}"
                  {% endif %}
                  {% if matching_variant == product.selected_or_first_available_variant %}checked{% endif %}
                  {% if matching_variant.available == false %}disabled{% endif %}
                >
                <span>{{ display_value }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign acc_first = true -%}
      {%- assign has_acc = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion_item' -%}
          {%- assign has_acc = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_acc -%}
      <div class="ph-step">
        <span class="ph-step__label">Product details</span>
        <product-accordion class="ph-acc">
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion_item' -%}
          <div
            class="ph-acc__item{% if acc_first %} is-open{% endif %}"
            data-accordion-item
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="ph-acc__header"
              data-accordion-trigger
              aria-expanded="{% if acc_first %}true{% else %}false{% endif %}"
            >
              <span class="ph-acc__title">{{ block.settings.title }}</span>
              <span class="ph-acc__icon" aria-hidden="true">
                <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 5.5l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
            <div class="ph-acc__content" data-accordion-content{% unless acc_first %} hidden{% endunless %}>
              <div class="ph-acc__body">
                {%- if block.settings.use_product_description -%}
                  {{ product.description }}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </div>
          </div>
          {%- assign acc_first = false -%}
          {%- endif -%}
        {%- endfor -%}
        </product-accordion>
      </div>
      {%- endif -%}
    </div>
  </div>
</product-hero>

<script src="{{ 'product-hero.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "class": "section-ph",
  "settings": [
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background text",
      "default": "underwear"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating on gallery",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 3,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "Reviews link"
    },
    {
      "type": "header",
      "content": "Find my Fit"
    },
    {
      "type": "text",
      "id": "find_fit_text",
      "label": "Link text",
      "default": "Find my Fit"
    },
    {
      "type": "url",
      "id": "find_fit_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature tile",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Anti-Chafe"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ruler", "label": "Ruler" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sweat", "label": "Sweat" },
            { "value": "default", "label": "Circle" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Dark highlight style",
          "default": false
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Quantity bundle",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "pairs",
          "label": "Pairs label",
          "default": "15 Pairs"
        },
        {
          "type": "text",
          "id": "price_each",
          "label": "Price per pair",
          "default": "Rs 800/each"
        },
        {
          "type": "text",
          "id": "top_badge",
          "label": "Top badge",
          "info": "Leave empty for none"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount badge",
          "info": "Leave empty for none"
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description as content",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero",
      "blocks": [
        { "type": "feature", "settings": { "label": "Shorter Leg", "icon": "ruler", "highlight": true } },
        { "type": "feature", "settings": { "label": "Anti-Chafe", "icon": "shield" } },
        { "type": "feature", "settings": { "label": "Soft Bamboo Viscose", "icon": "leaf" } },
        { "type": "feature", "settings": { "label": "Anti-Sweat", "icon": "sweat" } },
        { "type": "bundle", "settings": { "pairs": "15 Pairs", "price_each": "Rs 800/each", "top_badge": "Best Value", "discount_badge": "20% OFF" } },
        { "type": "bundle", "settings": { "pairs": "15 Pairs", "price_each": "Rs 840/each", "top_badge": "Most Popular", "discount_badge": "15% OFF", "selected": true } },
        { "type": "bundle", "settings": { "pairs": "4 Pairs", "price_each": "Rs 870/each", "discount_badge": "10% OFF" } },
        { "type": "bundle", "settings": { "pairs": "1 Pair", "price_each": "Rs 929/each" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .ph,
  .ph h1,
  .ph h2,
  .ph h3,
  .ph h4,
  .ph p,
  .ph span,
  .ph button,
  .ph input,
  .ph a {
    font-family: var(--ph-font);
  }

  .ph {
    --ph-ink: #171717;
    --ph-border: #dcdcdc;
    --ph-tile-bg: #efefef;
    --ph-lime: #c5ff00;
    --ph-card-bg: rgba(217, 217, 217, 0.2);
    --ph-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    display: block;
    position: relative;
    font-family: var(--ph-font);
    color: var(--ph-ink);
    overflow-x: clip;
    overflow-y: visible;
    padding-inline: var(--ph-padding-inline, 110px);
    padding-block-start: 130px;
    padding-block-end: 10px;
  }

  .ph__bg-text {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    left: 0;
    right: 0;
    text-align: center;
    z-index: 100;
    font-weight: 800;
    font-size: clamp(100px, 15.5vw, 320px);
    line-height: 0.71;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #b5b5b5;
    opacity: 0.06;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .ph__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 64px;
    justify-content: flex-start;
    align-items: start;
    max-width: 80rem;
    margin-inline: auto;
  }

  /* Gallery */
  .ph__gallery-col {
    margin-block-start: 8px;
  }

  /* If the header is sticky, stick the gallery underneath it */
  body:has(#header-group #header-component[data-sticky-state='active']) .ph__gallery-col {
    --sticky-header-offset: var(--header-height);
  }

  .ph-gallery {
    position: relative;
    width: 100%;
    min-height: 650px;
    background: var(--ph-card-bg);
    border: 0.5px solid var(--ph-border);
    border-radius: 10px;
  }

  .ph-gallery__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 30px 60px 40px;
  }

  .ph-gallery__slide {
    grid-area: 1 / 1;
    display: none;
    width: 100%;
    height: 100%;
  }

  .ph-gallery__slide.is-active {
    display: block;
  }

  .ph-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .ph-gallery__rating {
    position: absolute;
    top: 30px;
    left: 30px;
    display: flex;
    gap: 5px;
    z-index: 2;
    text-decoration: none;
  }

  .ph-star {
    position: relative;
    width: 15px;
    height: 15px;
    color: #d9d9d9;
    display: inline-flex;
    flex: none;
  }

  .ph-star svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ph-star__fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: block;
  }

  .ph-star__fill svg {
    width: 15px;
    height: 15px;
  }

  .ph-gallery__shadow {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 14px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.12) 45%, transparent 72%);
    filter: blur(3px);
    pointer-events: none;
  }

  .ph-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.85);
    border: 0.5px solid var(--ph-border);
    color: var(--ph-ink);
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s ease;
  }

  .ph-gallery__arrow:hover {
    background: #fff;
  }

  .ph-gallery__arrow svg {
    width: 18px;
    height: 18px;
  }

  .ph-gallery__arrow--prev {
    left: 30px;
  }

  .ph-gallery__arrow--next {
    right: 30px;
  }

  /* Title + price */
  .ph-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }

  .ph-title__heading {
    margin: 0;
    font-size: 38px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ph-ink);
    text-transform: none;
  }

  .ph-title__price {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ph-ink);
  }

  .ph-title__eyebrow {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: #6b6b6b;
  }

  .ph-title__low-as {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #4a4a4a;
  }

  /* Action buttons (bundle builder / find fit) */
  .ph-actions {
    display: flex;
    gap: 10px;
    margin-block-start: 20px;
    width: 100%;
  }

  .ph-actions__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
    cursor: pointer;
  }

  .ph-actions__btn--outline {
    background: #fff;
    border: 1px solid var(--ph-ink);
    color: var(--ph-ink);
  }

  .ph-actions__btn--solid {
    background: var(--ph-ink);
    border: 1px solid var(--ph-ink);
    color: #fff;
  }

  /* Feature list (vertical, icon + label) */
  .ph-features {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-block-start: 28px;
    width: 100%;
  }

  .ph-tile {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    color: var(--ph-ink);
  }

  .ph-tile__icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .ph-tile--highlight .ph-tile__icon {
    width: 38px;
    height: 38px;
    padding: 5px;
    background: var(--ph-lime);
    border-radius: 999px;
  }

  .ph-tile__icon svg,
  .ph-tile__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ph-tile__label {
    text-align: left;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  /* Steps */
  .ph-step {
    margin-block-start: 40px;
  }

  .ph-step__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .ph-step__label {
    display: block;
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
    color: var(--ph-ink);
  }

  .ph-step__label::before {
    content: counter(ph-step) '. ';
    counter-increment: ph-step;
  }

  .ph__buy-col {
    counter-reset: ph-step;
  }

  .ph-step__aux-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 16px;
    font-weight: 400;
    color: #000;
    text-decoration: none;
  }

  .ph-step__aux-link:hover {
    text-decoration: underline;
  }

  .ph-step__aux-link svg {
    width: 10px;
    height: 10px;
  }

  /* Sizes */
  .ph-sizes {
    display: flex;
    gap: 15px;
    margin-block-start: 20px;
  }

  .ph-size {
    width: 80px;
    height: 60px;
    border: 1px solid var(--ph-border);
    border-radius: 10px;
    display: grid;
    place-items: center;
    cursor: pointer;
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 24px;
    color: var(--ph-ink);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .ph-size input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .ph-size:hover {
    border-color: var(--ph-ink);
  }

  .ph-size.is-selected {
    background: var(--ph-ink);
    border-color: var(--ph-ink);
    color: #fff;
  }

  .ph-size.is-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Bundles */
  .ph-bundles {
    display: flex;
    gap: 7px;
    align-items: flex-end;
    margin-block-start: 20px;
    padding-block-start: 15px;
  }

  .ph-bundle {
    position: relative;
    flex: 1;
    height: 140px;
    background: #fff;
    border: 1px solid var(--ph-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    padding-block-end: 26px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .ph-bundle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .ph-bundle:hover {
    border-color: var(--ph-lime);
  }

  .ph-bundle.is-selected {
    background: #fcfef4;
    border-color: var(--ph-lime);
  }

  .ph-bundle__pairs {
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }

  .ph-bundle__price {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .ph-bundle__badge {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ph-lime);
    color: #000;
    border-radius: 40px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 18px;
    white-space: nowrap;
    max-width: calc(100% - 8px);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ph-bundle__badge--top {
    top: -15px;
    padding: 5px 8px;
  }

  .ph-bundle__badge--discount {
    bottom: 13px;
    padding: 3px 8px;
  }

  /* Accordion (in buy column, under step 3 label) */
  .ph-acc {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block-start: 20px;
    width: 100%;
  }

  .ph-acc__item {
    border: 1px solid var(--ph-border);
    border-radius: 12px;
    background: #fff;
    overflow: clip;
  }

  .ph-acc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 56px;
    padding: 14px 18px;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--ph-font);
  }

  .ph-acc__title {
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
    color: var(--ph-ink);
    text-align: left;
  }

  .ph-acc__icon {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #f3f3f3;
    color: var(--ph-ink);
    display: grid;
    place-items: center;
    transition: transform 0.25s ease;
  }

  .ph-acc__icon svg {
    width: 12px;
    height: 12px;
  }

  .ph-acc__item.is-open .ph-acc__icon {
    transform: rotate(180deg);
  }

  .ph-acc__content {
    border-block-start: 1px solid var(--ph-border);
  }

  .ph-acc__body {
    padding: 16px 18px 20px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--ph-ink);
  }

  .ph-acc__body p {
    margin: 0 0 10px;
  }

  .ph-acc__body p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}
