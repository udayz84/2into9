{%- comment -%}
  Image Card Section
  Image cards with:
  - Individual background color
  - Shape overlay
  - White shape border
  - Optional link
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  id="ImageCard-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-image-card
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <style>
    #ImageCard-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px !important;
    }

    @media screen and (max-width: 749px) {
      #ImageCard-{{ section.id }} {
        margin-top: {{ section.settings.margin_top_mobile }}px !important;
      }
    }
  </style>

  <div class="image-card-container">

    {%- for block in section.blocks -%}

      <div
        class="
          image-card
          image-card--shape-{{ block.settings.shape }}
        "
        style="
          --image-card-bg: {{ block.settings.background_color }};
        "
        {{ block.shopify_attributes }}
      >

        {%- if block.settings.image != blank -%}

          {%- if block.settings.link != blank -%}

            <a
              href="{{ block.settings.link }}"
              class="image-card__link"
              {% if block.settings.open_in_new_tab %}
                target="_blank"
                rel="noopener"
              {% endif %}
            >

              <div class="image-card__image-wrap">

                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'image-card__image',
                    alt: block.settings.image_alt,
                    loading: 'lazy'
                }}

              </div>

            </a>

          {%- else -%}

            <div class="image-card__image-wrap">

              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  class: 'image-card__image',
                  alt: block.settings.image_alt,
                  loading: 'lazy'
              }}

            </div>

          {%- endif -%}

        {%- else -%}

          <div class="image-card__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>

        {%- endif -%}

      </div>

    {%- endfor -%}

  </div>
</section>


{% stylesheet %}

  /* =========================================
     SECTION
  ========================================= */

  .section-image-card {
    position: relative;
  }

  .section-image-card .section-background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base, 0);
    pointer-events: none;
  }


  /* =========================================
     GRID
  ========================================= */

  .image-card-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 0;

    width: 100%;

    position: relative;
    z-index: var(--layer-base, 0);
  }


  @media screen and (min-width: 750px) {

    .image-card-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }

  }


  /* =========================================
     CARD
  ========================================= */

  .image-card {
    position: relative;

    overflow: hidden;

    width: 100%;

    background: var(--image-card-bg, #ffffff);
  }


  /* =========================================
     LINK
  ========================================= */

  .image-card__link {
    display: block;

    width: 100%;
    height: 100%;

    text-decoration: none;
  }


  /* =========================================
     IMAGE WRAPPER
  ========================================= */

  .image-card__image-wrap {
    position: relative;

    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    box-sizing: border-box;
  }


  /* =========================================
     IMAGE
  ========================================= */

  .image-card__image {
    width: 100%;
    height: auto;

    display: block;

    object-fit: cover;

    transition: transform 0.4s ease;
  }


  /* =========================================
     NO SHAPE
  ========================================= */

  .image-card--shape-none .image-card__image-wrap {
    width: 100%;

    margin: 0;

    border: 0;

    border-radius: 0;
  }


  /* =========================================
     RECTANGLE
  ========================================= */

  .image-card--shape-rectangle {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .image-card--shape-rectangle .image-card__image-wrap {
    width: 74%;

    margin: 12% auto;

    border: 3px solid #ffffff;

    border-radius: 0;

    box-sizing: border-box;
  }

  .image-card--shape-rectangle .image-card__image {
    width: 100%;
    height: auto;

    object-fit: cover;
  }


  /* =========================================
     CIRCLE
  ========================================= */

  .image-card--shape-circle {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .image-card--shape-circle .image-card__image-wrap {
    width: 85%;

    aspect-ratio: 1 / 1;

    margin: 14% auto;

    border: 3px solid #ffffff;

    border-radius: 50%;

    box-sizing: border-box;
  }

  .image-card--shape-circle .image-card__image {
    width: 100%;
    height: 100%;

    object-fit: cover;

    border-radius: 50%;
  }


  /* =========================================
     ROUNDED
  ========================================= */

  .image-card--shape-rounded {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .image-card--shape-rounded .image-card__image-wrap {
    width: 74%;

    margin: 12% auto;

    border: 3px solid #ffffff;

    border-radius: 24px;

    box-sizing: border-box;
  }

  .image-card--shape-rounded .image-card__image {
    width: 100%;
    height: auto;

    border-radius: 20px;
  }


  /* =========================================
     OVAL
  ========================================= */

  .image-card--shape-oval {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .image-card--shape-oval .image-card__image-wrap {
    width: 76%;

    aspect-ratio: 1.25 / 1;

    margin: 14% auto;

    border: 3px solid #ffffff;

    border-radius: 50%;

    box-sizing: border-box;
  }

  .image-card--shape-oval .image-card__image {
    width: 100%;
    height: 100%;

    object-fit: cover;

    border-radius: 50%;
  }


  /* =========================================
     HOVER
  ========================================= */

  .image-card__link:hover .image-card__image {
    transform: scale(1.02);
  }

  .image-card--shape-circle .image-card__link:hover .image-card__image,
  .image-card--shape-oval .image-card__link:hover .image-card__image {
    transform: scale(1.04);
  }


  /* =========================================
     PLACEHOLDER
  ========================================= */

  .image-card__placeholder {
    width: 100%;

    aspect-ratio: 4 / 3;

    background: var(--image-card-bg, #2a2a2a);

    display: flex;

    align-items: center;
    justify-content: center;
  }

  .image-card__placeholder .placeholder-svg {
    width: 100px;
    height: 100px;

    opacity: 0.3;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    .image-card-container {
      gap: 0;
    }


    /* Rectangle */

    .image-card--shape-rectangle .image-card__image-wrap {
      width: 78%;

      margin: 11% auto;

      border-width: 2px;
    }


    /* Circle */

    .image-card--shape-circle .image-card__image-wrap {
      width: 90%;

      margin: 12% auto;

      border-width: 2px;
    }


    /* Rounded */

    .image-card--shape-rounded .image-card__image-wrap {
      width: 78%;

      margin: 11% auto;

      border-width: 2px;

      border-radius: 16px;
    }

    .image-card--shape-rounded .image-card__image {
      border-radius: 13px;
    }


    /* Oval */

    .image-card--shape-oval .image-card__image-wrap {
      width: 80%;

      margin: 12% auto;

      border-width: 2px;
    }

  }

{% endstylesheet %}


