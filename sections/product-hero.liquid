{%- liquid
  assign size_option = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size' or option_name contains 'fit'
      assign size_option = option
      break
    endif
  endfor
  unless size_option
    if product.options_with_values.size > 0
      assign size_option = product.options_with_values.first
    endif
  endunless
  assign size_index = size_option.position | minus: 1
-%}

{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

<product-hero
  class="ph"
  style="--ph-padding-inline: {{ section.settings.page_padding }}px;"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
>
  {%- if section.settings.bg_text != blank -%}
    <span class="ph__bg-text" aria-hidden="true">{{ section.settings.bg_text }}</span>
  {%- endif -%}

  <div class="ph__grid">
    <div class="ph__gallery-col">
     <div class="ph__gallery-pin">
      <div class="ph-gallery" data-gallery>
        {%- if section.settings.show_rating -%}
          <a
            class="ph-gallery__rating"
            {% if section.settings.reviews_url != blank %}
              href="{{ section.settings.reviews_url }}"
            {% endif %}
            aria-label="Rated {{ section.settings.rating }} out of 5"
          >
            {%- for i in (1..5) -%}
              {%- assign fill_pct = section.settings.rating | minus: i | plus: 1 | times: 100 | at_least: 0 | at_most: 100 -%}
              <span class="ph-star" aria-hidden="true">
                {%- render 'icon-star' -%}
                {%- if fill_pct > 0 -%}
                  <span class="ph-star__fill" style="width: {{ fill_pct }}%;">{%- render 'icon-star-gold' -%}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </a>
        {%- endif -%}

        <div class="ph-gallery__stage">
          {%- if product.media.size > 0 -%}
            {% comment %} {%- for media in product.media -%}
              <div
                class="ph-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-slide
                {% if media.variant_ids.size > 0 %}
                  data-variant-image="{{ media.variant_ids | join: ',' }}"
                {% endif %}
              >
                {%- assign media_loading = 'lazy' -%}
                {%- if forloop.first -%}
                  {%- assign media_loading = 'eager' -%}
                {%- endif -%}
                {{
                  media
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ph-gallery__image',
                    widths: '490, 740, 980, 1200',
                    sizes: '490px',
                    loading: media_loading,
                    alt: media.alt | escape
                }}
              </div>
            {%- endfor -%} {% endcomment %}

            {%- for media in product.media -%}

  <div
    class="ph-gallery__slide{% if forloop.first %} is-active{% endif %}"
    data-slide
    data-media-type="{{ media.media_type }}"
    data-media-id="{{ media.id }}"
    {% if media.variant_ids.size > 0 %}
      data-variant-image="{{ media.variant_ids | join: ',' }}"
    {% endif %}
  >

    {%- case media.media_type -%}

      {%- when 'image' -%}

        {%- assign media_loading = 'lazy' -%}
        {%- if forloop.first -%}
          {%- assign media_loading = 'eager' -%}
        {%- endif -%}

        {{
          media
          | image_url: width: 2400
          | image_tag:
            class: 'ph-gallery__image',
            widths: '490, 740, 980, 1200',
            sizes: '1200px',
            loading: media_loading,
            alt: media.alt | escape
        }}

      {%- when 'video' -%}

        {{
          media
          | video_tag:
            class: 'ph-gallery__video',
            controls: true,
            autoplay: false,
            loop: false,
            muted: true,
            playsinline: true,
            image_size: '1200x'
        }}

      {%- when 'external_video' -%}

        <div class="ph-gallery__external-video">
          {{ media | external_video_tag }}
        </div>

      {%- when 'model' -%}

        {{ media | model_viewer_tag }}

    {%- endcase -%}

  </div>

{%- endfor -%}
          {%- else -%}
            <div class="ph-gallery__slide is-active" data-slide>
              {{ 'product-1' | placeholder_svg_tag: 'ph-gallery__image ph-gallery__image--placeholder' }}
            </div>
          {%- endif -%}
        </div>

        <span class="ph-gallery__shadow" aria-hidden="true"></span>

        {%- if product.media.size > 1 -%}
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--prev"
            data-gallery-prev
            aria-label="Previous image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11.5 4 6.5 9l5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--next"
            data-gallery-next
            aria-label="Next image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.5 4l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="ph-thumbs" data-thumbs>
          {%- for media in product.media -%}
            <button
              type="button"
              class="ph-thumb{% if forloop.first %} is-active{% endif %}"
              data-thumb-index="{{ forloop.index0 }}"
              aria-label="Show image {{ forloop.index }}"
            >
              {{
                media
                | image_url: width: 200
                | image_tag:
                  class: 'ph-thumb__image',
                  widths: '200, 164',
                  sizes: '200px',
                  loading: 'lazy',
                  alt: media.alt | escape
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
     </div>
    </div>

    <div class="ph__buy-col">
      <div class="ph-title">
        <h1 class="ph-title__heading">{{ product.title }}</h1>
        <p class="ph-title__price" data-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="ph-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div
                class="ph-tile{% if block.settings.highlight %} ph-tile--highlight{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="ph-tile__icon">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 80
                      | image_tag:
                        class: 'ph-tile__icon-img',
                        alt: block.settings.label,
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'ruler' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2.6" y="8.6" width="18.8" height="6.8" rx="1.2" transform="rotate(-20 12 12)"/><path d="M7.2 12.4l.8-1.9M10.8 11.1l.8-1.9M14.4 9.8l.8-1.9" stroke-linecap="round"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3l7 2.8v5.4c0 4.5-3 8.2-7 9.8-4-1.6-7-5.3-7-9.8V5.8L12 3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.4 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'leaf' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20c0-8 4-14 16-16 0 12-6 16-12 16" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20C7 14 11 10.5 16 8.5" stroke-linecap="round"/></svg>
                      {%- when 'sweat' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3.5s5.5 6.3 5.5 10a5.5 5.5 0 1 1-11 0c0-3.7 5.5-10 5.5-10z" stroke-linejoin="round"/><path d="M4 6.5h2M3 10h1.5M20 6.5h-2M21 10h-1.5" stroke-linecap="round"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <span class="ph-tile__label">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if size_option -%}
        <div class="ph-step">
          <div class="ph-step__header">
            <span class="ph-step__label">Select your fit</span>
            {%- if section.settings.find_fit_url != blank -%}
              <a class="ph-step__aux-link" href="{{ section.settings.find_fit_url }}">
                <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1"><rect x="1" y="3.4" width="8" height="3.2" rx="0.6" transform="rotate(-20 5 5)"/><path d="M3 5.4l.4-.9M5 4.7l.4-.9M7 4l.4-.9" stroke-linecap="round"/></svg>
                {{ section.settings.find_fit_text }}
              </a>
            {%- endif -%}
          </div>
          <div class="ph-sizes" role="radiogroup" aria-label="{{ size_option.name }}">
            {%- for value in size_option.values -%}
              {%- liquid
                assign display_value = value | split: ' ' | first
                assign matching_variant = null
                for variant in product.variants
                  if variant.options[size_index] == value
                    assign matching_variant = variant
                    break
                  endif
                endfor
              -%}
              <label
                class="ph-size{% if matching_variant == product.selected_or_first_available_variant %} is-selected{% endif %}{% if matching_variant.available == false %} is-unavailable{% endif %}"
                title="{{ value | escape }}"
              >
                <input
                  type="radio"
                  name="ph-size-{{ section.id }}"
                  value="{{ value | escape }}"
                  {% if matching_variant %}data-variant-id="{{ matching_variant.id }}"{% endif %}
                  {% if matching_variant %}
                    data-price="{{ matching_variant.price | money }}"
                  {% else %}
                    data-price="{{ product.selected_or_first_available_variant.price | money }}"
                  {% endif %}
                  {% if matching_variant and matching_variant.featured_image %}
                    data-variant-image-id="{{ matching_variant.featured_image.id }}"
                  {% endif %}
                  {% if matching_variant == product.selected_or_first_available_variant %}checked{% endif %}
                  {% if matching_variant.available == false %}disabled{% endif %}
                >
                <span>{{ display_value }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign has_bundles = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
          {%- assign has_bundles = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_bundles -%}
        <div
          class="ph-step ph-step--quantity"
          data-bundle-selector
          data-product-id="{{ product.id }}"
          data-section-id="{{ section.id }}"
        >
          <span class="ph-step__label">Select your quantity</span>

          <div
            class="ph-bundles"
            role="radiogroup"
            aria-label="Select your quantity"
          >
            {%- for block in section.blocks -%}
              {%- if block.type == 'bundle' -%}
                {%- liquid
                  assign qty_digits = block.settings.pairs | replace: ' Pairs', '' | replace: ' Pair', '' | replace: ' pairs', '' | replace: ' pair', '' | strip
                  assign qty = qty_digits | plus: 0
                  if qty == 0
                    assign qty = 1
                  endif
                -%}
                <label
                  class="ph-bundle{% if block.settings.selected %} is-selected{% endif %}"
                  data-bundle-option
                  data-quantity="{{ qty }}"
                  {{ block.shopify_attributes }}
                >
                  <input
                    type="radio"
                    class="ph-bundle__input"
                    name="bundle-quantity-{{ section.id }}"
                    value="{{ qty }}"
                    data-qty="{{ qty }}"
                    data-price-each="{{ block.settings.price_each | escape }}"
                    data-discount="{{ block.settings.discount_badge | escape }}"
                    {% if block.settings.selected %}
                      checked
                    {% endif %}
                  >

                  {%- if block.settings.top_badge != blank -%}
                    <span class="ph-bundle__badge ph-bundle__badge--top">{{ block.settings.top_badge }}</span>
                  {%- endif -%}

                  <span class="ph-bundle__pairs">
                    {{ block.settings.pairs }}
                  </span>

                  {%- if block.settings.price_each != blank -%}
                    <span class="ph-bundle__price" data-bundle-price>
                      {{ block.settings.price_each }}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.discount_badge != blank -%}
                    <span class="ph-bundle__badge ph-bundle__badge--discount" data-bundle-discount>
                      {{ block.settings.discount_badge }}
                    </span>
                  {%- endif -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {% render 'product-colour-builder', product: product, section: section %}
    </div>
  </div>
</product-hero>

<script src="{{ 'product-hero.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "class": "section-ph",
  "settings": [
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background text",
      "default": "underwear"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating on gallery",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 3,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "Reviews link"
    },
    {
      "type": "header",
      "content": "Find my Fit"
    },
    {
      "type": "text",
      "id": "find_fit_text",
      "label": "Link text",
      "default": "Find my Fit"
    },
    {
      "type": "url",
      "id": "find_fit_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Colour Builder"
    },
    {
      "type": "text",
      "id": "single_label",
      "label": "Single colour tab label",
      "default": "Single Colour"
    },
    {
      "type": "text",
      "id": "mixed_label",
      "label": "Mixed colours tab label",
      "default": "Mixed Colours"
    },
    {
      "type": "text",
      "id": "selected_label",
      "label": "Selected filter label",
      "default": "Selected"
    },
    {
      "type": "text",
      "id": "grid_view_label",
      "label": "Grid view filter label",
      "default": "Grid View"
    },
    {
      "type": "text",
      "id": "progress_label",
      "label": "Progress label",
      "default": "Select your items"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show bottom divider",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature tile",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Anti-Chafe"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ruler", "label": "Ruler" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sweat", "label": "Sweat" },
            { "value": "default", "label": "Circle" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Dark highlight style",
          "default": false
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Quantity bundle",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "pairs",
          "label": "Pairs label",
          "default": "15 Pairs"
        },
        {
          "type": "text",
          "id": "price_each",
          "label": "Price per pair",
          "default": "Rs 800/each"
        },
        {
          "type": "text",
          "id": "top_badge",
          "label": "Top badge",
          "info": "Leave empty for none"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount badge",
          "info": "Leave empty for none"
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero",
      "blocks": [
        { "type": "feature", "settings": { "label": "Shorter Leg", "icon": "ruler", "highlight": true } },
        { "type": "feature", "settings": { "label": "Anti-Chafe", "icon": "shield" } },
        { "type": "feature", "settings": { "label": "Soft Bamboo Viscose", "icon": "leaf" } },
        { "type": "feature", "settings": { "label": "Anti-Sweat", "icon": "sweat" } },
        { "type": "bundle", "settings": { "pairs": "15 Pairs", "price_each": "Rs 800/each", "top_badge": "Best Value", "discount_badge": "20% OFF" } },
        { "type": "bundle", "settings": { "pairs": "15 Pairs", "price_each": "Rs 840/each", "top_badge": "Most Popular", "discount_badge": "15% OFF", "selected": true } },
        { "type": "bundle", "settings": { "pairs": "4 Pairs", "price_each": "Rs 870/each", "discount_badge": "10% OFF" } },
        { "type": "bundle", "settings": { "pairs": "1 Pair", "price_each": "Rs 929/each" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .ph,
  .ph h1,
  .ph h2,
  .ph h3,
  .ph h4,
  .ph p,
  .ph span,
  .ph button,
  .ph input,
  .ph a {
    font-family: var(--ph-font);
  }

  .ph {
    --ph-ink: #171717;
    --ph-border: #dcdcdc;
    --ph-tile-bg: #efefef;
    --ph-lime: #c5ff00;
    --ph-card-bg: rgba(217, 217, 217, 0.2);
    --ph-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    display: block;
    position: relative;
    font-family: var(--ph-font);
    color: var(--ph-ink);
    overflow-x: clip;
    overflow-y: visible;
    padding-inline: clamp(20px, 4vw, var(--ph-padding-inline, 60px));
    padding-block-start: 16px;
    padding-block-end: 0px;
  }

  .ph__bg-text {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    left: 0;
    right: 0;
    text-align: center;
    z-index: 100;
    font-weight: 800;
    font-size: clamp(100px, 15.5vw, 320px);
    line-height: 0.71;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #b5b5b5;
    opacity: 0.06;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .ph__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    justify-content: flex-start;
    align-items: start;
    max-width: 1240px;
    margin-inline: auto;
  }

  /* Gallery */
  .ph__gallery-col {
    margin-block-start: 0;
    max-width: 100%;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .ph__gallery-col {
      position: sticky;
      top: 16px;
      align-self: start;
    }
  }

  .ph-gallery {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--ph-card-bg);
    border: 0.5px solid var(--ph-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .ph-gallery__stage {
    /* position: absolute; */
    position: relative;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
  }

  .ph-gallery__slide {
    grid-area: 1 / 1;
    display: none;
    width: 100%;
    height: 100%;
  }

  .ph-gallery__slide.is-active {
    display: block;
  }

  .ph-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .ph-gallery__video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #000;
}

.ph-gallery__external-video {
  width: 100%;
  height: 100%;
}

.ph-gallery__external-video iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

  .ph-gallery__rating {
    position: absolute;
    top: 30px;
    left: 30px;
    display: flex;
    gap: 5px;
    z-index: 2;
    text-decoration: none;
  }

  .ph-star {
    position: relative;
    width: 15px;
    height: 15px;
    color: #d9d9d9;
    display: inline-flex;
    flex: none;
  }

  .ph-star svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ph-star__fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: block;
  }

  .ph-star__fill svg {
    width: 15px;
    height: 15px;
  }

  .ph-gallery__shadow {
    display: none;
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 14px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.12) 45%, transparent 72%);
    filter: blur(3px);
    pointer-events: none;
  }

  .ph-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.85);
    border: 0.5px solid var(--ph-border);
    color: var(--ph-ink);
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s ease;
  }

  .ph-gallery__arrow:hover {
    background: #fff;
  }

  .ph-gallery__arrow svg {
    width: 18px;
    height: 18px;
  }

  .ph-gallery__arrow--prev {
    left: 30px;
  }

  .ph-gallery__arrow--next {
    right: 30px;
  }

  /* Thumbnail grid under the main image */
  .ph-thumbs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-block-start: 12px;
    width: 100%;
  }

  .ph-thumb {
    padding: 0;
    border: 1px solid var(--ph-border);
    border-radius: 8px;
    overflow: clip;
    cursor: pointer;
    background: var(--ph-card-bg);
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }

  .ph-thumb.is-active {
    border: 2px solid var(--ph-ink);
  }

  .ph-thumb__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Title + price */
  .ph-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .ph-title__heading {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ph-ink);
    text-transform: none;
  }

  .ph-title__price {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ph-ink);
  }

  /* Feature tiles */
  .ph-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-block-start: 14px;
    width: 100%;
  }

  @media (min-width: 500px) {
    .ph-features {
      gap: 8px;
    }
  }

  @media (min-width: 768px) {
    .ph-features {
      gap: 10px;
      margin-block-start: 16px;
    }
  }

  .ph-tile {
    position: relative;
    width: 100%;
    min-height: 60px;
    padding: 8px 4px;
    border-radius: 8px;
    background: var(--ph-tile-bg);
    color: var(--ph-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  @media (min-width: 768px) {
    .ph-tile {
      min-height: 64px;
      padding: 8px 6px;
      border-radius: 8px;
      gap: 6px;
    }
  }

  .ph-tile--highlight {
    background: var(--ph-ink);
    color: #fff;
  }

  .ph-tile__icon {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .ph-tile__icon {
      width: 26px;
      height: 26px;
    }
  }

  .ph-tile__icon svg,
  .ph-tile__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ph-tile__label {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (min-width: 500px) {
    .ph-tile__label {
      font-size: 11.5px;
    }
  }

  @media (min-width: 768px) {
    .ph-tile__label {
      font-size: 11.5px;
    }
  }

  /* Steps */
  .ph-step {
    margin-block-start: 16px;
  }

  .ph-step__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .ph-step__label {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ph-ink);
  }

  .ph-step__label::before {
    content: counter(ph-step) '. ';
    counter-increment: ph-step;
  }

  .ph__buy-col {
    counter-reset: ph-step;
  }

  .ph-step__aux-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 400;
    color: #000;
    text-decoration: none;
  }

  .ph-step__aux-link:hover {
    text-decoration: underline;
  }

  .ph-step__aux-link svg {
    width: 10px;
    height: 10px;
  }

  /* Sizes */
  .ph-sizes {
    display: flex;
    gap: 8px;
    margin-block-start: 8px;
  }

  .ph-size {
    width: 58px;
    height: 38px;
    border: 1px solid var(--ph-border);
    border-radius: 6px;
    display: grid;
    place-items: center;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ph-ink);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .ph-size input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .ph-size:hover {
    border-color: var(--ph-ink);
  }

  .ph-size.is-selected {
    background: var(--ph-ink);
    border-color: var(--ph-ink);
    color: #fff;
  }

  .ph-size.is-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Bundles */
  .ph-bundles {
    display: flex;
    gap: 6px;
    align-items: flex-end;
    margin-block-start: 10px;
    padding-block-start: 12px;
  }

  .ph-bundle {
    position: relative;
    flex: 1;
    height: 84px;
    background: #fff;
    border: 1px solid var(--ph-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
    padding-block-end: 14px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .ph-bundle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .ph-bundle:hover {
    border-color: var(--ph-lime);
  }

  .ph-bundle.is-selected {
    background: #fcfef4;
    border-color: var(--ph-lime);
  }

  .ph-bundle__pairs {
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
  }

  .ph-bundle__price {
    font-size: 12.5px;
    font-weight: 700;
    line-height: 16px;
  }

  .ph-bundle__badge {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ph-lime);
    color: #000;
    border-radius: 40px;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 14px;
    white-space: nowrap;
  }

  .ph-bundle__badge--top {
    top: -11px;
    padding: 2px 10px;
  }

  .ph-bundle__badge--discount {
    bottom: 6px;
    padding: 2px 10px;
    background: #000;
    color: #fff;
  }

  /* =========================================================
   * PRODUCT COLOUR BUILDER (Step 3 + ATC)
   * ========================================================= */
  .pcb {
    --pcb-ink: #171717;
    --pcb-border: #dcdcdc;
    --pcb-lime: #c5ff00;
    --pcb-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    display: block;
    font-family: var(--pcb-font);
    color: var(--pcb-ink);
    margin-block-start: 16px;
    padding: 0;
  }

  .pcb,
  .pcb h1,
  .pcb h2,
  .pcb h3,
  .pcb h4,
  .pcb p,
  .pcb span,
  .pcb button,
  .pcb input,
  .pcb a {
    font-family: var(--pcb-font);
  }

  .pcb__buy-col {
    display: block;
    width: 100%;
  }

  .pcb__label {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--pcb-ink);
  }

  .pcb__label--step::before {
    content: counter(ph-step) '. ';
    counter-increment: ph-step;
  }

  /* Toggle */
  .pcb-toggle {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 40px;
    margin-block-start: 10px;
    border: 1px solid var(--pcb-border);
    border-radius: 10px;
    background: #fff;
  }

  .pcb-toggle__indicator {
    position: absolute;
    top: -1px;
    left: 0;
    width: calc(50% + 1px);
    height: calc(100% + 2px);
    background: var(--pcb-ink);
    border-radius: 10px;
    transition: transform 0.25s ease;
  }

  .pcb-toggle[data-active='mixed'] .pcb-toggle__indicator {
    transform: translateX(100%);
  }

  .pcb-toggle__option {
    position: relative;
    z-index: 1;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--pcb-font);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--pcb-ink);
    transition: color 0.25s ease;
  }

  .pcb-toggle__option.is-active {
    color: #fff;
  }

  /* Pills */
  .pcb-controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-block-start: 10px;
  }

  .pcb-pill {
    height: 34px;
    padding-inline: 20px;
    border-radius: 20px;
    border: 1px solid var(--pcb-border);
    background: #fff;
    font-family: var(--pcb-font);
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--pcb-ink);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .pcb-pill.is-active {
    background: var(--pcb-ink);
    border-color: var(--pcb-ink);
    color: #fff;
  }

  /* Grid */
  .pcb-grid-wrap {
    position: relative;
    margin-block-start: 10px;
  }

  .pcb-grid {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block-end: 2px;
  }

  .pcb-grid::-webkit-scrollbar {
    display: none;
  }

  .pcb-tile {
    flex: none;
    width: 72px;
    scroll-snap-align: start;
  }

  .pcb-tile.is-hidden {
    display: none;
  }

  .pcb-tile__card {
    width: 72px;
    height: 78px;
    border: 1px solid var(--pcb-border);
    border-radius: 8px;
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .pcb-tile__card:hover,
  .pcb-tile.is-selected .pcb-tile__card {
    border-color: var(--pcb-ink);
  }

  .pcb-tile__image {
    width: 48px;
    height: 52px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .pcb-tile__stepper {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 72px;
    margin-block-start: 6px;
    border: 0.5px solid var(--pcb-border);
    border-radius: 6px;
    background: #fff;
  }

  .pcb-tile__step-btn {
    border: 0;
    background: none;
    font-family: var(--pcb-font);
    font-size: 11px;
    font-weight: 600;
    color: var(--pcb-ink);
    cursor: pointer;
    padding: 3px 2px;
    line-height: 1;
  }

  .pcb-tile__step-btn:hover {
    color: #000;
  }

  .pcb-tile__count {
    font-size: 11px;
    font-weight: 600;
    color: var(--pcb-ink);
    min-width: 14px;
    text-align: center;
  }

  /* Grid arrows */
  .pcb-grid-arrow {
    position: absolute;
    top: 24px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.9);
    border: 0.5px solid var(--pcb-border);
    color: var(--pcb-ink);
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s ease;
  }

  .pcb-grid-arrow:hover {
    background: #fff;
  }

  .pcb-grid-arrow svg {
    width: 14px;
    height: 14px;
  }

  .pcb-grid-arrow--prev {
    left: -14px;
  }

  .pcb-grid-arrow--next {
    right: -14px;
  }

  /* Progress */
  .pcb-progress {
    margin-block-start: 12px;
  }

  .pcb-progress__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-block-end: 4px;
  }

  .pcb-progress__label,
  .pcb-progress__counter {
    font-size: 12.5px;
    font-weight: 500;
    color: #000;
  }

  .pcb-progress__track {
    width: 100%;
    height: 6px;
    border-radius: 10px;
    background: #d9d9d9;
    overflow: hidden;
  }

  .pcb-progress__fill {
    width: 12.7%;
    height: 100%;
    border-radius: 10px;
    background: var(--pcb-ink);
    transition: width 0.3s ease;
  }

  /* Single mode hides stepper and progress */
  product-colour-builder[data-mode="single"] .pcb-progress,
  product-colour-builder[data-mode="single"] .pcb-tile__stepper {
    display: none !important;
  }

  /* ATC row */
  .pcb-atc {
    display: flex;
    gap: 10px;
    margin-block-start: 14px;
  }

  .pcb-quantity {
    display: grid;
    grid-template-columns: 36px 1fr 36px;
    align-items: center;
    width: 120px;
    height: 44px;
    border: 1px solid var(--pcb-border);
    border-radius: 10px;
    background: #fff;
  }

  .pcb-quantity__btn {
    border: 0;
    background: none;
    font-family: var(--pcb-font);
    font-size: 18px;
    font-weight: 600;
    color: var(--pcb-ink);
    cursor: pointer;
    height: 100%;
    line-height: 1;
  }

  .pcb-quantity__btn:hover {
    color: #000;
  }

  .pcb-quantity__value {
    font-size: 16px;
    font-weight: 600;
    color: var(--pcb-ink);
    text-align: center;
  }

  .pcb-atc__btn {
    flex: 1;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: var(--pcb-ink);
    color: #fff;
    font-family: var(--pcb-font);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .pcb-atc__btn:hover {
    opacity: 0.9;
  }

  .pcb-atc__btn.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .pcb__divider {
    border: 0;
    height: 1px;
    background: var(--pcb-border);
    margin: 16px 0 0;
  }

  /* ---- Mobile: structure ≤1023px, sizing ≤749px. Desktop untouched. ---- */
  @media (max-width: 1023px) {
    .ph {
      padding-inline: 20px;
      padding-block-start: 20px;
    }

    .ph__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    .ph-bundles {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      width: 100%;
    }
  }

  @media (max-width: 749px) {
    .ph__bg-text {
      font-size: clamp(56px, 15.5vw, 320px);
    }

    .ph-gallery {
      min-height: 0;
      aspect-ratio: 1 / 1;
      height: 100%;
    }

    .ph-gallery__stage {
      padding: 0;
    }

    .ph-gallery__arrow {
      width: 32px;
      height: 32px;
    }

    .ph-gallery__arrow--prev {
      left: 8px;
    }

    .ph-gallery__arrow--next {
      right: 8px;
    }

    .ph-title__heading {
      font-size: 22px;
    }

    .ph-title__price {
      font-size: 16px;
    }

    .ph-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }

    .ph-step {
      margin-block-start: 14px;
    }

    .ph-features + .ph-step {
      margin-block-start: 10px;
    }

    .ph-step__label {
      font-size: 13.5px;
    }

    .ph-sizes {
      flex-wrap: wrap;
      gap: 6px;
    }

    .ph-size {
      width: 52px;
      height: 36px;
      font-size: 12.5px;
    }

    .ph-bundle {
      height: auto;
      min-height: 78px;
      padding-block-end: 12px;
    }

    .pcb-toggle {
      height: 40px;
    }

    .pcb-toggle__option {
      font-size: 13.5px;
    }

    .pcb-pill {
      height: 32px;
      padding-inline: 16px;
      font-size: 11px;
    }

    .pcb-atc {
      gap: 8px;
    }

    .pcb-quantity {
      width: 110px;
      height: 42px;
      grid-template-columns: 32px 1fr 32px;
    }

    .pcb-quantity__btn {
      font-size: 16px;
    }

    .pcb-quantity__value {
      font-size: 15px;
    }

    .pcb-atc__btn {
      height: 42px;
      font-size: 13px;
    }
  }
{% endstylesheet %}
