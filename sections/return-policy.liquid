      "default": "scheme-7"
    }
  ],
  "blocks": [
    {
      "type": "intro_paragraph",
      "name": "Intro paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Paragraph text",
          "default": "<p>If you are at this page, then either you are considering buying 2 INTO 9 (thank you!!) or are displeased for some reason (let us fix it). If you are unhappy for ANY reason, we ask that you give us the opportunity to make things right. Please email our satisfaction-guaranteed customer service center at care@2into9.com regarding any issues with your purchase.</p>"
        }
      ]
    },
    {
      "type": "policy_section",
      "name": "Policy section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Section heading",
          "default": "RETURNS / REFUNDS ON ORDERS THAT QUALIFIED FOR FREE SHIPPING"
        },
        {
          "type": "richtext",
