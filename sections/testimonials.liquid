    echo '<path d="M2.0316 7.3216L6.4704 6.6875C6.5947 6.6697 6.6442 6.8429 6.5292 6.8931C5.632 7.2845 3.7915 7.9646 1.0412 8.3988C1.0412 8.3988 1.0412 8.3618 1.0497 8.2995C1.1189 7.7913 1.5238 7.3941 2.0316 7.3216Z" fill="#FFE36C"/>'
