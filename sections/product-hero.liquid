{%- liquid
  assign size_option = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size' or option_name contains 'fit'
      assign size_option = option
      break
    endif
  endfor
  unless size_option
    if product.options_with_values.size > 0
      assign size_option = product.options_with_values.first
    endif
  endunless
  assign size_index = size_option.position | minus: 1
-%}

{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

{% style %}
  /* Normal spacing under the floating transparent header.
     The theme's global rule adds header-group-height + header-height + 24px
     (double-counting the announcement bar), leaving a large empty gap at the
     top of the product page. Keep a clean ~28px gap below the header instead.
     Rendered inline (not compiled into styles.css) so it always applies. */
  body:has(.header[transparent]) #shopify-section-{{ section.id }} {
    padding-block-start: calc(var(--header-height, 70px) + 70px) !important;
  }

  @media (max-width: 749px) {
    body:has(.header[transparent]) #shopify-section-{{ section.id }} {
      padding-block-start: calc(var(--header-height, 70px) + 20px) !important;
    }
  }
{% endstyle %}

<product-hero
  class="ph"
  style="--ph-padding-inline: {{ section.settings.page_padding }}px;"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
>
  {%- if section.settings.bg_text != blank -%}
    <span class="ph__bg-text" aria-hidden="true">{{ section.settings.bg_text }}</span>
  {%- endif -%}

  <div class="ph__grid">
    {%- liquid
      assign first_variant = product.selected_or_first_available_variant
      assign hide_bundle_discount = false
      if product.handle == 'd-lock-trunk-for-kid'
        assign hide_bundle_discount = true
      endif
      assign low_as_paise = first_variant.price
      for block in section.blocks
        if block.type == 'bundle'
          assign bundle_discount = block.settings.discount_percent | default: 0 | plus: 0
          if hide_bundle_discount
            assign bundle_discount = 0
          endif
          if bundle_discount > 0
            assign bundle_price_paise = first_variant.price | times: 100 | minus: bundle_discount | divided_by: 100
            if bundle_price_paise < low_as_paise
              assign low_as_paise = bundle_price_paise
            endif
          endif
        endif
      endfor
    -%}

    {%- comment -%} Mobile Header: rendered first in DOM, visible ONLY on mobile (<=1023px) {%- endcomment -%}
    <div class="ph-mobile-header">
      <div class="ph-mobile-header__inner">
        <div class="ph-mobile-header__meta">
          <h1 class="ph-mobile-header__heading">{{ product.title }}</h1>
        </div>

        <div class="ph-mobile-header__pricing">
          <div class="ph-mobile-header__price-row">
            <s
              class="ph-mobile-header__compare"
              data-compare-price
              {% unless first_variant.compare_at_price > first_variant.price %}hidden{% endunless %}
            >
              {{ first_variant.compare_at_price | default: first_variant.price | money }}
            </s>
            <p class="ph-mobile-header__price" data-price>
              {{ first_variant.price | money }}
            </p>
          </div>
          {%- if low_as_paise < first_variant.price -%}
            <p class="ph-mobile-header__lowas" data-low-as>Low as {{ low_as_paise | money }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="ph__gallery-col">
     <div class="ph__gallery-pin">
      <div class="ph-gallery-layout">
        {%- if section.blocks.size > 0 -%}
          <div class="ph-gallery__badges-col">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div
                  class="ph-gallery-badge{% if block.settings.highlight %} ph-gallery-badge--highlight{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <span class="ph-gallery-badge__icon">
                    {%- if block.settings.icon_image != blank -%}
                      {{
                        block.settings.icon_image
                          | image_url: width: 60
                          | image_tag:
                          class: 'ph-gallery-badge__icon-img',
                          alt: block.settings.label,
                          loading: 'lazy'
                      }}
                    {%- else -%}
                      {%- case block.settings.icon -%}
                        {%- when 'ruler' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.6" y="8.6" width="18.8" height="6.8" rx="1.2" transform="rotate(-20 12 12)"/><path d="M7.2 12.4l.8-1.9M10.8 11.1l.8-1.9M14.4 9.8l.8-1.9" stroke-linecap="round"/></svg>
                        {%- when 'shield' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 2.8v5.4c0 4.5-3 8.2-7 9.8-4-1.6-7-5.3-7-9.8V5.8L12 3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.4 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {%- when 'leaf' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20c0-8 4-14 16-16 0 12-6 16-12 16" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20C7 14 11 10.5 16 8.5" stroke-linecap="round"/></svg>
                        {%- when 'sweat' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3.5s5.5 6.3 5.5 10a5.5 5.5 0 1 1-11 0c0-3.7 5.5-10 5.5-10z" stroke-linejoin="round"/><path d="M4 6.5h2M3 10h1.5M20 6.5h-2M21 10h-1.5" stroke-linecap="round"/></svg>
                        {%- else -%}
                          {%- if forloop.first -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                          {%- else -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {%- endif -%}
                        {%- endcase -%}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.label != blank -%}
                      <span class="ph-gallery-badge__label">
                        {%- if forloop.first and block.settings.label == 'Shorter Leg' -%}
                          BEST<br>SELLER
                        {%- else -%}
                          {{ block.settings.label | escape }}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="ph-gallery" data-gallery>
        {%- if section.settings.show_rating -%}
          <a
            class="ph-gallery__rating"
            {% if section.settings.reviews_url != blank %}
              href="{{ section.settings.reviews_url }}"
            {% endif %}
            aria-label="Rated {{ section.settings.rating }} out of 5"
          >
            {%- for i in (1..5) -%}
              {%- assign fill_pct = section.settings.rating | minus: i | plus: 1 | times: 100 | at_least: 0 | at_most: 100 -%}
              <span class="ph-star" aria-hidden="true">
                {%- render 'icon-star' -%}
                {%- if fill_pct > 0 -%}
                  <span class="ph-star__fill" style="width: {{ fill_pct }}%;">{%- render 'icon-star-gold' -%}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </a>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <div class="ph-gallery__counter" data-slide-counter>
            <span data-counter-current>1</span> / <span data-counter-total>{{ product.media.size }}</span>
          </div>
        {%- endif -%}

        <div class="ph-gallery__stage">
          {%- if product.media.size > 0 -%}
            {% comment %} {%- for media in product.media -%}
              <div
                class="ph-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-slide
                {% if media.variant_ids.size > 0 %}
                  data-variant-image="{{ media.variant_ids | join: ',' }}"
                {% endif %}
              >
                {%- assign media_loading = 'lazy' -%}
                {%- if forloop.first -%}
                  {%- assign media_loading = 'eager' -%}
                {%- endif -%}
                {{
                  media
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ph-gallery__image',
                    widths: '490, 740, 980, 1200',
                    sizes: '490px',
                    loading: media_loading,
                    alt: media.alt | escape
                }}
              </div>
            {%- endfor -%} {% endcomment %}

            {%- for media in product.media -%}

  <div
    class="ph-gallery__slide{% if forloop.first %} is-active{% endif %}"
    data-slide
    data-media-type="{{ media.media_type }}"
    data-media-id="{{ media.id }}"
    {% if media.variant_ids.size > 0 %}
      data-variant-image="{{ media.variant_ids | join: ',' }}"
    {% endif %}
  >

    {%- case media.media_type -%}

      {%- when 'image' -%}

        {%- assign media_loading = 'lazy' -%}
        {%- if forloop.first -%}
          {%- assign media_loading = 'eager' -%}
        {%- endif -%}

        {{
          media
          | image_url: width: 2400
          | image_tag:
            class: 'ph-gallery__image',
            widths: '490, 740, 980, 1200',
            sizes: '1200px',
            loading: media_loading,
            alt: media.alt | escape
        }}

      {%- when 'video' -%}

        {{
          media
          | video_tag:
            class: 'ph-gallery__video',
            controls: true,
            autoplay: false,
            loop: false,
            muted: true,
            playsinline: true,
            image_size: '1200x'
        }}

      {%- when 'external_video' -%}

        <div class="ph-gallery__external-video">
          {{ media | external_video_tag }}
        </div>

      {%- when 'model' -%}

        {{ media | model_viewer_tag }}

    {%- endcase -%}

  </div>

{%- endfor -%}
          {%- else -%}
            <div class="ph-gallery__slide is-active" data-slide>
              {{ 'product-1' | placeholder_svg_tag: 'ph-gallery__image ph-gallery__image--placeholder' }}
            </div>
          {%- endif -%}
        </div>

        <span class="ph-gallery__shadow" aria-hidden="true"></span>

        {%- if product.media.size > 1 -%}
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--prev"
            data-gallery-prev
            aria-label="Previous image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11.5 4 6.5 9l5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            type="button"
            class="ph-gallery__arrow ph-gallery__arrow--next"
            data-gallery-next
            aria-label="Next image"
          >
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.5 4l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
        </div>
      </div>

      {%- if product.media.size > 1 -%}
        <div class="ph-thumbs-wrap">
          <button
            type="button"
            class="ph-thumbs__arrow ph-thumbs__arrow--prev"
            data-thumbs-prev
            aria-label="Previous image"
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 3.5 5.5 8l4.5 4.5" />
            </svg>
          </button>

          <div class="ph-thumbs" data-thumbs>
            {%- for media in product.media -%}
              <button
                type="button"
                class="ph-thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb-index="{{ forloop.index0 }}"
                aria-label="Show image {{ forloop.index }}"
              >
                {{
                  media
                  | image_url: width: 200
                  | image_tag:
                    class: 'ph-thumb__image',
                    widths: '200, 164',
                    sizes: '200px',
                    loading: 'lazy',
                    alt: media.alt | escape
                }}
              </button>
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="ph-thumbs__arrow ph-thumbs__arrow--next"
            data-thumbs-next
            aria-label="Next image"
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3.5 10.5 8 6 12.5" />
            </svg>
          </button>
        </div>
      {%- endif -%}
     </div>
    </div>

    <div class="ph__buy-col">
      <div class="ph-desktop-title">
        <h1 class="ph-desktop-title__heading">{{ product.title }}</h1>
        <div class="ph-desktop-title__pricing">
          <div class="ph-desktop-title__price-row">
            <s
              class="ph-desktop-title__compare"
              data-compare-price
              {% unless first_variant.compare_at_price > first_variant.price %}hidden{% endunless %}
            >
              {{ first_variant.compare_at_price | default: first_variant.price | money }}
            </s>
            <p class="ph-desktop-title__price" data-price>
              {{ first_variant.price | money }}
            </p>
          </div>
          {%- if low_as_paise < first_variant.price -%}
            <p class="ph-desktop-title__lowas" data-low-as>Low as {{ low_as_paise | money }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="ph-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div
                class="ph-tile{% if block.settings.highlight %} ph-tile--highlight{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="ph-tile__icon">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 80
                      | image_tag:
                        class: 'ph-tile__icon-img',
                        alt: block.settings.label,
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'ruler' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2.6" y="8.6" width="18.8" height="6.8" rx="1.2" transform="rotate(-20 12 12)"/><path d="M7.2 12.4l.8-1.9M10.8 11.1l.8-1.9M14.4 9.8l.8-1.9" stroke-linecap="round"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3l7 2.8v5.4c0 4.5-3 8.2-7 9.8-4-1.6-7-5.3-7-9.8V5.8L12 3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.4 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'leaf' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 20c0-8 4-14 16-16 0 12-6 16-12 16" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20C7 14 11 10.5 16 8.5" stroke-linecap="round"/></svg>
                      {%- when 'sweat' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3.5s5.5 6.3 5.5 10a5.5 5.5 0 1 1-11 0c0-3.7 5.5-10 5.5-10z" stroke-linejoin="round"/><path d="M4 6.5h2M3 10h1.5M20 6.5h-2M21 10h-1.5" stroke-linecap="round"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <span class="ph-tile__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if size_option -%}
        <div class="ph-step ph-step--fit">
          <div class="ph-step__header">
            <span class="ph-step__label">
              <span class="ph-step__num">1.</span> SELECT YOUR {{ size_option.name | upcase }}
            </span>
            <a class="ph-step__aux-link" href="{{ section.settings.find_fit_url | default: '#size-guide' }}">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" class="ph-step__help-icon"><circle cx="8" cy="8" r="6.5"/><path d="M6.5 6.2a1.8 1.8 0 0 1 3.2 1c0 1-.8 1.4-1.2 1.8-.3.3-.5.6-.5 1M8 12.2h.01" stroke-linecap="round"/></svg>
              {{ section.settings.find_fit_text | default: 'HELP ME PICK' | upcase }}
            </a>
          </div>
          <div class="ph-sizes" role="radiogroup" aria-label="{{ size_option.name }}">
            {%- for value in size_option.values -%}
              {%- liquid
                assign display_value = value | split: ' ' | first
                assign matching_variant = null
                for variant in product.variants
                  if variant.options[size_index] == value
                    assign matching_variant = variant
                    break
                  endif
                endfor

                assign val_lower = value | downcase
                assign inseam = ''
                if val_lower contains 'boxer'
                  assign inseam = '6" INSEAM'
                elsif val_lower contains 'trunk'
                  assign inseam = '4" INSEAM'
                elsif val_lower contains 'fly'
                  assign inseam = '6" INSEAM'
                elsif val_lower contains 'sport'
                  assign inseam = '8" INSEAM'
                elsif val_lower contains 'long'
                  assign inseam = '9" INSEAM'
                elsif val_lower contains 'brief'
                  assign inseam = '2" INSEAM'
                endif
              -%}
              <label
                class="ph-size{% if matching_variant == product.selected_or_first_available_variant %} is-selected{% endif %}{% if matching_variant.available == false %} is-unavailable{% endif %}"
                title="{{ value | escape }}"
              >
                <input
                  type="radio"
                  name="ph-size-{{ section.id }}"
                  value="{{ value | escape }}"
                  {% if matching_variant %}data-variant-id="{{ matching_variant.id }}"{% endif %}
                  {% if matching_variant %}
                    data-price="{{ matching_variant.price | money }}"
                    data-price-cents="{{ matching_variant.price }}"
                  {% else %}
                    data-price="{{ product.selected_or_first_available_variant.price | money }}"
                    data-price-cents="{{ product.selected_or_first_available_variant.price }}"
                  {% endif %}
                  {% if matching_variant.compare_at_price > matching_variant.price %}
                    data-compare-price="{{ matching_variant.compare_at_price | money }}"
                  {% endif %}
                  {% if matching_variant and matching_variant.featured_image %}
                    data-variant-image-id="{{ matching_variant.featured_image.id }}"
                  {% endif %}
                  {% if matching_variant == product.selected_or_first_available_variant %}checked{% endif %}
                  {% if matching_variant.available == false %}disabled{% endif %}
                >
                <span class="ph-size__name">{{ display_value }}</span>
                {%- if inseam != blank -%}
                  <span class="ph-size__sub">{{ inseam }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign has_bundles = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
          {%- assign has_bundles = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_bundles -%}
        <div
          class="ph-step ph-step--quantity"
          data-bundle-selector
          data-product-id="{{ product.id }}"
          data-section-id="{{ section.id }}"
        >
          <div class="ph-step__header">
            <span class="ph-step__label">
              <span class="ph-step__num">2.</span> SELECT YOUR QUANTITY
            </span>
          </div>

          <div
            class="ph-bundles"
            role="radiogroup"
            aria-label="Select your quantity"
          >
            {%- for block in section.blocks -%}
              {%- if block.type == 'bundle' -%}
                {%- liquid
                  assign qty_digits = block.settings.pairs | replace: ' Pairs', '' | replace: ' Pair', '' | replace: ' pairs', '' | replace: ' pair', '' | strip
                  assign qty = qty_digits | plus: 0
                  if qty == 0
                    assign qty = 1
                  endif
                  assign bundle_discount = block.settings.discount_percent | default: 0 | plus: 0
                  if hide_bundle_discount
                    assign bundle_discount = 0
                  endif
                  if bundle_discount > 0
                    assign bundle_price_paise = first_variant.price | times: 100 | minus: bundle_discount | divided_by: 100
                  else
                    assign bundle_price_paise = first_variant.price
                  endif
                -%}
                <label
                  class="ph-bundle{% if block.settings.selected %} is-selected{% endif %}"
                  data-bundle-option
                  data-quantity="{{ qty }}"
                  {{ block.shopify_attributes }}
                >
                  <input
                    type="radio"
                    class="ph-bundle__input"
                    name="bundle-quantity-{{ section.id }}"
                    value="{{ qty }}"
                    data-qty="{{ qty }}"
                    data-discount-percent="{{ bundle_discount }}"
                    {% if block.settings.selected %}
                      checked
                    {% endif %}
                  >

                  {%- if block.settings.top_badge != blank -%}
                    <span class="ph-bundle__badge ph-bundle__badge--top">{{ block.settings.top_badge }}</span>
                  {%- endif -%}

                  <span class="ph-bundle__pairs">
                    {{ block.settings.pairs }}
                  </span>

                  <span class="ph-bundle__price" data-bundle-price>
                    {{ bundle_price_paise | money }}
                  </span>

                  {%- if bundle_discount > 0 -%}
                    <span class="ph-bundle__badge ph-bundle__badge--discount" data-bundle-discount>
                      {{ bundle_discount }}% OFF
                    </span>
                  {%- endif -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {% render 'product-colour-builder', product: product, section: section %}
    </div>
  </div>
</product-hero>

<script src="{{ 'product-hero.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "class": "section-ph",
  "settings": [
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background text",
      "default": "underwear"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Rating & Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating on gallery (desktop)",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 3,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
