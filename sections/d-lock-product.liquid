{%- comment -%}
  D-Lock Product - product panel with gallery, size selector and pack offers
  Pixel-matched to Figma nodes 10:3924-10:4019 (2 into 9 D-LOCK Page Design)
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700;0,800;1,400;1,800&display=swap' | stylesheet_tag }}

{%- liquid
  assign tile_fallback_icons = 'pouch,lock,breathable,antibacterial' | split: ','
  assign size_list = section.settings.size_options | split: ','
-%}

<section
  class="d-lock-product"
  id="DLockProduct-{{ section.id }}"
  data-dlp-root
  style="--dlp-pt: {{ section.settings.padding_top }}; --dlp-pb: {{ section.settings.padding_bottom }}; --dlp-bg: {{ section.settings.background_color }};"
>
  <div class="d-lock-product__inner">
    <div class="d-lock-product__gallery">
      <div class="d-lock-product__main" data-dlp-main-frame>
        {%- if section.settings.main_image != blank -%}
          {{
            section.settings.main_image
            | image_url: width: 1300
            | image_tag:
              class: 'd-lock-product__main-img',
              widths: '650, 980, 1300',
              sizes: '(min-width: 750px) 650px, 92vw',
              loading: 'lazy',
              alt: section.settings.product_title | escape
          }}
        {%- else -%}
          <img
            class="d-lock-product__main-img"
            src="{{ 'd-lock-product-main.png' | asset_url }}"
            alt="{{ section.settings.product_title | escape }}"
            width="1122"
            height="899"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
      </div>

      <div class="d-lock-product__thumbs">
        <button class="d-lock-product__thumb is-active" type="button" data-dlp-thumb data-dlp-src="{{ 'd-lock-product-main.png' | asset_url }}" aria-label="View image 1">
          <img class="d-lock-product__thumb-img d-lock-product__thumb-img--1" src="{{ 'd-lock-product-main.png' | asset_url }}" alt="" width="1122" height="899" loading="lazy" decoding="async">
        </button>
        {%- if section.settings.thumb_image_2 != blank -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ section.settings.thumb_image_2 | image_url: width: 900 }}" aria-label="View image 2">
            {{ section.settings.thumb_image_2 | image_url: width: 450 | image_tag: class: 'd-lock-product__thumb-img d-lock-product__thumb-img--2', loading: 'lazy', alt: '' }}
          </button>
        {%- else -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ 'd-lock-product-thumb-2.png' | asset_url }}" aria-label="View image 2">
            <img class="d-lock-product__thumb-img d-lock-product__thumb-img--2" src="{{ 'd-lock-product-thumb-2.png' | asset_url }}" alt="" width="1402" height="1437" loading="lazy" decoding="async">
          </button>
        {%- endif -%}
        {%- if section.settings.thumb_image_3 != blank -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ section.settings.thumb_image_3 | image_url: width: 900 }}" aria-label="View image 3">
            {{ section.settings.thumb_image_3 | image_url: width: 450 | image_tag: class: 'd-lock-product__thumb-img d-lock-product__thumb-img--3', loading: 'lazy', alt: '' }}
          </button>
        {%- else -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ 'd-lock-product-thumb-3.png' | asset_url }}" aria-label="View image 3">
            <img class="d-lock-product__thumb-img d-lock-product__thumb-img--3" src="{{ 'd-lock-product-thumb-3.png' | asset_url }}" alt="" width="2000" height="2244" loading="lazy" decoding="async">
          </button>
        {%- endif -%}
        {%- if section.settings.thumb_image_4 != blank -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ section.settings.thumb_image_4 | image_url: width: 900 }}" aria-label="View image 4">
            {{ section.settings.thumb_image_4 | image_url: width: 450 | image_tag: class: 'd-lock-product__thumb-img d-lock-product__thumb-img--4', loading: 'lazy', alt: '' }}
          </button>
        {%- else -%}
          <button class="d-lock-product__thumb" type="button" data-dlp-thumb data-dlp-src="{{ 'd-lock-product-thumb-4.png' | asset_url }}" aria-label="View image 4">
            <img class="d-lock-product__thumb-img d-lock-product__thumb-img--4" src="{{ 'd-lock-product-thumb-4.png' | asset_url }}" alt="" width="1402" height="1437" loading="lazy" decoding="async">
          </button>
        {%- endif -%}
      </div>
    </div>

    <div class="d-lock-product__info">
      <div class="d-lock-product__title-row">
        {%- if section.settings.product_title != blank -%}
          <h2 class="d-lock-product__title">{{ section.settings.product_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.product_subtitle != blank -%}
          <span class="d-lock-product__subtitle">{{ section.settings.product_subtitle | escape }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.price != blank -%}
        <p class="d-lock-product__price">{{ section.settings.price | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="d-lock-product__tiles">
          {%- assign tile_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'icon_tile' -%}
              {%- assign fallback_icon = 'd-lock-tile-icon-' | append: tile_fallback_icons[tile_index] | append: '.svg' -%}
              <div class="d-lock-product__tile" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 80
                    | image_tag:
                      class: 'd-lock-product__tile-icon',
                      alt: block.settings.label | escape
                  }}
                {%- else -%}
                  <img
                    class="d-lock-product__tile-icon"
                    src="{{ fallback_icon | asset_url }}"
                    alt="{{ block.settings.label | escape }}"
                    width="60"
                    height="60"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="d-lock-product__tile-label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
              {%- assign tile_index = tile_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <p class="d-lock-product__size-label">{{ section.settings.select_size_label | escape }}</p>

      <div class="d-lock-product__sizes" data-dlp-sizes role="group" aria-label="{{ section.settings.select_size_label | escape }}">
        {%- for size in size_list -%}
          {%- assign size_handle = size | strip -%}
          <button
            class="d-lock-product__size{% if size_handle == section.settings.default_size %} is-active{% endif %}"
            type="button"
            data-dlp-size="{{ size_handle | escape }}"
          >
            {{- size_handle -}}
          </button>
        {%- endfor -%}
      </div>

      <div class="d-lock-product__offers">
        {%- for block in section.blocks -%}
          {%- if block.type == 'offer' -%}
            <button class="d-lock-product__offer" type="button" data-dlp-offer {{ block.shopify_attributes }}>
              <img
                class="d-lock-product__offer-radio"
                src="{{ 'd-lock-radio.svg' | asset_url }}"
                alt=""
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              >
              <span class="d-lock-product__offer-pack">
                {%- if block.settings.title != blank -%}
                  <span class="d-lock-product__offer-title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="d-lock-product__offer-sub">{{ block.settings.subtitle | escape }}</span>
                {%- endif -%}
              </span>
              <span class="d-lock-product__offer-pricing">
                {%- if block.settings.price != blank -%}
                  <span class="d-lock-product__offer-price">{{ block.settings.price | escape }}</span>
                {%- endif -%}
                {%- if block.settings.per_pair != blank -%}
                  <span class="d-lock-product__offer-per-pair">{{ block.settings.per_pair | escape }}</span>
                {%- endif -%}
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="d-lock-product__actions">
        <div class="d-lock-product__qty" data-dlp-qty data-dlp-value="{{ section.settings.default_quantity }}">
          <button class="d-lock-product__qty-btn" type="button" data-dlp-step="-1" aria-label="Decrease quantity">&minus;</button>
          <span class="d-lock-product__qty-value" data-dlp-qty-value>{{ section.settings.default_quantity }}</span>
          <button class="d-lock-product__qty-btn" type="button" data-dlp-step="1" aria-label="Increase quantity">+</button>
        </div>
        {%- if section.settings.atc_label != blank -%}
          <a
            class="d-lock-product__atc"
            {% if section.settings.atc_link != blank %}
              href="{{ section.settings.atc_link }}"
            {% else %}
              role="button"
              tabindex="0"
            {% endif %}
          >
            {{- section.settings.atc_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .d-lock-product {
    position: relative;
    width: 100%;
    background: var(--dlp-bg, #171717);
    font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    container-type: inline-size;
  }

  .d-lock-product__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.7604cqw;
    padding: calc(var(--dlp-pt, 120) * 0.05208cqw) 16.1458cqw calc(var(--dlp-pb, 120) * 0.05208cqw);
  }

  .d-lock-product__gallery {
    width: 33.8542cqw;
    flex-shrink: 0;
  }

  .d-lock-product__main {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #ffffff;
    border: 0.5px solid #dcdcdc;
    border-radius: 0.5208cqw;
    overflow: hidden;
  }

  .d-lock-product__main-img {
    position: absolute;
    left: -15.5385%;
    top: -2.4615%;
    width: 131.0769%;
    height: 104.9231%;
    max-width: none;
    object-fit: cover;
    display: block;
  }

