<section
  id="Faq-{{ section.id }}"
  class="faq color-{{ section.settings.color_scheme }} section"
>
  <div class="faq__container page-width">
    <div class="faq__body">
      {% render 'faq-content' %}
    </div>
  </div>
</section>

{% style %}
  #Faq-{{ section.id }} {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .faq__container {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq__body {
    width: 100%;
  }

  /* FAQ Content Styles */
  .faq-content {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .faq-category {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-category__title {
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 1.5rem 0;
    padding: 0;
    border: none;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  /* FAQ Item Accordion */
  .faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .faq-item:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover {
    color: rgba(0, 0, 0, 0.6);
  }

  /* Chevron Icon with Circle Border */
  .faq-item__icon {
    position: relative;
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    background-color: #333;
    width: 6px;
    height: 1.5px;
    border-radius: 1px;
    transition: transform 0.3s ease;
  }

  .faq-item__icon::before {
    transform: rotate(45deg);
    left: 7px;
  }

  .faq-item__icon::after {
    transform: rotate(-45deg);
    right: 7px;
  }

  .faq-item[open] .faq-item__icon::before {
    transform: rotate(-45deg);
  }

  .faq-item[open] .faq-item__icon::after {
    transform: rotate(45deg);
  }

  /* FAQ Answer */
  .faq-item__answer {
    padding: 0 0 1.5rem 1.75rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: color-mix(in srgb, currentColor 75%, transparent);
  }

  .faq-item__answer p {
    margin: 0 0 1rem;
  }

  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }

  .faq-item__answer ul {
    margin: 0.5rem 0 1rem;
    padding-left: 1.5rem;
  }

  .faq-item__answer ul li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .faq-item__answer ul li strong {
    font-weight: 600;
  }

  .faq-item__answer a {
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .faq-item__answer a:hover {
    opacity: 0.7;
  }

  /* Mobile Responsive */
  @media (max-width: 749px) {
    .faq-content {
      gap: 3rem;
    }

    .faq-category__title {
      font-size: 1.25rem;
    }

    .faq-item__question {
      padding: 1rem 0;
      font-size: 0.9rem;
      gap: 0.75rem;
    }

    .faq-item__answer {
      font-size: 0.9rem;
      padding-bottom: 1.25rem;
      padding-left: 1.5rem;
    }

    .faq-item__icon {
      width: 10px;
      height: 10px;
    }

    .faq-item__icon::before,
    .faq-item__icon::after {
      width: 7px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
