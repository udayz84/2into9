{% comment %} {%- comment -%}
  Homepage — full-bleed lookbook media strip. Accepts a Shopify-hosted video
  (plays inline on click) or falls back to an image poster. Circular play mark.
  Ref: section screenshot 9.
{%- endcomment -%}

{%- liquid
  assign vm_pos = section.settings.image_position | default: 'top'

  assign enable_shadow = true
  if section.settings.enable_shadow == false
    assign enable_shadow = false
  endif

  assign shadow_opacity = section.settings.shadow_intensity | default: 70 | divided_by: 100.0
  assign top_opacity = section.settings.top_shadow_intensity | default: 60 | divided_by: 100.0 | times: shadow_opacity
  assign bottom_opacity = section.settings.bottom_shadow_intensity | default: 75 | divided_by: 100.0 | times: shadow_opacity
  assign vignette_opacity = section.settings.vignette_intensity | default: 70 | divided_by: 100.0 | times: shadow_opacity
  assign box_shadow_opacity = section.settings.box_shadow_intensity | default: 50 | divided_by: 100.0
-%}

<section
  class="vm{% if section.settings.mirror %} vm--mirror{% endif %}{% if section.settings.enable_box_shadow %} vm--box-shadow{% endif %}"
  data-vm-root
  data-position="{{ vm_pos }}"
  style="
    margin-block: {{ section.settings.gap_top }}px {{ section.settings.gap_bottom }}px;
    --vm-box-shadow-alpha: {{ box_shadow_opacity }};
  "
>
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        image_placeholder: section.settings.image,
        class: 'vm__media',
        playsinline: true,
        preload: 'none',
        controls: false
    }}
  {%- else -%}
    <picture class="vm__picture">
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
      {%- endif -%}
      <img
        class="vm__media"
        src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_asset | default: 'promo-video.jpg' | asset_url }}{% endif %}"
        alt="{{ section.settings.image_alt | default: '2into9 lookbook' | escape }}"
        loading="lazy"
        width="2000"
        height="890"
      >
    </picture>
  {%- endif -%}

  {%- if enable_shadow -%}
    <div
      class="vm__shadow vm__shadow--{{ section.settings.shadow_style | default: 'cinematic' }}"
      style="
        --vm-top-alpha: {{ top_opacity }};
        --vm-bottom-alpha: {{ bottom_opacity }};
        --vm-vignette-alpha: {{ vignette_opacity }};
      "
      aria-hidden="true"
    ></div>
  {%- endif -%}

  {%- if section.settings.show_play_mark -%}
    <button class="vm__play" type="button" data-vm-play aria-label="Play video">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
    </button>
  {%- endif -%}
</section>

{% stylesheet %}
  .vm {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 445;
    background: #0d0f0d;
    overflow: hidden;
  }

  .vm__picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .vm__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* =========================
     BLACK SHADOW ON VIDEO
  ========================== */

  .vm__shadow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .vm__shadow--cinematic {
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, var(--vm-top-alpha, 0.42)) 0%,
        rgba(0, 0, 0, calc(var(--vm-top-alpha, 0.42) * 0.45)) 16%,
        transparent 36%,
        transparent 60%,
        rgba(0, 0, 0, calc(var(--vm-bottom-alpha, 0.525) * 0.45)) 82%,
        rgba(0, 0, 0, var(--vm-bottom-alpha, 0.525)) 100%
      ),
      radial-gradient(
        ellipse at center,
        transparent 40%,
        rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 0.6)) 75%,
        rgba(0, 0, 0, var(--vm-vignette-alpha, 0.49)) 100%
      );
    box-shadow: inset 0 0 clamp(40px, 8vw, 150px) rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 1.3));
  }

  .vm__shadow--vignette {
    background: radial-gradient(
      ellipse at center,
      transparent 30%,
      rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 0.5)) 65%,
      rgba(0, 0, 0, var(--vm-vignette-alpha, 0.49)) 100%
    );
    box-shadow: inset 0 0 clamp(50px, 10vw, 180px) rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 1.4));
  }

  .vm__shadow--top_bottom {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, var(--vm-top-alpha, 0.42)) 0%,
      rgba(0, 0, 0, calc(var(--vm-top-alpha, 0.42) * 0.4)) 18%,
      transparent 38%,
      transparent 62%,
      rgba(0, 0, 0, calc(var(--vm-bottom-alpha, 0.525) * 0.4)) 82%,
      rgba(0, 0, 0, var(--vm-bottom-alpha, 0.525)) 100%
    );
  }

  .vm__shadow--bottom_only {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, var(--vm-bottom-alpha, 0.525)) 0%,
      rgba(0, 0, 0, calc(var(--vm-bottom-alpha, 0.525) * 0.5)) 25%,
      transparent 65%
    );
  }

  .vm__shadow--full {
    background:
      rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 0.4)),
      radial-gradient(
        ellipse at center,
        transparent 25%,
        rgba(0, 0, 0, var(--vm-vignette-alpha, 0.49)) 100%
      );
    box-shadow: inset 0 0 clamp(40px, 8vw, 140px) rgba(0, 0, 0, calc(var(--vm-vignette-alpha, 0.49) * 1.3));
  }

  .vm--box-shadow {
    box-shadow:
      0 20px 50px -10px rgba(0, 0, 0, var(--vm-box-shadow-alpha, 0.5)),
      0 0 35px rgba(0, 0, 0, calc(var(--vm-box-shadow-alpha, 0.5) * 0.7));
  }

  .vm[data-position='top'] .vm__media {
    object-position: 50% 15%;
  }

  .vm[data-position='center'] .vm__media {
    object-position: 50% 50%;
  }

  .vm[data-position='bottom'] .vm__media {
    object-position: 50% 68%;
  }

  .vm--mirror .vm__media {
    transform: scaleX(-1);
  }

  .vm__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(80px, 6.5vw, 112px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .vm__play:hover {
    transform: translate(-50%, -50%) scale(1.06);
    background: rgba(255, 255, 255, 0.42);
  }

  .vm__play svg {
    width: 38%;
    height: 38%;
    margin-left: 5%;
  }

  .vm.is-playing .vm__play {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .vm {
      aspect-ratio: 4 / 3;
    }

    .vm__play {
      width: clamp(64px, 18vw, 84px);
    }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('[data-vm-root]').forEach(function (root) {
    var video = root.querySelector('video');
    var btn = root.querySelector('[data-vm-play]');
    if (!btn) return;

    btn.addEventListener('click', function () {
      if (video) video.play();
    });

    if (video) {
      video.addEventListener('play', function () {
        root.classList.add('is-playing');
      });
      video.addEventListener('pause', function () {
        root.classList.remove('is-playing');
      });
      video.addEventListener('ended', function () {
        root.classList.remove('is-playing');
      });
    }
  });
</script>

