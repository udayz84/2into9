{% comment %}
  2INTO9 — Where Better Begins + Built for the Day
  Add as: sections/2into9-about-story-sections.liquid
{% endcomment %}

<section id="into9-story-{{ section.id }}" class="into9-story-section">
  <div class="into9-story-container">
    <div class="into9-story-grid into9-story-grid--first">
      <div class="into9-story-copy">
        {% if section.settings.first_eyebrow != blank %}<p class="into9-story-eyebrow">{{ section.settings.first_eyebrow | escape }}</p>{% endif %}
        {% if section.settings.first_heading != blank %}<h2>{{ section.settings.first_heading | escape }}</h2>{% endif %}
        <div class="into9-story-rte rte">{{ section.settings.first_content }}</div>
      </div>
      <div class="into9-story-media">
        {% if section.settings.first_image != blank %}
          {{ section.settings.first_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 990, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'into9-story-image' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'into9-story-image into9-story-placeholder' }}
        {% endif %}
      </div>
    </div>

    <div class="into9-story-grid into9-story-grid--second">
      <div class="into9-story-media">
        {% if section.settings.second_image != blank %}
          {{ section.settings.second_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 990, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'into9-story-image' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'into9-story-image into9-story-placeholder' }}
        {% endif %}
      </div>
      <div class="into9-story-copy">
        {% if section.settings.second_eyebrow != blank %}<p class="into9-story-eyebrow">{{ section.settings.second_eyebrow | escape }}</p>{% endif %}
        {% if section.settings.second_heading != blank %}<h2>{{ section.settings.second_heading | escape | newline_to_br }}</h2>{% endif %}
        <div class="into9-story-rte rte">{{ section.settings.second_content }}</div>
        {% if section.settings.show_benefits %}
          <div class="into9-benefits">
            <p class="into9-benefits-title">{{ section.settings.benefits_title | escape }}</p>
            <div class="into9-benefits-grid">
              {% for block in section.blocks %}
                {% if block.type == 'benefit' %}
                  <div class="into9-benefit" {{ block.shopify_attributes }}>
                    <span class="into9-benefit-icon" aria-hidden="true">
                      {% case block.settings.icon %}
                        {% when 'leaf' %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M27 5C13 5 6 12 6 21c0 4 3 6 7 6 10 0 15-12 14-22Z"/><path d="M5 29c5-11 11-15 19-19"/></svg>
                        {% when 'shield' %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m16 3 11 5v8c0 8-5 12-11 14C10 28 5 24 5 16V8l11-5Z"/><path d="m11 16 4 4 7-8"/></svg>
                        {% when 'waves' %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 10c5-4 9 4 14 0s9-4 14 0M2 17c5-4 9 4 14 0s9-4 14 0M2 24c5-4 9 4 14 0s9-4 14 0"/></svg>
                        {% when 'layers' %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m16 3 13 7-13 7L3 10l13-7ZM3 16l13 7 13-7M3 23l13 7 13-7"/></svg>
                        {% when 'check' %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="16" cy="16" r="12"/><path d="m9 16 5 5 9-10"/></svg>
                      {% endcase %}
                    </span>
                    <span class="into9-benefit-text">{{ block.settings.text | escape }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
        {% if section.settings.second_closing != blank %}<div class="into9-story-closing rte">{{ section.settings.second_closing }}</div>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #into9-story-{{ section.id }} { background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.vertical_padding }}px 0; }
  #into9-story-{{ section.id }} .into9-story-container { width: min(calc(100% - 40px), {{ section.settings.max_width }}px); margin: 0 auto; }
  #into9-story-{{ section.id }} .into9-story-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 78px); align-items: center; }
  #into9-story-{{ section.id }} .into9-story-grid + .into9-story-grid { margin-top: {{ section.settings.row_spacing }}px; }
  #into9-story-{{ section.id }} .into9-story-copy { min-width: 0; }
  #into9-story-{{ section.id }} .into9-story-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; font-weight: 700; margin: 0 0 13px; line-height: 1.5; }
  #into9-story-{{ section.id }} h2 { color: inherit; font-size: clamp(28px, 3vw, 44px); font-weight: 750; line-height: 1.12; letter-spacing: -.025em; margin: 0 0 20px; }
  #into9-story-{{ section.id }} .into9-story-rte, #into9-story-{{ section.id }} .into9-story-closing { font-size: 15px; line-height: 1.7; }
  #into9-story-{{ section.id }} .into9-story-rte p, #into9-story-{{ section.id }} .into9-story-closing p { margin: 0 0 13px; }
  #into9-story-{{ section.id }} .into9-story-rte p:last-child, #into9-story-{{ section.id }} .into9-story-closing p:last-child { margin-bottom: 0; }
  #into9-story-{{ section.id }} .into9-story-media { width: 100%; aspect-ratio: {{ section.settings.image_ratio }}; overflow: hidden; background: #ebe9e5; }
  #into9-story-{{ section.id }} .into9-story-image { display: block; width: 100%; height: 100%; object-fit: cover; }
  #into9-story-{{ section.id }} .into9-story-placeholder { color: #b3b1ac; }
  #into9-story-{{ section.id }} .into9-benefits { background: {{ section.settings.benefits_bg }}; margin: 25px 0 20px; padding: 22px 20px 23px; }
  #into9-story-{{ section.id }} .into9-benefits-title { text-align: center; font-weight: 750; font-size: 14px; letter-spacing: .03em; margin: 0 0 20px; text-transform: uppercase; }
  #into9-story-{{ section.id }} .into9-benefits-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
  #into9-story-{{ section.id }} .into9-benefit { display: flex; gap: 12px; align-items: center; min-width: 0; }
  #into9-story-{{ section.id }} .into9-benefit-icon { flex: 0 0 35px; width: 35px; height: 35px; }
  #into9-story-{{ section.id }} .into9-benefit-icon svg { width: 100%; height: 100%; }
  #into9-story-{{ section.id }} .into9-benefit-text { font-size: 13px; line-height: 1.45; }
  #into9-story-{{ section.id }} .into9-story-closing { margin-top: 14px; }
  @media (max-width: 749px) {
    #into9-story-{{ section.id }} { padding: {{ section.settings.mobile_padding }}px 0; }
    #into9-story-{{ section.id }} .into9-story-container { width: calc(100% - 32px); }
    #into9-story-{{ section.id }} .into9-story-grid { grid-template-columns: 1fr; gap: 24px; }
    #into9-story-{{ section.id }} .into9-story-grid--first .into9-story-copy { order: 1; }
    #into9-story-{{ section.id }} .into9-story-grid--first .into9-story-media { order: 2; }
    #into9-story-{{ section.id }} .into9-story-grid--second .into9-story-media { order: 1; }
    #into9-story-{{ section.id }} .into9-story-grid--second .into9-story-copy { order: 2; }
    #into9-story-{{ section.id }} .into9-story-grid + .into9-story-grid { margin-top: 55px; }
    #into9-story-{{ section.id }} h2 { font-size: 30px; margin-bottom: 15px; }
    #into9-story-{{ section.id }} .into9-story-rte, #into9-story-{{ section.id }} .into9-story-closing { font-size: 14px; }
    #into9-story-{{ section.id }} .into9-benefits { padding: 18px 14px; }
    #into9-story-{{ section.id }} .into9-benefit-icon { flex-basis: 28px; width: 28px; height: 28px; }
    #into9-story-{{ section.id }} .into9-benefit-text { font-size: 12px; }
  }
  @media (max-width: 380px) {
    #into9-story-{{ section.id }} .into9-benefits-grid { grid-template-columns: 1fr; gap: 13px; }
  }
</style>

{% schema %}
{
  "name": "2INTO9 Story & Comfort",
  "tag": "section",
  "class": "section-into9-story",
  "settings": [
    { "type": "header", "content": "Where Better Begins" },
    { "type": "text", "id": "first_eyebrow", "label": "Small heading", "default": "Our Process" },
    { "type": "text", "id": "first_heading", "label": "Heading", "default": "Where Better Begins" },
    { "type": "richtext", "id": "first_content", "label": "Content", "default": "<p>We believe good design starts with asking what isn't working.</p><p>Where does the product shift? Where does it restrict movement? Where do people adjust, compensate, or simply put up with discomfort?</p><p>From there, every detail gets a job. Considered construction, anatomical support, and carefully selected fabrics all come from solving a real use case, not adding features for show.</p><p>The goal is simple: less managing what you wear, more getting on with your day.</p>" },
    { "type": "image_picker", "id": "first_image", "label": "First section image" },
    { "type": "header", "content": "Built for the Day" },
    { "type": "text", "id": "second_eyebrow", "label": "Small heading", "default": "Everyday Performance" },
    { "type": "textarea", "id": "second_heading", "label": "Heading", "default": "Built for the Day,\nNot the Display" },
    { "type": "richtext", "id": "second_content", "label": "Content", "default": "<p>Daily wear has to perform beyond the first few hours of the day.</p><p>That means thinking about long hours, movement, changing conditions, and repeated use.</p>" },
    { "type": "image_picker", "id": "second_image", "label": "Second section image" },
    { "type": "checkbox", "id": "show_benefits", "label": "Show benefits panel", "default": true },
    { "type": "text", "id": "benefits_title", "label": "Benefits panel heading", "default": "RELAX, IT'S HANDLED:" },
    { "type": "richtext", "id": "second_closing", "label": "Closing text", "default": "<p><strong>Take away the logo, branding and shelf appeal, and the product still has to prove itself.</strong> What really matters is the experience it adds to your everyday life.</p>" },
    { "type": "header", "content": "Layout and colours" },
    { "type": "color", "id": "background_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#171717" },
    { "type": "color", "id": "benefits_bg", "label": "Benefits background", "default": "#F3F1EF" },
    { "type": "select", "id": "image_ratio", "label": "Image aspect ratio", "options": [ { "value": "4 / 3", "label": "Landscape (4:3)" }, { "value": "3 / 2", "label": "Wide (3:2)" }, { "value": "1 / 1", "label": "Square" }, { "value": "3 / 4", "label": "Portrait (3:4)" } ], "default": "4 / 3" },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "vertical_padding", "label": "Desktop vertical padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile vertical padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "row_spacing", "label": "Spacing between rows", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "waves", "label": "Waves" }, { "value": "layers", "label": "Layers" }, { "value": "check", "label": "Check" } ], "default": "check" },
      { "type": "textarea", "id": "text", "label": "Benefit text", "default": "Everyday comfort" }
    ] }
  ],
  "presets": [
    { "name": "2INTO9 Story & Comfort", "blocks": [
      { "type": "benefit", "settings": { "icon": "leaf", "text": "Comfort that holds up through the day" } },
      { "type": "benefit", "settings": { "icon": "shield", "text": "Support without unnecessary restriction" } },
      { "type": "benefit", "settings": { "icon": "waves", "text": "Better management of heat and moisture" } },
      { "type": "benefit", "settings": { "icon": "layers", "text": "Fit and structure that stay consistent over time" } }
    ] }
  ]
}
{% endschema %}
