<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- else -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ 'Logo.png' | asset_img_url: '32x32' }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {%- if template.name == 'index' or template.name == 'product' or template == 'page.about' -%}
      <style>
        /*
         * Desktop section rhythm: neutralize each section's own
         * vertical spacing, then apply one uniform 48px gap between
         * every adjacent section. Mobile/tablet keep original values.
         */
        @media (min-width: 1024px) {
          main[data-template='index'] .scrolling-banner,
          main[data-template='index'] .cat-split,
          main[data-template='index'] .itp,
          main[data-template='index'] .vm {
            padding-block: 0 !important;
            margin-block: 0 !important;
          }

          /* Last section keeps its bottom padding before the footer */
          main[data-template='index'] .faq {
            padding-block-start: 0 !important;
          }

          main[data-template='index'] .shopify-section + .shopify-section {
            margin-top: 48px;
          }

          /*
           * Product page: hero→accordion junction is left to the
           * pinned-gallery alignment script; normalize the rest.
           */
          main[data-template='product'] .pa {
            padding-block-end: 0 !important;
          }

          main[data-template='product'] .pw,
          main[data-template='product'] .pf {
            padding-block: 0 !important;
          }

          main[data-template='product'] .pf {
            padding-block-end: 100px !important;
          }

          main[data-template='product'] .shopify-section + .shopify-section {
            margin-top: 48px;
          }

          /*
           * About page: all sections use additive paddings — zero
           * them and use the same uniform gap.
           */
          main[data-template='page.about'] .spacing-style,
          main[data-template='page.about'] .inherit-spacing,
          main[data-template='page.about'] .about-story,
          main[data-template='page.about'] .into9-story-section {
            padding-block: 0 !important;
          }

          /* Last section keeps its bottom padding before the footer */
          main[data-template='page.about'] .about-features {
            padding-block-start: 0 !important;
          }

          main[data-template='page.about'] .shopify-section + .shopify-section {
            margin-top: 48px;
          }
        }
      </style>
    {%- endif -%}
{% if request.page_type == 'policy' %}
  <style>
    .shopify-policy__container {
      padding-top: calc(var(--header-height, 70px) + clamp(28px, 4vw, 44px)) !important;
    }

    .shopify-policy-breadcrumb {
      margin-top: 12px;
      margin-bottom: 30px;
      font-size: 14px;
      line-height: 1.5;
      text-align:center;
    }

    .shopify-policy-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .shopify-policy-breadcrumb a:hover {
      text-decoration: underline;
    }

    .shopify-policy-breadcrumb__separator {
      margin: 0 8px;
      {% comment %} opacity: 0.5; {% endcomment %}
    }

    .shopify-policy-breadcrumb__current {
      {% comment %} opacity: 0.65; {% endcomment %}
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var policyTitle = document.querySelector(
        '.shopify-policy__title h1, .shopify-policy__title, .shopify-policy-container h1, main h1'
      );

      if (!policyTitle) {
        return;
      }

      if (document.querySelector('.shopify-policy-breadcrumb')) {
        return;
      }

      var breadcrumb = document.createElement('nav');

      breadcrumb.className = 'shopify-policy-breadcrumb';
      breadcrumb.setAttribute('aria-label', 'Breadcrumb');

      breadcrumb.innerHTML =
        '<a href="{{ routes.root_url }}">Home</a>' +
        '<span class="shopify-policy-breadcrumb__separator">/</span>' +
        '<span class="shopify-policy-breadcrumb__current">{{ page_title | escape }}</span>';

      policyTitle.insertAdjacentElement('afterend', breadcrumb);
    });
  </script>
{% endif %}
    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
