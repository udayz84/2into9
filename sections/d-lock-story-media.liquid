      "id": "show_center_play",
      "label": "Show centre play button",
      "default": true
    },
    {
      "type": "text",
      "id": "media_label",
      "label": "Bottom media label",
      "default": "Chris Lynn – Australian Cricket Player"
    },
    {
      "type": "checkbox",
      "id": "show_verified_icon",
      "label": "Show verified icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#08090B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#8D91A0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#C7FF00"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Benefit card",
      "default": "#17191D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#2C2F35"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
