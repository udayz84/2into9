    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Theme image filenames"
    },
    {
      "type": "text",
      "id": "panel_1_asset",
      "label": "Left panel",
      "default": "panel-mens.jpg"
    },
    {
      "type": "text",
      "id": "panel_2_asset",
      "label": "Right panel",
      "default": "panel-dlock.jpg"
    }
  ],
  "presets": [
    {
      "name": "Category Split"
    }
  ]
}{% endschema %}
