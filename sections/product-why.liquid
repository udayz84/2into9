{% stylesheet %}
  .pw,
  .pw h1,
  .pw h2,
  .pw h3,
  .pw h4,
  .pw p,
  .pw span,
  .pw button,
  .pw input,
  .pw a {
    font-family: var(--pw-font);
  }

  .pw {
    --pw-ink: #171717;
    --pw-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    font-family: var(--pw-font);
    color: var(--pw-ink);
    padding-inline: var(--pw-padding-inline, 110px) !important;
    padding-top: var(--pw-padding-top, 60px) !important;
    padding-bottom: var(--pw-padding-bottom, 100px) !important;
    overflow: hidden;
  }

  .pw__heading {
    margin: 0 0 clamp(28px, 3.5vw, 44px);
    font-size: clamp(24px, 2.5vw, 36px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--pw-ink);
  }

  .pw__cards {
    display: flex;
    justify-content: center;
    gap: 32px;
  }

  .pw-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 350px;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
    transform: translateY(0);
    will-change: transform;
    isolation: isolate;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .pw-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .pw-card__media {
    position: relative;
    width: 100%;
    height: 290px;
    background: #ffffff;
    overflow: hidden;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .pw-card__media::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: -2px;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(255, 255, 255, 0.2) 65%,
      rgba(255, 255, 255, 0.6) 80%,
      rgba(255, 255, 255, 0.92) 92%,
      #ffffff 97%,
      #ffffff 100%
    );
    z-index: 2;
  }

  .pw-card__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pw-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform: scale(1);
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: transform 0.35s ease;
  }

  .pw-card:hover .pw-card__image {
    transform: scale(1.03);
  }

  .pw-card__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pw-card__content {
    position: relative;
    z-index: 3;
    margin-top: -2px;
    padding: 24px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
  }

  .pw-card__label {
    font-size: 1.2rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-align: center;
    color: #111827;
    margin: 0 0 18px;
    display: block;
  }

  .pw-card__features {
       margin-left:40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    flex: 1;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .pw-card__feature-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: #4b5563;
    line-height: 1.35;
    text-align: left;
  }

  .pw-card__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    min-width: 18px;
    flex-shrink: 0;
  }

  .pw-card__feature-icon svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .pw-card__button {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: none;
    box-sizing: border-box;
    margin-top: auto;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }

  .pw-card:hover .pw-card__button,
  .pw-card__button:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .pw-card:active .pw-card__button,
  .pw-card__button:active {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .pw-card__btn-arrow {
    display: block;
    width: 16px;
    height: 16px;
    stroke: currentColor;
    transition: transform 0.2s ease;
  }

  .pw-card:hover .pw-card__btn-arrow {
    transform: translateX(4px);
  }

  /* ---- Mobile / Tablet: Swipe Carousel ≤1023px ---- */
  @media (max-width: 1023px) {
    .pw {
      padding-inline: 20px;
      padding-top: var(--pw-padding-top, 60px);
      padding-bottom: var(--pw-padding-bottom, 100px);
    }

    .pw__heading {
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 24px;
    }

    .pw__cards {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
      padding-block-end: 16px;
      gap: 16px;
    }

    .pw__cards::-webkit-scrollbar {
      display: none;
    }

    .pw-card {
      flex: 0 0 100%;
      max-width: 100%;
      min-width: 0;
      scroll-snap-align: center;
      border-radius: 18px;
    }

    .pw__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
    }
    
    .pw__dot {
      width: 9px;
      height: 9px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.2);
      transition: background 0.25s ease;
      cursor: pointer;
    }
    
    .pw__dot.is-active {
      background: #171717;
    }

    .pw-card__media {
      height: 250px;
    }

    .pw-card__content {
      padding: 20px 18px 22px;
    }

    .pw-card__label {
      font-size: 1.15rem;
      margin-bottom: 16px;
    }

    .pw-card__features {
      gap: 11px;
      margin-bottom: 20px;
    }

    .pw-card__feature-item {
      font-size: 13px;
      gap: 10px;
    }

    .pw-card__button {
      height: 46px;
      font-size: 13.5px;
      border-radius: 10px;
    }
  }

  @media (max-width: 749px) {
    .pw {
      padding-inline: 18px;
      padding-top: var(--pw-padding-top-mobile, 18px);
      padding-bottom: var(--pw-padding-bottom-mobile, 40px);
    }

    .pw__heading {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .pw-card {
      flex: 0 0 100%;
      max-width: 100%;
      min-width: 0;
    }

    .pw-card__media {
      height: 230px;
    }

    .pw-card__content {
      padding: 18px 16px 20px;
    }

    .pw-card__label {
      font-size: 1.1rem;
      margin-bottom: 14px;
    }

    .pw-card__features {
         margin-left:20px;
      gap: 10px;
      margin-bottom: 18px;
    }

    .pw-card__feature-item {
      font-size: 12.5px;
      gap: 10px;
    }

    .pw-card__button {
      height: 44px;
      font-size: 13px;
    }
  }
{% endstylesheet %}
