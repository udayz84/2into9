{%- comment -%}
  Homepage hero — full-bleed dark slider with
  light editorial copy block and glass SHOP NOW button. Ref: Thanksweb hero.
{%- endcomment -%}

{%- assign product_blocks = section.blocks | where: 'type', 'product' -%}

<section
  class="hero2"
  id="Hero2-{{ section.id }}"
  style="--hero2-min-h: {% if section.settings.height == 'full' %}100svh{% else %}auto{% endif %}; --hero2-mobile-h: {{ section.settings.mobile_height | default: 80 }}svh; --hero2-eyebrow-size: {{ section.settings.eyebrow_size }}px; --hero2-heading-size: {{ section.settings.heading_size }}px; --hero2-products-bottom-pad: {% if product_blocks.size > 0 %}calc({{ product_blocks.size }} * 84px + 32px){% else %}clamp(75px, 12vh, 110px){% endif %};"
>
  <div class="hero2__slides" data-hero2-slides>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div class="hero2__slide{% if forloop.first %} is-active{% endif %}" data-slide {% if forloop.first %}data-hero2-root{% endif %}>
            {%- liquid
              assign desktop_src = ''
              if block.settings.image
                assign desktop_src = block.settings.image | image_url: width: 1920
              elsif section.settings.fallback_image_picker != blank
                assign desktop_src = section.settings.fallback_image_picker | image_url: width: 1920
              elsif section.settings.fallback_image != blank
                assign desktop_src = section.settings.fallback_image | asset_url
              else
                assign desktop_src = 'hero-home-1.jpg' | asset_url
              endif

              assign mobile_src = ''
              if block.settings.image_mobile
                assign mobile_src = block.settings.image_mobile | image_url: width: 1080
              elsif block.settings.mobile_image_asset != blank
                assign mobile_src = block.settings.mobile_image_asset | asset_url
              elsif section.settings.fallback_mobile_image_picker != blank
                assign mobile_src = section.settings.fallback_mobile_image_picker | image_url: width: 1080
              elsif section.settings.fallback_mobile_image != blank
                assign mobile_src = section.settings.fallback_mobile_image | asset_url
              elsif forloop.index == 2
                assign mobile_src = 'hero-mobile-2.jpg' | asset_url
              else
                assign mobile_src = 'hero-mobile-1.jpg' | asset_url
              endif
            -%}
            <picture class="hero2__picture">
              {%- if mobile_src != blank -%}
                <source media="(max-width: 749px)" srcset="{{ mobile_src }}">
              {%- endif -%}
              <source media="(min-width: 750px)" srcset="{{ desktop_src }}">
              <img
                class="hero2__image"
                src="{{ desktop_src }}"
                alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
                width="1920"
                height="1000"
              >
            </picture>
            <div class="hero2__content">
              {%- if block.settings.subheading != blank -%}
                <p class="hero2__eyebrow">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="hero2__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="hero2__button"
                  href="{{ block.settings.button_link | default: '/collections/all' }}"
                >
                  {{- block.settings.button_label -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Fallback single slide so the section renders before blocks are added {%- endcomment -%}
      <div class="hero2__slide is-active" data-slide>
        {%- liquid
          assign fallback_desktop = section.settings.fallback_image | default: 'hero-home-1.jpg' | asset_url
          assign fallback_mobile = section.settings.fallback_mobile_image | default: 'hero-mobile-1.jpg' | asset_url
        -%}
        <picture class="hero2__picture">
          <source media="(max-width: 749px)" srcset="{{ fallback_mobile }}">
          <source media="(min-width: 750px)" srcset="{{ fallback_desktop }}">
          <img
            class="hero2__image"
            src="{{ fallback_desktop }}"
            alt="Model wearing 2into9 boxer briefs"
            loading="eager"
            fetchpriority="high"
            width="1920"
            height="1000"
          >
        </picture>
        <div class="hero2__content">
          <p class="hero2__eyebrow">{{ section.settings.subheading }}</p>
          <h2 class="hero2__heading">{{ section.settings.heading }}</h2>
          <a class="hero2__button" href="{{ section.settings.button_link | default: '/collections/all' }}">
            {{- section.settings.button_label -}}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>

  <button
    type="button"
    class="hero2__arrow hero2__arrow--prev"
    data-hero2-prev
    aria-label="Previous slide"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <button
    type="button"
    class="hero2__arrow hero2__arrow--next"
    data-hero2-next
    aria-label="Next slide"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  {%- if product_blocks.size > 0 -%}
    <div class="hero2__products-wrapper">
      <div class="hero2__products">
        {%- for block in product_blocks -%}
          {%- assign prod = block.settings.product -%}
          {%- if prod != blank -%}
            <a href="{{ prod.url }}" class="hero2-product-card" {{ block.shopify_attributes }}>
              <div class="hero2-product-card__image-wrapper">
                <img
                  src="{{ prod.featured_image | image_url: width: 180 }}"
                  alt="{{ prod.title | escape }}"
                  class="hero2-product-card__image"
                  width="62"
                  height="62"
                  loading="lazy"
                >
              </div>
              <div class="hero2-product-card__info">
                {%- if block.settings.subtitle != blank -%}
                  <span class="hero2-product-card__subtitle">{{ block.settings.subtitle }}</span>
                {%- endif -%}
                <span class="hero2-product-card__title">{{ block.settings.title | default: prod.title }}</span>
              </div>
              <div class="hero2-product-card__arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          {%- else -%}
            <a href="#" class="hero2-product-card" {{ block.shopify_attributes }}>
              <div class="hero2-product-card__image-wrapper" style="background: rgba(255,255,255,0.08);"></div>
              <div class="hero2-product-card__info">
                <span class="hero2-product-card__subtitle">{{ block.settings.subtitle | default: 'SUBTITLE' }}</span>
                <span class="hero2-product-card__title">{{ block.settings.title | default: 'Example Product' }}</span>
              </div>
              <div class="hero2-product-card__arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="hero2__dots" data-hero2-dots></div>
</section>

{% stylesheet %}
  .hero2 {
    position: relative;
    isolation: isolate;
    min-height: var(--hero2-min-h, 100svh);
    background: #0c0f0c;
    overflow: clip;
  }

  .hero2__slides {
    position: relative;
    width: 100%;
    min-height: var(--hero2-min-h, 100svh);
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero2__slides::-webkit-scrollbar {
    display: none;
  }

  .hero2__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    min-height: var(--hero2-min-h, 100svh);
    position: relative;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Hero navigation arrows */
  .hero2__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(20, 20, 20, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    padding: 0;
  }

  .hero2__arrow:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-50%) scale(1.08);
  }

  .hero2__arrow:active {
    transform: translateY(-50%) scale(0.95);
  }

  .hero2__arrow--prev {
    left: clamp(16px, 3.5vw, 44px);
  }

  .hero2__arrow--next {
    right: clamp(16px, 3.5vw, 44px);
  }

  @media screen and (max-width: 749px) {
    .hero2__arrow {
      width: 38px;
      height: 38px;
    }
    .hero2__arrow--prev {
      left: 10px;
    }
    .hero2__arrow--next {
      right: 10px;
    }
  }

  .hero2__picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero2__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Copy block */
  .hero2__content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: var(--hero2-min-h, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    transform: translateY(4vh);
    padding-inline: clamp(1.25rem, 14vw, 22rem);
    padding-block: clamp(140px, 22vh, 220px) clamp(90px, 14vh, 150px);
  }

  .hero2__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading--family);
    font-size: var(--hero2-eyebrow-size, 26px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
  }

  .hero2__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--hero2-heading-size, 54px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.005em;
    color: #ffffff;
  }

  .hero2__button {
    display: inline-block;
    margin-top: clamp(1.25rem, 3vh, 1.75rem);
    padding: 13px 42px;
    border-radius: 4px;
    background: rgba(110, 110, 104, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }

  .hero2__button:hover {
    background: rgba(140, 140, 134, 0.6);
    color: #ffffff;
  }

  /* Carousel dots */
  .hero2__dots {
    position: absolute;
    z-index: 3;
    bottom: clamp(20px, 4vh, 36px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
  }

  .hero2__dots:empty {
    display: none;
  }

  .hero2__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .hero2__dot.is-active {
    background: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .hero2,
    .hero2__slides,
    .hero2__slide {
      min-height: var(--hero2-mobile-h, 80svh);
      height: var(--hero2-mobile-h, 80svh);
    }
    .hero2__watermark {
      font-size: clamp(64px, 19vw, 120px);
      top: clamp(56px, 8.5vh, 78px);
    }
  }

  /* Products */
  .hero2__products-wrapper {
    position: absolute;
    bottom: clamp(50px, 8vh, 80px);
    left: 0;
    width: 100%;
    z-index: 5;
    display: flex;
    justify-content: center;
    padding: 0 20px;
    pointer-events: none;
  }

  .hero2__products {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none; /* Firefox */
    pointer-events: auto;
  }

  .hero2__products::-webkit-scrollbar {
    display: none;
  }

  .hero2-product-card {
    display: flex;
    align-items: center;
    background: rgba(18, 24, 20, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 6px 14px 6px 6px;
    text-decoration: none;
    color: white;
    gap: 12px;
    min-width: 240px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .hero2-product-card:hover {
    background: rgba(35, 45, 38, 0.75);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }

  .hero2-product-card__image-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.08);
  }

  .hero2-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero2-product-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
  }

  .hero2-product-card__subtitle {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2px;
    font-weight: 700;
    font-family: var(--font-body--family);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero2-product-card__title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    color: white;
    font-family: var(--font-body--family);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero2-product-card__arrow {
    width: 36px;
    height: 36px;
    background: #ffffff;
    color: #000000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
  }

  .hero2-product-card__arrow svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .hero2__arrow {
      top: 42%;
      width: 36px;
      height: 36px;
    }

    .hero2__picture {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .hero2__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .hero2__eyebrow {
      font-size: min(var(--hero2-eyebrow-size, 26px), 4.8vw);
      margin: 0 0 0.25rem;
    }

    .hero2__heading {
      font-size: min(var(--hero2-heading-size, 54px), 8.2vw);
      line-height: 1.1;
    }

    .hero2__content {
      padding-inline: 1.25rem;
      justify-content: flex-end;
      padding-block: 0 var(--hero2-products-bottom-pad, clamp(75px, 12vh, 110px));
      transform: none;
      min-height: var(--hero2-mobile-h, 80svh);
      height: 100%;
    }

    .hero2__button {
      padding: 9px 30px;
      margin-top: 0.8rem;
      font-size: 0.76rem;
    }

    .hero2__dots {
      bottom: 8px;
      z-index: 6;
    }

    /* Stacked 1-by-1 product cards on mobile (Ref: Step One) */
    .hero2__products-wrapper {
      position: absolute;
      bottom: 22px;
      left: 0;
      right: 0;
      width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
      z-index: 5;
      pointer-events: none;
    }

    .hero2__products {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 480px;
      gap: 8px;
      overflow-x: visible;
      pointer-events: auto;
    }

    .hero2-product-card {
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      background: rgba(12, 22, 16, 0.78);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 15px;
      padding: 7px 14px 7px 7px;
      gap: 13px;
      text-decoration: none;
      color: white;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

    .hero2-product-card:active {
      transform: scale(0.985);
      background: rgba(26, 38, 28, 0.92);
      border-color: rgba(255, 255, 255, 0.4);
    }

    .hero2-product-card__image-wrapper {
      width: 58px;
      height: 58px;
      border-radius: 11px;
      overflow: hidden;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.08);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    .hero2-product-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero2-product-card__info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
      min-width: 0;
    }

    .hero2-product-card__subtitle {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.72);
      margin-bottom: 2px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hero2-product-card__title {
      font-size: 0.93rem;
      font-weight: 700;
      line-height: 1.25;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hero2-product-card__arrow {
      width: 38px;
      height: 38px;
      background: #ffffff;
      color: #000000;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-left: auto;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
    }

    .hero2-product-card__arrow svg {
      width: 17px;
      height: 17px;
    }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('.hero2').forEach(function (root) {
    var slidesWrap = root.querySelector('[data-hero2-slides]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero2__slide'));
    var prevBtn = root.querySelector('[data-hero2-prev]');
    var nextBtn = root.querySelector('[data-hero2-next]');
    var dotsWrap = root.querySelector('.hero2__dots');

    if (!slidesWrap || slides.length < 2) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      if (dotsWrap) dotsWrap.style.display = 'none';
      return;
    }

    var current = 0;

    // Build dots
    if (dotsWrap) {
      dotsWrap.innerHTML = '';
      slides.forEach(function (_, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'hero2__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', function () {
          goToSlide(i);
        });
        dotsWrap.appendChild(dot);
      });
    }

    function updateActiveState(index) {
      current = index;
      slides.forEach(function (s, i) {
        s.classList.toggle('is-active', i === current);
      });
      if (dotsWrap) {
        var dots = Array.prototype.slice.call(dotsWrap.children);
        dots.forEach(function (d, i) {
          d.classList.toggle('is-active', i === current);
        });
      }
    }

    function goToSlide(n) {
      current = (n + slides.length) % slides.length;
      var slideWidth = slidesWrap.clientWidth;
      slidesWrap.scrollTo({
        left: current * slideWidth,
        behavior: 'smooth'
      });
      updateActiveState(current);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function (e) {
        e.preventDefault();
        goToSlide(current - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function (e) {
        e.preventDefault();
        goToSlide(current + 1);
      });
    }

    // Sync active state when user scrolls or swipes
    var scrollTimer = null;
    slidesWrap.addEventListener('scroll', function () {
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function () {
        var slideWidth = slidesWrap.clientWidth;
        if (slideWidth > 0) {
          var newIndex = Math.round(slidesWrap.scrollLeft / slideWidth);
          if (newIndex >= 0 && newIndex < slides.length && newIndex !== current) {
            updateActiveState(newIndex);
          }
        }
      }, 50);
    }, { passive: true });

    // Keep slide aligned on resize
    window.addEventListener('resize', function () {
      var slideWidth = slidesWrap.clientWidth;
      slidesWrap.scrollLeft = current * slideWidth;
    }, { passive: true });
  });
</script>

{% schema %}
{
  "name": "Homepage Hero",
  "tag": "section",
  "class": "section-custom-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "fallback_image_picker",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "fallback_mobile_image_picker",
