{% liquid
  assign breadcrumb_collection = collection

  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections.first
  endif
%}

{% style %}
.ph-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 12px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.5;
  color: #777;
}

.ph-breadcrumb a {
  color: #555;
  text-decoration: none;
}

.ph-breadcrumb a:hover {
  color: #171717;
  text-decoration: underline;
}

.ph-breadcrumb__separator {
  color: #999;
}

.ph-breadcrumb [aria-current="page"] {
  color: #171717;
}

@media (max-width: 1023px) {
  .ph-breadcrumb {
    font-size: 11px;
    margin-bottom: 10px;
  }
}
{% endstyle %}

<nav class="ph-breadcrumb" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>

  <span class="ph-breadcrumb__separator">/</span>

  {% if breadcrumb_collection != blank %}
    <a href="{{ breadcrumb_collection.url }}">
      {{ breadcrumb_collection.title | escape }}
    </a>
    <span class="ph-breadcrumb__separator">/</span>
  {% endif %}

  <span aria-current="page">
    {{ product.title | escape }}
  </span>
</nav>