<section
  id="ContactContent-{{ section.id }}"
  class="contact-content color-{{ section.settings.color_scheme }} section"
>
  <div class="contact-content__container page-width">
    <!-- Get In Touch Section -->
    <div class="contact-content__info">
      {% if section.settings.heading != blank %}
        <h1 class="contact-content__main-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="contact-content__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="contact-content__details">
        {% if section.settings.email != blank %}
          <div class="contact-content__detail-item">
            <span class="contact-content__label">Email</span>
            <a href="mailto:{{ section.settings.email }}" class="contact-content__value">{{ section.settings.email }}</a>
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="contact-content__detail-item">
            <span class="contact-content__label">Phone</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="contact-content__value">{{ section.settings.phone }}</a>
          </div>
        {% endif %}

        {% if section.settings.help_link != blank %}
          <div class="contact-content__detail-item">
            <span class="contact-content__label">Help Centre</span>
            <a href="{{ section.settings.help_link }}" class="contact-content__value contact-content__link">Visit our Help Centre <span class="underline">here</span></a>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Contact Form Section -->
    <div class="contact-content__form-section">
      {% if section.settings.form_heading != blank %}
        <h2 class="contact-content__form-heading">{{ section.settings.form_heading }}</h2>
      {% endif %}

      {% assign form_id = section.id | prepend: 'ContactForm-' %}
      {%- form 'contact', id: form_id, class: 'contact-content__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-content__success">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Thank you for your message. We'll get back to you soon!</span>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="contact-content__error">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" x2="9" y1="9" y2="15"></line>
              <line x1="9" x2="15" y1="9" y2="15"></line>
            </svg>
            <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
          </div>
        {%- endif -%}

        <div class="contact-content__form-row">
          <div class="contact-content__field">
            <label for="ContactForm-name-{{ section.id }}" class="contact-content__field-label">NAME</label>
            <input
              type="text"
              id="ContactForm-name-{{ section.id }}"
              class="contact-content__input"
              autocomplete="name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-content__field">
            <label for="ContactForm-email-{{ section.id }}" class="contact-content__field-label">EMAIL</label>
            <input
              type="email"
              id="ContactForm-email-{{ section.id }}"
              class="contact-content__input"
              autocomplete="email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              required
            >
          </div>
        </div>

        <div class="contact-content__field">
          <label for="ContactForm-phone-{{ section.id }}" class="contact-content__field-label">PHONE NUMBER</label>
          <input
            type="tel"
            id="ContactForm-phone-{{ section.id }}"
            class="contact-content__input"
            autocomplete="tel"
            name="contact[phone]"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
        </div>

        <div class="contact-content__field">
          <label for="ContactForm-body-{{ section.id }}" class="contact-content__field-label">MESSAGE</label>
          <textarea
            rows="6"
            id="ContactForm-body-{{ section.id }}"
            class="contact-content__input contact-content__textarea"
            name="contact[body]"
          >{{ form.body }}</textarea>
        </div>

        <button type="submit" class="contact-content__submit">
          {{ section.settings.submit_label | default: 'SEND' }}
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% style %}
  #ContactContent-{{ section.id }} {
    padding-block: clamp(3rem, 6vw, 5rem);
    background-color: #f5f5f5;
  }

  .contact-content__container {
    max-width: 55rem;
    margin: 0 auto;
    text-align: center;
        width: 100%;
  }

  /* Get In Touch Section */
  .contact-content__info {
    margin-bottom: 3rem;
  }

  .contact-content__main-heading {
    font-size: clamp(1.5rem, 4vw, 2rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    font-weight: 600;
  }

  .contact-content__subheading {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
    opacity: 0.8;
  }

  .contact-content__details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-content__detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-content__label {
    font-size: 0.95rem;
    font-weight: 600;
    color: inherit;
  }

  .contact-content__value {
    font-size: 1rem;
    color: inherit;
    text-decoration: none;
    opacity: 0.85;
  }

  .contact-content__value:hover {
    opacity: 1;
  }

  .contact-content__link .underline {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Contact Form Section */
  .contact-content__form-section {
    margin-top: 3rem;
  }

  .contact-content__form-heading {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    font-weight: 600;
    font-family: var(--font-heading-family);
  }

  .contact-content__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
  }

  .contact-content__form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .contact-content__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-content__field-label {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.75);
    font-family: var(--font-body-family);
  }

  .contact-content__input {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: #fff;
    color: inherit;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .contact-content__input:focus {
    outline: none;
    border-color: #000;
  }

  .contact-content__textarea {
    resize: vertical;
    min-height: 120px;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.08); /* Match input border */
    background-color: #fff;
  }

  .contact-content__textarea:focus {
    border-color: #000;
  }

  .contact-content__submit {
    align-self: center;
    padding: 1rem 3.5rem;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: #000; /* Black theme color */
    color: #fff;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    margin-top: 1rem;
    font-weight: 600;
  }

  .contact-content__submit:hover {
    opacity: 0.8;
  }

  .contact-content__success,
  .contact-content__error {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    font-size: 0.95rem;
    border-radius: 4px;
  }

  .contact-content__success {
    background: color-mix(in srgb, #22c55e 15%, transparent);
    color: #166534;
  }

  .contact-content__error {
    background: color-mix(in srgb, #ef4444 15%, transparent);
    color: #c1121f;
  }

  /* Mobile Responsive */
  @media (max-width: 749px) {
    .contact-content__form-row {
      grid-template-columns: 1fr;
    }

    .contact-content__submit {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact Content",
  "tag": "section",
  "class": "section-contact-content",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Get In Touch Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We will reply to all enquiries within 2-24 hours."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "care@2into9.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help Centre link"
    },
    {
      "type": "header",
      "content": "Contact Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "SEND"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    }
  ],
  "presets": [
    {
      "name": "Contact Content"
    }
  ]
}
{% endschema %}
