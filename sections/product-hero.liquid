      order: 3;
      width: 100%;
    }

    .ph-desktop-title {
      display: none !important;
    }

    .ph-features {
      display: none !important;
    }

    /* Segmented Fit / Size Selector (Mobile) */
    .ph-sizes {
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(70px, 1fr)) !important;
      gap: 4px !important;
      background: #EEF0F2 !important;
      border-radius: 12px !important;
