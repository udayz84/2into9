{% comment %} {{ 'bamboo-page.css' | asset_url | stylesheet_tag }}
<section class="bb bb-hover-{{ section.settings.hover_style }} bb bb-benefits" style="--bb-bg:{{ section.settings.bg }};--bb-ink:{{ section.settings.ink }};--bb-max:{{ section.settings.width }}px;--bb-pt:{{ section.settings.padding_top }}px;--bb-pb:{{ section.settings.padding_bottom }}px"><div class="bb-wrap">
<div class="bb-intro"><div class="bb-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="bb-rich">{{ section.settings.intro }}</div></div>
<div class="bb-benefit-grid bb-cols-{{ section.settings.columns }}">{% for block in section.blocks %}<article class="bb-benefit" {{ block.shopify_attributes }}><div class="bb-symbol" aria-hidden="true">{{ block.settings.icon | escape }}</div><h3>{{ block.settings.title | escape }}</h3><div class="bb-rich">{{ block.settings.text }}</div></article>{% endfor %}</div>
</div></section>
{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content max width",
      "default": 1200,
      "min": 900,
      "max": 1500,
      "step": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 75,
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 75,
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY IT FEELS DIFFERENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Benefits of Bamboo Viscose"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Discover the everyday qualities that make bamboo-derived viscose interesting for underwear.</p>"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "hover_style",
      "label": "Hover animation",
      "default": "subtle",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "expressive",
          "label": "Expressive"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "◌"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Comfortable feel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Designed for comfort throughout the day.</p>"
        }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}


{{ 'bamboo-page.css' | asset_url | stylesheet_tag }}
<section class="bb bb-hover-{{ section.settings.hover_style }} bb-benefits" style="--bb-bg:{{ section.settings.bg }};--bb-ink:{{ section.settings.ink }};--bb-max:{{ section.settings.width }}px;--bb-pt:{{ section.settings.padding_top }}px;--bb-pb:{{ section.settings.padding_bottom }}px"><div class="bb-wrap">
<div class="bb-intro"><div class="bb-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="bb-rich">{{ section.settings.intro }}</div></div>
<div class="bb-benefit-grid bb-cols-{{ section.settings.columns }} bb-mobile-cols-{{ section.settings.mobile_columns }}">
{% for block in section.blocks %}
  <article class="bb-benefit" style="--bb-card-bg: {{ block.settings.card_background }}; --bb-card-ink: {{ block.settings.card_text }}; --bb-card-image-ink: {{ block.settings.image_text_color }}; --bb-card-shade: {{ block.settings.card_overlay | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
    {% if block.settings.card_image != blank %}
      <div class="bb-benefit-media" aria-hidden="true">
        {{ block.settings.card_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,560,750,1000', sizes: '(min-width: 1000px) 30vw, (min-width: 750px) 45vw, 100vw', alt: '' }}
      </div>
      <div class="bb-benefit-scrim" aria-hidden="true"></div>
    {% endif %}
    <div class="bb-benefit-content">
      {% if block.settings.icon != blank %}<div class="bb-symbol" aria-hidden="true">{{ block.settings.icon | escape }}</div>{% endif %}
      <h3>{{ block.settings.title | escape }}</h3>
      <div class="bb-rich">{{ block.settings.text }}</div>
    </div>
  </article>
{% endfor %}
</div>
</div></section>
