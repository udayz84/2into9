{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap' | stylesheet_tag }}

<section
  id="Faq-{{ section.id }}"
  class="faq color-{{ section.settings.color_scheme }} section"
>
  {%- if section.settings.watermark_text != blank -%}
    <div class="faq__watermark" aria-hidden="true">{{ section.settings.watermark_text }}</div>
  {%- endif -%}
  <div class="faq__container page-width">
    <div class="faq__body">
      {% render 'faq-content' %}
    </div>
  </div>
</section>

{% style %}
  #Faq-{{ section.id }} {
    padding-block: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .faq__watermark {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(120px, 31vw, 310px);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: #b5b5b5;
    opacity: 0.06;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .faq__container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 62.5rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq__body {
    width: 100%;
  }

  /* FAQ Content Styles */
  .faq-content {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .faq-category {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .faq-category__title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 300;
    color: #171717;
    text-align: center;
    margin: 0;
    padding: 0;
    border: none;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  /* FAQ Item Accordion */
  .faq-item {
    border-bottom: 1px solid #d9d9d9;
  }

  .faq-item__question {
    font-family: 'Poppins', sans-serif;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 1.25rem;
    font-weight: 600;
    color: #171717;
    transition: padding-bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item[open] .faq-item__question {
    padding-bottom: 0.625rem;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  /* Chevron Icon with Filled Circle */
  .faq-item__icon {
    order: 2;
    margin-left: auto;
    position: relative;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: #d9d9d9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq-item__icon::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 1.5px solid #171717;
    border-bottom: 1.5px solid #171717;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translateY(2px) rotate(225deg);
  }

  /* FAQ Answer */
  .faq-item__answer {
    font-family: 'Poppins', sans-serif;
    padding: 0 0 1.5rem 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: #171717;
    max-width: 53.5rem;
    overflow: hidden;
  }

  .faq-item__answer p {
    margin: 0 0 1rem;
  }

  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }

  .faq-item__answer ul {
    margin: 0.5rem 0 1rem;
    padding-left: 1.5rem;
  }

  .faq-item__answer ul li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .faq-item__answer ul li strong {
    font-weight: 600;
  }

  .faq-item__answer a {
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .faq-item__answer a:hover {
    opacity: 0.7;
  }

  /* Mobile Responsive */
  @media (max-width: 749px) {
    .faq-content {
      gap: 2.75rem;
    }

    .faq-category {
      gap: 1.75rem;
    }

    .faq-category__title {
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .faq-item__question {
      padding: 1.125rem 0;
      font-size: 0.95rem;
      line-height: 1.45;
      gap: 0.875rem;
    }

    .faq-item[open] .faq-item__question {
      padding-bottom: 0.625rem;
    }

    .faq-item__answer {
      font-size: 0.9rem;
      line-height: 1.65;
      padding-bottom: 1.25rem;
      max-width: 100%;
    }

    .faq-item__answer ul {
      padding-left: 1.25rem;
    }

    .faq-item__icon {
      width: 24px;
      height: 24px;
    }

    .faq-item__icon::after {
      width: 7px;
      height: 7px;
    }
  }
{% endstyle %}

<script>
  function initFaqAccordion(sectionId) {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const duration = () => (prefersReducedMotion.matches ? 0 : 350);
    const easing = 'cubic-bezier(0.4, 0, 0.2, 1)';

    section.querySelectorAll('.faq-item').forEach((item) => {
      const summary = item.querySelector('.faq-item__question');
      const answer = item.querySelector('.faq-item__answer');
      if (!summary || !answer) return;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        answer.getAnimations().forEach((animation) => animation.cancel());

        if (item.open) {
          const height = answer.offsetHeight;
          const animation = answer.animate(
            { height: [height + 'px', '0px'], opacity: [1, 0] },
            { duration: duration(), easing, fill: 'forwards' }
          );
          animation.onfinish = () => {
            item.open = false;
            animation.cancel();
          };
        } else {
          item.open = true;
          const height = answer.offsetHeight;
          answer.animate(
            { height: ['0px', height + 'px'], opacity: [0, 1] },
            { duration: duration(), easing }
          );
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => initFaqAccordion('Faq-{{ section.id }}'));
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail.sectionId === '{{ section.id }}') {
      initFaqAccordion('Faq-{{ section.id }}');
    }
  });
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark text",
      "default": "underwear",
      "info": "Large faded text behind the section top. Leave blank to hide."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
