<div class="pf" style="--pf-padding-inline: {{ section.settings.page_padding }}px;">
  <div class="pf__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pf__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <product-faq class="pf__list" data-single="true">
      {%- for block in section.blocks -%}
        <div
          class="pf-item{% if forloop.first and section.settings.open_first %} is-open{% endif %}"
          data-accordion-item
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="pf-item__trigger"
            data-accordion-trigger
            aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}"
          >
            <span class="pf-item__question">{{ block.settings.question }}</span>
            <span class="pf-item__icon" aria-hidden="true">
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1l4 4 4-4"/>
              </svg>
            </span>
          </button>
          <div class="pf-item__answer" data-accordion-content{% unless forloop.first and section.settings.open_first %} hidden{% endunless %}>
            <div class="pf-item__answer-body">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </product-faq>
  </div>
</div>

<script src="{{ 'product-faq.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "class": "section-pf",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ's"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 20,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's the difference between a Boxer Brief and Trunk?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>The only difference between the two is that Boxer Briefs have 3 cm more leg length than the trunks.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        { "type": "question" },
        {
          "type": "question",
          "settings": {
            "question": "What type of underwear is best for me?",
            "answer": "<p>If you prefer more coverage and support, go for Boxer Briefs. For a shorter, cooler fit, Trunks are your best pick.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What underpants should I choose if I play sport?",
            "answer": "<p>Our Anti-Sweat Trunks with moisture-wicking fabric and anti-chafe panels are built specifically for active use.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .pf,
  .pf h1,
  .pf h2,
  .pf h3,
  .pf h4,
  .pf p,
  .pf span,
  .pf button,
  .pf input,
  .pf a {
    font-family: var(--pf-font);
  }

  .pf {
    --pf-ink: #111111;
    --pf-font: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    font-family: var(--pf-font);
    color: var(--pf-ink);
    padding-inline: var(--pf-padding-inline, 40px);
    padding-block: 40px 100px;
  }

  .pf__inner {
    max-width: 960px;
    margin-inline: auto;
    width: 100%;
  }

  .pf__heading {
    margin: 0 0 clamp(24px, 3vw, 36px);
    font-family: var(--pf-font);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--pf-ink);
  }

  .pf__list {
    display: block;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    background-color: #f6f6f6;
    border-radius: 20px;
    padding: 8px 36px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pf-item {
    border-block-end: 1px solid #e5e5e5;
  }

  .pf-item:last-child {
    border-block-end: none;
  }

  .pf-item__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding-block: 20px;
    padding-inline: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--pf-font);
    text-align: left;
    user-select: none;
  }

  .pf-item__question {
    font-size: clamp(14.5px, 1.15vw, 16px);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--pf-ink);
    flex: 1;
  }

  .pf-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: #e5e5e5;
    color: var(--pf-ink);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s ease;
  }

  .pf-item__icon svg {
    width: 10px;
    height: 6px;
    transition: transform 0.3s ease;
  }

  .pf-item.is-open .pf-item__icon {
    transform: rotate(180deg);
    background-color: #dedede;
  }

  .pf-item__answer-body {
    padding-block: 0 20px;
    font-size: clamp(14px, 1.05vw, 15px);
    font-weight: 400;
    line-height: 1.65;
    color: #3f3f46;
  }

  .pf-item__answer-body p {
    margin: 0;
  }

  .pf-item__answer-body p + p {
    margin-top: 10px;
  }

  /* ---- Mobile: structure ≤1023px, sizing ≤749px. ---- */
  @media (max-width: 1023px) {
    .pf {
      padding-inline: 20px;
      padding-block: 32px 64px;
    }
  }

  @media (max-width: 749px) {
    .pf {
      padding-inline: 16px;
      padding-block: 28px 48px;
    }

    .pf__heading {
      margin-block-end: 20px;
      font-size: 26px;
      line-height: 1.2;
    }

    .pf__list {
      border-radius: 16px;
      padding: 4px 18px;
    }

    .pf-item__trigger {
      gap: 14px;
      padding-block: 16px;
    }

    .pf-item__question {
      font-size: 14.5px;
    }

    .pf-item__icon {
      width: 26px;
      height: 26px;
    }

    .pf-item__answer-body {
      padding-block: 0 16px;
      font-size: 13.5px;
      line-height: 1.55;
    }
  }
{% endstylesheet %}
