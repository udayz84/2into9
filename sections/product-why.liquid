{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

<div
  class="pw"
  style="
    --pw-padding-inline: {{ section.settings.page_padding }}px;
    --pw-padding-top: {{ section.settings.padding_top }}px;
    --pw-padding-bottom: {{ section.settings.padding_bottom }}px;
    --pw-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --pw-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="pw__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pw__cards" data-pw-cards>
    {%- for block in section.blocks -%}
      <a
        class="pw-card"
        {% if block.settings.link != blank %}
          href="{{ block.settings.link }}"
        {% else %}
          href="{{ routes.all_products_collection_url }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="pw-card__media">
          {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
            <picture class="pw-card__picture">
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 600 }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 740
                  | image_tag:
                    class: 'pw-card__image',
                    widths: '370, 555, 740',
                    sizes: '370px',
                    loading: 'lazy',
                    alt: block.settings.label
                }}
              {%- else -%}
                {{
                  block.settings.image_mobile
                  | image_url: width: 740
                  | image_tag:
                    class: 'pw-card__image',
                    widths: '370, 555, 740',
                    sizes: '370px',
                    loading: 'lazy',
                    alt: block.settings.label
                }}
              {%- endif -%}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pw-card__image pw-card__image--placeholder' }}
          {%- endif -%}
        </div>

        <div class="pw-card__content">
          {%- if block.settings.label != blank -%}
            <span class="pw-card__label">{{ block.settings.label }}</span>
          {%- endif -%}

          {% liquid
            assign f1 = block.settings.feature_1 | default: section.settings.chip_1
            assign f2 = block.settings.feature_2 | default: section.settings.chip_2
            assign f3 = block.settings.feature_3 | default: section.settings.chip_3
            assign f4 = block.settings.feature_4 | default: section.settings.chip_4
            assign f5 = block.settings.feature_5 | default: section.settings.chip_5
          %}

          <div class="pw-card__features">
            {%- if f1 != blank -%}
              <div class="pw-card__feature-item">
                <span class="pw-card__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                    <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ f1 }}</span>
              </div>
            {%- endif -%}
            {%- if f2 != blank -%}
              <div class="pw-card__feature-item">
                <span class="pw-card__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                    <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ f2 }}</span>
              </div>
            {%- endif -%}
            {%- if f3 != blank -%}
              <div class="pw-card__feature-item">
                <span class="pw-card__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                    <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ f3 }}</span>
              </div>
            {%- endif -%}
            {%- if f4 != blank -%}
              <div class="pw-card__feature-item">
                <span class="pw-card__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                    <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ f4 }}</span>
              </div>
            {%- endif -%}
            {%- if f5 != blank -%}
              <div class="pw-card__feature-item">
                <span class="pw-card__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" fill="#171717" stroke="#171717" stroke-width="1"/>
                    <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ f5 }}</span>
              </div>
            {%- endif -%}
          </div>

          {% liquid
            if block.settings.button_label != blank and block.settings.button_label != 'Shop Now'
              assign btn_text = block.settings.button_label
            elsif block.settings.label != blank
              assign btn_text = 'Shop ' | append: block.settings.label
            else
              assign btn_text = 'Shop Now'
            endif
          %}
          <span class="pw-card__button">
            <span>{{ btn_text }}</span>
            <svg class="pw-card__btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
  <div class="pw__dots" data-pw-dots></div>
</div>

<script>
  document.querySelectorAll('.pw').forEach(function(root) {
    var cardsWrap = root.querySelector('[data-pw-cards]');
    var cards = Array.prototype.slice.call(cardsWrap.querySelectorAll('.pw-card'));
    var dotsWrap = root.querySelector('[data-pw-dots]');

    if (!cardsWrap || cards.length < 2) {
      if (dotsWrap) dotsWrap.style.display = 'none';
      return;
    }

    var current = 0;

    function isMobile() {
      return window.innerWidth <= 1023;
    }

    function initDots() {
      if (!isMobile()) {
        dotsWrap.style.display = 'none';
        return;
      }
      dotsWrap.style.display = 'flex';
      dotsWrap.innerHTML = '';
      cards.forEach(function(_, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'pw__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to card ' + (i + 1));
        dot.addEventListener('click', function() {
          var scrollPos = cards[i].offsetLeft - cardsWrap.offsetLeft;
          cardsWrap.scrollTo({
            left: scrollPos,
            behavior: 'smooth'
          });
        });
        dotsWrap.appendChild(dot);
      });
    }

    initDots();
    window.addEventListener('resize', initDots);

    function updateActiveState(index) {
      current = index;
      var dots = Array.prototype.slice.call(dotsWrap.children);
      dots.forEach(function(d, i) {
        d.classList.toggle('is-active', i === current);
      });
    }

    var scrollTimer = null;
    cardsWrap.addEventListener('scroll', function() {
      if (!isMobile() || dotsWrap.children.length === 0) return;
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function() {
        var scrollLeft = cardsWrap.scrollLeft;
        var cardWidth = cards[0].offsetWidth;
        var gap = 16;
        var newIndex = Math.round(scrollLeft / (cardWidth + gap));
        if (newIndex >= 0 && newIndex < cards.length && newIndex !== current) {
          updateActiveState(newIndex);
        }
      }, 50);
    }, { passive: true });
  });
</script>

{% schema %}
{
  "name": "Product Why",
  "tag": "section",
  "class": "section-pw",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why 2into9 Underwear?"
    },
    {
      "type": "range",
      "id": "page_padding",
      "label": "Side padding",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Feature list (defaults)"
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Feature 1",
      "default": "Moisture-wicking"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Feature 2",
      "default": "Anti-chafe Panels"
    },
    {
      "type": "text",
      "id": "chip_3",
      "label": "Feature 3",
      "default": "Soft Bamboo Viscose"
    },
    {
      "type": "text",
      "id": "chip_4",
      "label": "Feature 4",
      "default": "3D Pouch Comfort"
    },
    {
      "type": "text",
      "id": "chip_5",
      "label": "Feature 5",
      "default": "Organic + Sustainable"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Card label",
          "default": "Mens"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "header",
          "content": "Custom Features (Optional)"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        },
        {
          "type": "text",
          "id": "feature_5",
          "label": "Feature 5"
        }
      ]
    }
